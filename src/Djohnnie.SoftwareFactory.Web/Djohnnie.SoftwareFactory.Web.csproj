<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>93937f24-af83-46d0-a0f1-d44d0b946152</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="11.0.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <!-- Only for the official Toast UI Editor script and stylesheet it ships; MarkdownEditor.razor.js imports them by path, so keep the exact version. -->
    <PackageReference Include="ToastUIEditor" Version="[1.1.1]" />
  </ItemGroup>

  <ItemGroup>
    <!-- ContentRoot makes the dev-time static asset manifest resolve the linked file from docs\ instead of wwwroot\. -->
    <Content Include="..\..\docs\logo.svg" Link="wwwroot\logo.svg" ContentRoot="$(MSBuildProjectDirectory)\..\..\docs\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Djohnnie.SoftwareFactory.Application\Djohnnie.SoftwareFactory.Application.csproj" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1development_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
