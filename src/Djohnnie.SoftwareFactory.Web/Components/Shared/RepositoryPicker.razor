@inject GitHubService GitHub
@inject RepositoryService Repositories
@inject ISnackbar Snackbar
@using Djohnnie.SoftwareFactory.Application.Features.Repositories
@using Djohnnie.SoftwareFactory.Contracts.Repositories
@implements IDisposable

@if (_knownError is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning">Could not load favorite and recently accessed repositories: @_knownError</MudAlert>
}
@if (_favoriteRepositories.Count > 0)
{
    <MudStack Class="pa-4" Spacing="2">
        <MudText Typo="Typo.h6">Favorites</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var repository in _favoriteRepositories)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Star"
                           Disabled="_selecting" OnClick="() => SelectKnownAsync(repository)">
                    @repository.FullName
                </MudButton>
            }
        </MudStack>
    </MudStack>
}
@if (_recentRepositories.Count > 0)
{
    <MudStack Class="pa-4" Spacing="2">
        <MudText Typo="Typo.h6">Recently accessed</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var repository in _recentRepositories)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.History"
                           Disabled="_selecting" OnClick="() => SelectKnownAsync(repository)"
                           title="@($"Last accessed {repository.LastAccessedAt?.ToLocalTime():yyyy-MM-dd HH:mm}")">
                    @repository.FullName
                </MudButton>
            }
        </MudStack>
    </MudStack>
}
@if (_selectionError is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error">Could not select repository: @_selectionError</MudAlert>
}
@if (_selecting)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Opening repository" />
}

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error">Could not load repositories: @_error</MudAlert>
}
else if (_repositories is null)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6" role="status" aria-live="polite">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" aria-label="Loading repositories" />
        <MudText>Loading repositories from GitHub...</MudText>
    </MudStack>
}
else
{
    <MudTable Outlined="true" Striped="true" T="GitHubRepository" Items="_repositories"
              Filter="Matches" Hover="true" Dense="true" Elevation="0" RowsPerPage="10"
              OnRowClick="@(args => SelectAsync(args.Item!))" RowClass="cursor-pointer"
              RowClassFunc="@((repo, _) => repo.FullName == SelectedFullName ? "mud-theme-primary-text selected-row" : string.Empty)">
        <ToolBarContent>
            <MudTextField Variant="Variant.Text" Underline="false" @bind-Value="_search" Placeholder="Search repositories" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Immediate="true"
                          Clearable="true" AutoFocus="true" Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width:1%"><span class="visually-hidden">Favorite</span></MudTh>
            <MudTh>Repository</MudTh>
            <MudTh>Language</MudTh>
            <MudTh>Visibility</MudTh>
            <MudTh>Last push</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Favorite">
                <FavoriteToggle Value="IsFavorite(context)" ValueChanged="v => SetFavoriteAsync(context.FullName, v)"
                                Name="@context.FullName" Size="Size.Small" />
            </MudTd>
            <MudTd DataLabel="Repository">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Size="Size.Small"><MudImage Src="@context.Owner.AvatarUrl" Alt="" /></MudAvatar>
                    <div>
                        <MudText Typo="Typo.body1"><b>@context.FullName</b></MudText>
                        @if (!string.IsNullOrEmpty(context.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                        }
                    </div>
                    @if (context.Fork) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">fork</MudChip> }
                    @if (context.Archived) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">archived</MudChip> }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Language">@context.Language</MudTd>
            <MudTd DataLabel="Visibility">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Icon="@(context.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)">
                    @(context.Private ? "private" : "public")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Last push">@context.PushedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No repositories match your search.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="[10, 25, 50]" />
        </PagerContent>
    </MudTable>
}

@if (Archived.Count > 0)
{
    @* Shown apart from GitHub's list (and also when that couldn't be loaded): these can only be opened to view what DGHSF stored. *@
    <MudStack Class="pa-4" Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Removed from GitHub</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            The sync found that these repositories no longer exist on GitHub. You can still open them to view everything DGHSF stored,
            like their work items, mindmaps, chats and knowledge base; everything that needs GitHub is disabled.
        </MudText>
        <MudTable Outlined="true" Striped="true" T="RepositorySummary" Items="Archived" Filter="MatchesArchived" Hover="true" Dense="true"
                  Elevation="0" RowsPerPage="10" OnRowClick="@(args => SelectArchivedAsync(args.Item!))" RowClass="cursor-pointer"
                  RowClassFunc="@((repo, _) => string.Equals(repo.FullName, SelectedFullName, StringComparison.OrdinalIgnoreCase) ? "mud-theme-primary-text selected-row" : string.Empty)"
                  aria-label="Repositories removed from GitHub">
            <HeaderContent>
                <MudTh>Repository</MudTh>
                <MudTh>Removed from GitHub</MudTh>
                <MudTh>Last accessed</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Repository">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.body1"><b>@context.FullName</b></MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">removed from GitHub</MudChip>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Removed from GitHub">@context.ArchivedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="Last accessed">@context.LastAccessedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No removed repositories match your search.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="[10, 25, 50]" />
            </PagerContent>
        </MudTable>
    </MudStack>
}

@code {
    /// <summary>Raised when the user clicks a repository.</summary>
    [Parameter] public EventCallback<GitHubRepository> OnSelected { get; set; }

    /// <summary>Raised when the user clicks a repository that was removed from GitHub.</summary>
    [Parameter] public EventCallback<RepositorySummary> OnArchivedSelected { get; set; }

    /// <summary>Highlights the currently selected repository.</summary>
    [Parameter] public string? SelectedFullName { get; set; }

    private IReadOnlyList<GitHubRepository>? _repositories;
    private IReadOnlyList<RepositorySummary> _recentRepositories = [];
    private IReadOnlyList<RepositorySummary> _favoriteRepositories = [];
    private IReadOnlyList<RepositorySummary> _archivedRepositories = [];
    private readonly CancellationTokenSource _cancellation = new();
    private string? _knownError;
    private string? _selectionError;
    private bool _selecting;
    private string? _error;
    private string? _search;

    protected override Task OnInitializedAsync()
    {
        return Task.WhenAll(LoadKnownAsync(), LoadRepositoriesAsync());
    }

    /// <summary>
    /// The repositories removed from GitHub, without any that GitHub lists again (e.g. once the sync token can see it again):
    /// those are in GitHub's list, and selecting one there restores it.
    /// </summary>
    private IReadOnlyList<RepositorySummary> Archived { get; set; } = [];

    private void UpdateArchived()
    {
        Archived = _repositories is null
            ? _archivedRepositories
            : _archivedRepositories.Where(archived => !_repositories.Any(repository =>
                string.Equals(repository.FullName, archived.FullName, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    /// <summary>
    /// Loads the favorite and the recently accessed repositories (the latter excludes favorites), and the ones removed from
    /// GitHub (which are neither).
    /// </summary>
    private async Task LoadKnownAsync()
    {
        try
        {
            _favoriteRepositories = await Repositories.GetFavoritesAsync(_cancellation.Token);
            _recentRepositories = await Repositories.GetRecentAsync(_cancellation.Token);
            _archivedRepositories = await Repositories.GetArchivedAsync(_cancellation.Token);
            UpdateArchived();
            _knownError = null;
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _knownError = ex.Message;
        }
        if (!_cancellation.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        try
        {
            _repositories = await GitHub.GetRepositoriesAsync(_cancellation.Token);
            UpdateArchived();
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is HttpRequestException or GitHubApiException)
        {
            _error = ex.Message;
        }
        if (!_cancellation.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SelectKnownAsync(RepositorySummary known)
    {
        return SelectAsync(async () => _repositories?.FirstOrDefault(repository =>
                string.Equals(repository.FullName, known.FullName, StringComparison.OrdinalIgnoreCase))
                ?? await GitHub.GetRepositoryAsync(known.FullName, _cancellation.Token));
    }

    private bool IsFavorite(GitHubRepository repository)
    {
        return _favoriteRepositories.Any(favorite => string.Equals(favorite.FullName, repository.FullName, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SetFavoriteAsync(string fullName, bool isFavorite)
    {
        try
        {
            await Repositories.SetFavoriteAsync(fullName, isFavorite, _cancellation.Token);
            await LoadKnownAsync();
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not update favorite '{fullName}': {ex.Message}", Severity.Error);
        }
    }

    private Task SelectAsync(GitHubRepository repository)
    {
        return SelectAsync(() => Task.FromResult(repository));
    }

    private Task SelectAsync(Func<Task<GitHubRepository>> loadRepository)
    {
        return RunSelectionAsync(async () => await OnSelected.InvokeAsync(await loadRepository()));
    }

    private Task SelectArchivedAsync(RepositorySummary repository)
    {
        return RunSelectionAsync(() => OnArchivedSelected.InvokeAsync(repository));
    }

    private async Task RunSelectionAsync(Func<Task> select)
    {
        if (_selecting)
        {
            return;
        }
        _selecting = true;
        _selectionError = null;
        try
        {
            await select();
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _selectionError = ex.Message;
        }
        finally
        {
            _selecting = false;
        }
    }

    private bool Matches(GitHubRepository repo)
    {
        return string.IsNullOrWhiteSpace(_search)
        || repo.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || (repo.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (repo.Language?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesArchived(RepositorySummary repository)
    {
        return string.IsNullOrWhiteSpace(_search) || repository.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}