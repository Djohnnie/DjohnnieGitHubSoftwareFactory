@using System.Globalization
@inject GitHubService GitHub
@inject WorkItemService WorkItems

<div class="infographic mb-6">
    <div class="infographic-stats">
        <MudPaper Outlined="true" Elevation="0" Class="infographic-stat">
            <MudIcon Icon="@Icons.Material.Filled.IntegrationInstructions" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Copilot instructions</MudText>
                @if (_loading)
                {
                    <MudSkeleton Width="6rem" Height="2rem" />
                }
                else if (_hasInstructions is { } hasInstructions)
                {
                    <div class="infographic-status">
                        <MudIcon Icon="@(hasInstructions ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)"
                                 Color="@(hasInstructions ? Color.Success : Color.Warning)" Size="Size.Small" />
                        <MudText Typo="Typo.h6">@(hasInstructions ? "Available" : "Not available")</MudText>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body1">Could not check</MudText>
                }
            </div>
        </MudPaper>

        <MudPaper Outlined="true" Elevation="0" Class="infographic-stat">
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" />
            @* Two counts side by side, split by a thin line; each part has the same label and number rows as the other boxes, so the box keeps its size. *@
            <div class="infographic-split">
                <div class="infographic-part">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Custom agents</MudText>
                    @Count(_agentCount)
                </div>
                <div class="infographic-part">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Skills</MudText>
                    @Count(_skillCount)
                </div>
            </div>
        </MudPaper>
    </div>

    <MudPaper Outlined="true" Elevation="0" Class="infographic-work-items">
        @if (_loading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="11rem" />
        }
        else if (_counts is null)
        {
            <MudText Typo="Typo.body1">Could not load the work items: @_countsError</MudText>
        }
        else
        {
            <table class="infographic-table">
                <thead>
                    <tr>
                        <th scope="col">Work items</th>
                        <th scope="col" class="infographic-bar-column" aria-label="Chart"></th>
                        <th scope="col" class="infographic-number"><span class="infographic-swatch infographic-existing"></span>Draft</th>
                        <th scope="col" class="infographic-number"><span class="infographic-swatch infographic-accepted"></span>Accepted</th>
                        <th scope="col" class="infographic-number"><span class="infographic-swatch infographic-finished"></span>Closed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _counts)
                    {
                        <tr>
                            <th scope="row">
                                <span class="infographic-type">
                                    <MudIcon Icon="@WorkItemRoutes.Icon(row.Type)" Color="Color.Secondary" Size="Size.Small" />
                                    @row.Type.PluralName
                                </span>
                            </th>
                            <td class="infographic-bar-column">
                                @if (row.Total > 0)
                                {
                                    @* Every track is full width and split by the items of its own type; the numbers next to it are the accessible version. *@
                                    <div class="infographic-track infographic-existing"
                                         title="@($"{row.Draft} draft, {row.Accepted} accepted, {row.Closed} closed")" aria-hidden="true">
                                        @* The fills overlap from the left, so the accepted fill reaches past the closed one by the number of accepted items. *@
                                        @if (row.Accepted > 0)
                                        {
                                            <div class="infographic-fill infographic-accepted" style="width: @Percentage(row.Accepted + row.Closed, row.Total)"></div>
                                        }
                                        @if (row.Closed > 0)
                                        {
                                            <div class="infographic-fill infographic-finished" style="width: @Percentage(row.Closed, row.Total)"></div>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="infographic-number">@row.Draft</td>
                            <td class="infographic-number">@row.Accepted</td>
                            <td class="infographic-number">@row.Closed</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    private bool _loading = true;
    private bool? _hasInstructions;
    private int? _agentCount;
    private int? _skillCount;
    private IReadOnlyList<WorkItemCounts>? _counts;
    private string? _countsError;

    protected override async Task OnInitializedAsync()
    {
        // Each part fails on its own: GitHub being unreachable doesn't hide the counts from the database.
        await Task.WhenAll(LoadInstructionsAsync(), LoadAgentCountAsync(), LoadSkillCountAsync(), LoadCountsAsync());
        _loading = false;
    }

    private RenderFragment Count(int? count)
    {
        if (_loading)
        {
            return @<MudSkeleton Width="3rem" Height="2rem" />;
        }

        return count is { } value
            ? @<MudText Typo="Typo.h6">@value</MudText>
            : @<MudText Typo="Typo.body1">Could not check</MudText>;
    }

    // Like the agents, the skills are counted from the directory listing alone: every directory in .github/skills is a skill.
    private async Task LoadSkillCountAsync()
    {
        try
        {
            var items = await GitHub.GetDirectoryAsync(RepositoryFullName, Skill.Directory);
            _skillCount = items.Count(item => item.Type == "dir");
        }
        catch (Exception ex) when (ex is HttpRequestException or GitHubApiException)
        {
            _skillCount = null;
        }
    }

    private async Task LoadInstructionsAsync()
    {
        try
        {
            _hasInstructions = await GitHub.GetFileAsync(RepositoryFullName, CopilotInstructionsFile.Path) is not null;
        }
        catch (Exception ex) when (ex is HttpRequestException or GitHubApiException)
        {
            _hasInstructions = null;
        }
    }

    private async Task LoadAgentCountAsync()
    {
        try
        {
            var items = await GitHub.GetDirectoryAsync(RepositoryFullName, AgentDefinition.Directory);
            _agentCount = items.Count(AgentCatalog.IsAgentFile);
        }
        catch (Exception ex) when (ex is HttpRequestException or GitHubApiException)
        {
            _agentCount = null;
        }
    }

    private async Task LoadCountsAsync()
    {
        try
        {
            _counts = await WorkItems.GetCountsAsync(RepositoryFullName);
        }
        catch (Exception ex)
        {
            _countsError = ex.Message;
        }
    }

    private static string Percentage(int part, int whole)
    {
        return (100d * part / whole).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }
}
