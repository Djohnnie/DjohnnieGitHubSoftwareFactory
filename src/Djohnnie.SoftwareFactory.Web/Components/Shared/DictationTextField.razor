@using Djohnnie.SoftwareFactory.Application.Features.Speech
@implements IAsyncDisposable
@inject SpeechService Speech
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<DictationTextField> Logger

@*
    A text field with a microphone adornment (SpeechDictation.cs, with Azure AI Speech in the browser).
    A single-line field listens until the speaker pauses and replaces the value with what was said (as a title).
    A multi-line field (Lines > 1) listens until the microphone is clicked again and adds what was said at the end.
    Without Azure AI Speech, read-only or disabled, it is a plain text field.
*@
<MudTextField T="string" Variant="Variant.Outlined" Value="Value" ValueChanged="ValueChanged" Label="@Label" Placeholder="@Placeholder"
              HelperText="@CurrentHelperText" Required="Required" RequiredError="@RequiredError" MaxLength="MaxLength" ReadOnly="ReadOnly"
              Disabled="Disabled" Lines="Lines" MaxLines="MaxLines" Sizing="@(Lines > 1 ? InputSizing.Auto : InputSizing.Fixed)"
              Immediate="Immediate" DebounceInterval="DebounceInterval" OnDebounceIntervalElapsed="OnDebounceIntervalElapsed"
              OnBlur="OnBlur" Class="@CssClass"
              Adornment="@(CanDictate ? Adornment.End : Adornment.None)"
              AdornmentIcon="@(Listening ? Icons.Material.Filled.Mic : Icons.Material.Outlined.Mic)"
              AdornmentColor="@(Listening ? Color.Error : Color.Default)"
              AdornmentAriaLabel="@(Listening ? StopLabel : $"Dictate the {SpokenLabel}")"
              OnAdornmentClick="ToggleAsync" />

@code {
    private SpeechDictation? _dictation;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string RequiredError { get; set; } = "Required";
    [Parameter] public int MaxLength { get; set; } = 524288;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Immediate { get; set; }
    [Parameter] public int DebounceInterval { get; set; }
    [Parameter] public EventCallback<string> OnDebounceIntervalElapsed { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    /// <summary>More than one line: dictation listens until the microphone is clicked again and adds to the text.</summary>
    [Parameter] public int Lines { get; set; } = 1;
    [Parameter] public int MaxLines { get; set; }

    /// <summary>What is dictated, for the adornment's accessible name, e.g. "title". Defaults to the label in lowercase.</summary>
    [Parameter] public string? DictationLabel { get; set; }

    /// <summary>Raised with the new value after dictation changed it.</summary>
    [Parameter] public EventCallback<string> OnDictated { get; set; }

    private bool Continuous
    {
        get
        {
            return Lines > 1;
        }
    }

    private bool Listening
    {
        get
        {
            return _dictation?.IsListening == true;
        }
    }

    private bool CanDictate
    {
        get
        {
            return Speech.IsEnabled && !ReadOnly && !Disabled;
        }
    }

    private string SpokenLabel
    {
        get
        {
            return DictationLabel ?? Label?.ToLowerInvariant() ?? "text";
        }
    }

    private string StopLabel
    {
        get
        {
            return Continuous ? "Stop dictating and add what was said" : "Stop dictating";
        }
    }

    private string? CssClass
    {
        get
        {
            return Listening ? $"{Class} dictation-listening".Trim() : Class;
        }
    }

    private string? CurrentHelperText
    {
        get
        {
            if (!Listening || !Continuous)
            {
                return HelperText;
            }

            var transcript = _dictation!.Transcript;
            return transcript.Length == 0
                ? "Listening... click the microphone when you are done."
                : $"Listening: \"{transcript}\"";
        }
    }

    /// <summary>Turns recognized speech into a title: Azure punctuates sentences, but a title has no closing period.</summary>
    public static string ToTitle(string? text, int? maxLength = null)
    {
        var title = (text ?? string.Empty).Trim().TrimEnd('.').TrimEnd();
        if (maxLength is { } max && title.Length > max)
        {
            title = title[..max].TrimEnd();
        }

        return title;
    }

    private async Task ToggleAsync()
    {
        if (_dictation is { IsListening: true })
        {
            if (Continuous)
            {
                await _dictation.StopAsync();
            }
            else
            {
                await _dictation.CancelAsync();
            }

            return;
        }

        if (_dictation is null)
        {
            _dictation = new SpeechDictation(Speech, JS, Snackbar, Logger);
            _dictation.TranscriptChanged += OnTranscriptChanged;
        }

        var listening = Continuous ? _dictation.ListenContinuouslyAsync() : _dictation.ListenOnceAsync();
        StateHasChanged();
        var spoken = await listening;
        var value = spoken is null ? null : Continuous ? SpeechDictation.Append(Value, spoken, MaxLength) : ToTitle(spoken, MaxLength);
        if (string.IsNullOrEmpty(value))
        {
            if (spoken is not null)
            {
                Snackbar.Add("No speech was recognized. Check your microphone and try again.", Severity.Warning);
            }

            return;
        }

        Value = value;
        await ValueChanged.InvokeAsync(value);
        await OnDictated.InvokeAsync(value);
    }

    private void OnTranscriptChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_dictation is not null)
        {
            _dictation.TranscriptChanged -= OnTranscriptChanged;
            await _dictation.DisposeAsync();
        }
    }

    /// <summary>What <c>recognizeOnce</c> and <c>recognizeContinuous</c> in wwwroot/js/dictation.js resolve with.</summary>
    public sealed record DictationResult(string Status, string? Text = null, string? Error = null);
}
