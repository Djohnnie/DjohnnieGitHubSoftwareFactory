@using System.Reflection
@using Djohnnie.SoftwareFactory.Application.Features.Uploads
@using ToastUI
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ImageUploadService ImageUploads
@inject ISnackbar Snackbar
@inject ILogger<MarkdownEditor> Logger

@*
    WYSIWYG Markdown editor (Toast UI Editor), with a switch to raw Markdown at the bottom.
    The Toast UI wrapper's own Value is HTML while in WYSIWYG mode, so this component always
    reads the Markdown back from the editor and only exposes Markdown through Value.
    Pasted, dropped or picked images are uploaded to the image storage (when AllowImages is set and
    storage is configured) and linked by URL, instead of Toast UI's default base64 data URIs.
*@
<div class="markdown-editor">
    <Editor @ref="_editor" @bind-Value="_editorValue" Options="_options" Placeholder="@Placeholder" Change="OnChangeAsync" Blur="OnBlurAsync" Load="OnLoadAsync" />
    @if (MaxLength is { } max)
    {
        <MudText Typo="Typo.caption" Align="Align.End" Color="@((Value?.Length ?? 0) > max ? Color.Error : Color.Secondary)" Class="d-block mt-1">
            @(Value?.Length ?? 0) / @max
        </MudText>
    }
</div>

@code {
    // The ToastUIEditor package (1.1.1) does not expose its JS object nor implement EditorOptions.Hooks,
    // so the image hook is installed on its private interop object.
    private static readonly FieldInfo? EditorInstanceField = typeof(Editor).GetField("_instance", BindingFlags.Instance | BindingFlags.NonPublic);

    private Editor? _editor;
    private string? _editorValue;
    private string? _markdown;
    private EditorOptions _options = default!;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MarkdownEditor>? _selfReference;

    /// <summary>The Markdown content.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Raised when the editor loses focus, after <see cref="ValueChanged"/> for the last edit.</summary>
    [Parameter] public EventCallback OnBlur { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string Height { get; set; } = "500px";

    /// <summary>Shows a character counter against this maximum (not enforced).</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Allows uploading images (when image storage is configured); otherwise the editor refuses images.</summary>
    [Parameter] public bool AllowImages { get; set; }

    /// <summary>
    /// Starts in the raw Markdown mode with a side-by-side preview instead of WYSIWYG, e.g. for files in a repository,
    /// where the WYSIWYG round trip would reformat the existing Markdown.
    /// </summary>
    [Parameter] public bool RawMarkdown { get; set; }

    protected override void OnInitialized()
    {
        _editorValue = _markdown = Value;
        _options = new EditorOptions
        {
            Height = Height,
            MinHeight = "200px",
            InitialEditType = RawMarkdown ? EditorType.Markdown : EditorType.WYSIWYG,
            PreviewStyle = RawMarkdown ? PreviewStyle.Vertical : PreviewStyle.Tab,
            UsageStatistics = false,
            Autofocus = false
        };
    }

    // The value was changed from outside the editor (e.g. by DGHSF Copilot): push it into the editor.
    protected override async Task OnParametersSetAsync()
    {
        if (_editor is not null && Value != _markdown)
        {
            _markdown = Value;
            await _editor.SetMarkdown(Value ?? string.Empty, false);
        }
    }

    private async Task OnChangeAsync()
    {
        if (_editor is null)
        {
            return;
        }

        var markdown = await _editor.GetMarkdown();
        _markdown = markdown;
        if (markdown != Value)
        {
            Value = markdown;
            await ValueChanged.InvokeAsync(markdown);
        }
    }

    private async Task OnBlurAsync()
    {
        await OnChangeAsync();
        await OnBlur.InvokeAsync();
    }

    private async Task OnLoadAsync()
    {
        try
        {
            // Toast UI raises "load" while it is being created, before the wrapper has stored its JS object.
            var instance = await WaitForEditorInstanceAsync();
            if (instance is null)
            {
                Logger.LogWarning("The Toast UI editor object was not found; image handling is not configured.");
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/MarkdownEditor.razor.js");
            _selfReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("configureImages", instance, _selfReference, AllowImages && ImageUploads.IsEnabled, ImageUploads.MaxImageSize);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Configuring image handling of the Markdown editor failed.");
        }
    }

    private async Task<IJSObjectReference?> WaitForEditorInstanceAsync()
    {
        for (var attempt = 0; attempt < 100; attempt++)
        {
            if (EditorInstanceField?.GetValue(_editor) is IJSObjectReference instance)
            {
                return instance;
            }

            await Task.Delay(20);
        }

        return null;
    }

    [JSInvokable]
    public async Task<string?> UploadImage(IJSStreamReference image, string fileName, long size)
    {
        if (!AllowImages || !ImageUploads.IsEnabled)
        {
            ReportImageError("Image upload is not configured.");
            return null;
        }

        try
        {
            await using var stream = await image.OpenReadStreamAsync(ImageUploads.MaxImageSize);
            using var buffer = new MemoryStream((int)Math.Min(size, ImageUploads.MaxImageSize));
            await stream.CopyToAsync(buffer);
            var uploaded = await ImageUploads.UploadImageAsync(fileName, buffer.ToArray());
            return uploaded.Url;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Uploading image {FileName} failed.", fileName);
            ReportImageError(ex is InvalidOperationException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException ? ex.Message : "Uploading the image failed.");
            return null;
        }
    }

    [JSInvokable]
    public void ReportImageError(string message)
    {
        Snackbar.Add(message, Severity.Error);
    }

    public async ValueTask DisposeAsync()
    {
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
