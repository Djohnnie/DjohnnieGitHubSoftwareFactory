@* The model requests of one internal agent, or of all of them together, newest first, a page at a time. *@
@inject InternalAgentService Agents
@inject BrowserTimeZone LocalTime

<MudTable @ref="_table" T="InternalAgentUsage" ServerData="LoadAsync" RowsPerPage="25" Outlined="true" Striped="true" Dense="true" Hover="true"
          Elevation="0" LoadingProgressColor="Color.Primary" aria-label="@Label">
    <HeaderContent>
        <MudTh>When</MudTh>
        @if (ShowAgent)
        {
            <MudTh>Agent</MudTh>
        }
        <MudTh>Source</MudTh>
        <MudTh>Model</MudTh>
        <MudTh Style="text-align:right">Input tokens</MudTh>
        <MudTh Style="text-align:right">Cached</MudTh>
        <MudTh Style="text-align:right">Output tokens</MudTh>
        <MudTh Style="text-align:right">Of which reasoning</MudTh>
        <MudTh Style="text-align:right">Input cost</MudTh>
        <MudTh Style="text-align:right">Output cost</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="When" Style="white-space:nowrap">@LocalTime.Format(context.OccurredAt, "yyyy-MM-dd HH:mm:ss")</MudTd>
        @if (ShowAgent)
        {
            <MudTd DataLabel="Agent"><MudLink Href="@($"/internal-agents/{context.AgentKey}")" Typo="Typo.body2">@context.AgentName</MudLink></MudTd>
        }
        <MudTd DataLabel="Source">@context.Source.Description()</MudTd>
        <MudTd DataLabel="Model" Class="mono">@context.Model</MudTd>
        <MudTd DataLabel="Input tokens" Style="text-align:right">@context.InputTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Cached" Style="text-align:right">@context.CachedInputTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Output tokens" Style="text-align:right">@context.OutputTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Of which reasoning" Style="text-align:right">@context.ReasoningTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Input cost" Style="text-align:right">@InternalAgentUsage.FormatCost(context.InputCost)</MudTd>
        <MudTd DataLabel="Output cost" Style="text-align:right">@InternalAgentUsage.FormatCost(context.OutputCost)</MudTd>
        <MudTd DataLabel="Total" Style="text-align:right">@InternalAgentUsage.FormatCost(context.TotalCost)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">@(_error ?? "No requests yet.")</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="[25, 50, 100]" />
    </PagerContent>
</MudTable>

@code {
    /// <summary>The agent whose requests are listed; <c>null</c> for the requests of all agents.</summary>
    [Parameter] public string? AgentKey { get; set; }

    /// <summary>Adds a column with the agent of each request, for a list that combines agents.</summary>
    [Parameter] public bool ShowAgent { get; set; }

    [Parameter] public string Label { get; set; } = "Requests";

    private MudTable<InternalAgentUsage>? _table;
    private string? _error;

    /// <summary>Loads the newest requests again, back on the first page so a new request shows.</summary>
    public async Task ReloadAsync()
    {
        if (_table is not null)
        {
            _table.NavigateTo(Page.First);
            await _table.ReloadServerData();
        }
    }

    private async Task<TableData<InternalAgentUsage>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var page = await Agents.GetUsagePageAsync(new InternalAgentUsageQuery(AgentKey, state.Page, state.PageSize), cancellationToken);
            _error = null;
            return new TableData<InternalAgentUsage> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Could not load the requests: {ex.Message}";
            return new TableData<InternalAgentUsage> { Items = [], TotalItems = 0 };
        }
    }
}
