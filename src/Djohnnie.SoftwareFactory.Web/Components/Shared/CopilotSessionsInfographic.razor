@using System.Globalization
@inject GitHubService GitHub
@inject TimeProvider Time

@* The open pull requests and the Copilot cloud agent sessions running right now, read live from GitHub. *@
<section class="usage-infographic mb-6" aria-labelledby="copilot-sessions-title">
    <div class="usage-infographic-header">
        <MudText Typo="Typo.h6" id="copilot-sessions-title">Pull requests &amp; Copilot sessions</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_overview is { } checkedOverview ? $"Right now · checked {checkedOverview.CheckedAt.ToLocalTime():HH:mm}" : "Right now")
        </MudText>
        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadAsync" Disabled="_loading"
                       title="Check again" aria-label="Check the pull requests and sessions again" />
    </div>

    @if (_loading && _overview is null)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="10rem" />
    }
    else if (_overview is not { } overview)
    {
        <MudPaper Outlined="true" Elevation="0" Class="usage-infographic-message">
            <MudText Typo="Typo.body1">Could not load the open pull requests: @_error</MudText>
        </MudPaper>
    }
    else
    {
        <div class="usage-infographic-stats">
            @Stat(Icons.Material.Filled.CallSplit, "Open pull requests", overview.OpenPullRequests.Count.ToString("#,0", CultureInfo.InvariantCulture),
                  overview.Drafts == 0 ? null : $"{overview.Drafts} {(overview.Drafts == 1 ? "draft" : "drafts")}")
            @Stat(Icons.Material.Filled.SmartToy, "Opened by Copilot", overview.ByCopilot.ToString("#,0", CultureInfo.InvariantCulture),
                  $"of {overview.OpenPullRequests.Count} open")
            @Stat(Icons.Material.Filled.PlayCircle, "Copilot sessions running", overview.SessionsUnavailable ? "?" : overview.RunningSessions.ToString("#,0", CultureInfo.InvariantCulture),
                  overview.SessionsUnavailable ? "needs access to Actions" : overview.QueuedSessions == 0 ? null : $"{overview.QueuedSessions} queued")
        </div>

        <MudPaper Outlined="true" Elevation="0" Class="usage-infographic-panel">
            <div class="usage-infographic-panel-header">
                <MudText Typo="Typo.subtitle2">Open pull requests</MudText>
            </div>
            @if (overview.OpenPullRequests.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">There are no open pull requests.</MudText>
            }
            else
            {
                <div class="sessions-table-scroll">
                    <table class="infographic-table">
                        <thead>
                            <tr>
                                <th scope="col">Pull request</th>
                                <th scope="col">Author</th>
                                <th scope="col">Copilot session</th>
                                <th scope="col">Work item</th>
                                <th scope="col" class="infographic-number">Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pullRequest in overview.OpenPullRequests)
                            {
                                <tr>
                                    <th scope="row" class="sessions-title">
                                        <MudLink Href="@pullRequest.Url" Target="_blank">#@pullRequest.Number</MudLink>
                                        @pullRequest.Title
                                        @if (pullRequest.IsDraft)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">Draft</MudChip>
                                        }
                                    </th>
                                    <td>
                                        @if (pullRequest.ByCopilot)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Style="vertical-align:text-bottom" />
                                        }
                                        @(pullRequest.AuthorLogin ?? "unknown")
                                    </td>
                                    <td>@Session(pullRequest.Session)</td>
                                    <td>
                                        @if (pullRequest.WorkItem is { } item)
                                        {
                                            <MudLink Href="@WorkItemRoutes.ItemPath(item.Type, item.Id)" title="@item.Type.DisplayName">
                                                <MudIcon Icon="@WorkItemRoutes.Icon(item.Type)" Size="Size.Small" Style="vertical-align:text-bottom" /> @item.Title
                                            </MudLink>
                                        }
                                    </td>
                                    <td class="infographic-number">@Ago(pullRequest.UpdatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (overview.OtherSessions.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">Sessions without an open pull request</MudText>
                @foreach (var session in overview.OtherSessions)
                {
                    <MudText Typo="Typo.body2">
                        @Session(session) <span class="mono">@(session.Branch ?? "unknown branch")</span>
                    </MudText>
                }
            }
        </MudPaper>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public GitHubRepository Repository { get; set; } = null!;

    private bool _loading = true;
    private CopilotPullRequestOverview? _overview;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _overview = await GitHub.GetCopilotPullRequestOverviewAsync(Repository.FullName);
            _error = null;
        }
        catch (Exception ex) when (ex is GitHubApiException or HttpRequestException or System.Text.Json.JsonException
                                       or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException)
        {
            _overview = null;
            _error = ex.Message;
        }
        _loading = false;
    }

    private RenderFragment Session(CopilotSession? session)
    {
        if (session is null)
        {
            return @<span class="sessions-idle">—</span>;
        }
        return @<MudLink Href="@session.Url" Target="_blank" title="Open the session log">
            @if (session.IsQueued)
            {
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Small" Color="Color.Default" Style="vertical-align:text-bottom" />
                <span> Queued @Ago(session.StartedAt)</span>
            }
            else
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Warning" Style="width:14px;height:14px;vertical-align:middle" />
                <span> Running for @Duration(session.StartedAt)</span>
            }
        </MudLink>;
    }

    private static RenderFragment Stat(string icon, string label, string value, string? detail)
    {
        return @<MudPaper Outlined="true" Elevation="0" Class="infographic-stat">
            <MudIcon Icon="@icon" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@label</MudText>
                <MudText Typo="Typo.h6">@value</MudText>
                @if (detail is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@detail</MudText>
                }
            </div>
        </MudPaper>;
    }

    private string Duration(DateTimeOffset since)
    {
        var elapsed = Time.GetUtcNow() - since;
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "less than a minute";
        }
        return elapsed < TimeSpan.FromHours(1)
            ? $"{(int)elapsed.TotalMinutes} min"
            : $"{(int)elapsed.TotalHours} h {elapsed.Minutes} min";
    }

    private string Ago(DateTimeOffset at)
    {
        var elapsed = Time.GetUtcNow() - at;
        if (elapsed < TimeSpan.FromHours(1))
        {
            return elapsed < TimeSpan.FromMinutes(1) ? "just now" : $"{(int)elapsed.TotalMinutes} min ago";
        }
        if (elapsed < TimeSpan.FromDays(1))
        {
            return $"{(int)elapsed.TotalHours} h ago";
        }
        return at.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
