@if (TooltipOf(Status, Executor) is { } tooltip)
{
    <MudTooltip Text="@tooltip" Inline="true">
        <MudChip T="string" Size="Size.Small" Color="@ColorOf(Status)" Variant="Variant.Outlined" Icon="@IconOf(Status, Executor)">@LabelOf(Status)</MudChip>
    </MudTooltip>
}
else
{
    <MudChip T="string" Size="Size.Small" Color="@ColorOf(Status)" Variant="Variant.Outlined" Icon="@IconOf(Status, Executor)">@LabelOf(Status)</MudChip>
}

@code {
    [Parameter] public WorkItemStatus Status { get; set; }

    /// <summary>The agent the item runs on: an item in progress shows that agent's icon.</summary>
    [Parameter] public AgentExecutor Executor { get; set; } = AgentExecutor.DghsfWorker;

    /// <summary>The statuses in the order of a work item's life, for filters.</summary>
    public static IReadOnlyList<WorkItemStatus> Ordered { get; } =
        [WorkItemStatus.Generated, WorkItemStatus.Draft, WorkItemStatus.Accepted, WorkItemStatus.InProgress, WorkItemStatus.Done, WorkItemStatus.NotPlanned];

    public static string LabelOf(WorkItemStatus status)
    {
        return status switch
        {
            WorkItemStatus.Draft => "Draft",
            WorkItemStatus.Generated => "Generated draft",
            WorkItemStatus.Accepted => "Accepted",
            WorkItemStatus.InProgress => "In progress",
            WorkItemStatus.Done => "Closed",
            WorkItemStatus.NotPlanned => "Not planned",
            _ => status.ToString()
        };
    }

    private static string? TooltipOf(WorkItemStatus status, AgentExecutor executor)
    {
        return status switch
        {
            WorkItemStatus.Generated => "A draft the background agents generated from the repository. Review it like any draft before accepting it.",
            WorkItemStatus.InProgress => $"The {executor.DisplayName} works on it.",
            WorkItemStatus.NotPlanned => "The GitHub issue was closed as not planned or as a duplicate, so it doesn't count as finished work.",
            _ => null
        };
    }

    private static Color ColorOf(WorkItemStatus status)
    {
        return status switch
        {
            WorkItemStatus.Generated => Color.Secondary,
            WorkItemStatus.Accepted => Color.Info,
            WorkItemStatus.InProgress => Color.Warning,
            WorkItemStatus.Done => Color.Success,
            _ => Color.Default
        };
    }

    /// <summary>An item in progress shows the icon of the agent that works on it (see <see cref="WorkItemRoutes.Icon(AgentExecutor)"/>).</summary>
    public static string IconOf(WorkItemStatus status, AgentExecutor executor)
    {
        return status switch
        {
            WorkItemStatus.Generated => Icons.Material.Filled.AutoAwesome,
            WorkItemStatus.Accepted => Icons.Material.Filled.TaskAlt,
            WorkItemStatus.InProgress => WorkItemRoutes.Icon(executor),
            WorkItemStatus.Done => Icons.Material.Filled.Done,
            WorkItemStatus.NotPlanned => Icons.Material.Filled.DoNotDisturb,
            _ => Icons.Material.Filled.EditNote
        };
    }
}
