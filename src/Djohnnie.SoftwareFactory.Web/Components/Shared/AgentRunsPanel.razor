@using Djohnnie.SoftwareFactory.Application.Features.AgentRuns
@using Djohnnie.SoftwareFactory.Contracts.AgentRuns
@using Djohnnie.SoftwareFactory.Web.Components.Pages
@inject AgentRunService AgentRuns
@inject ISnackbar Snackbar

@* The DGHSF agent worker's runs of one work item, newest first, with what each one cost. A revision run continues the pull
   request an earlier run opened, on feedback sent from the pull request's discussion. *@
<MudPaper Class="pa-4" Outlined="true" Elevation="0" aria-label="Agent worker runs">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.h6">Agent worker runs</MudText>
        <MudSpacer />
        <MudTooltip Text="Reload the runs">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadAsync" Disabled="_busy" aria-label="Reload the runs" />
        </MudTooltip>
    </MudStack>

    @if (_runs is null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        @if (_runs.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mb-2" aria-label="Total cost">
                @_runs.Count @(_runs.Count == 1 ? "run" : "runs") · @AiModel.FormatCredits(TotalCredits)@(_runs.Any(r => r.NanoAiu is not null && !r.UsageComplete) ? " (at least)" : null)
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">No runs yet.</MudText>
        }

        <MudStack Spacing="2">
            @foreach (var run in _runs)
            {
                <div class="agent-run" @key="run.Id">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ColorOf(run.Status)" Icon="@IconOf(run.Status)">@run.Status.DisplayName</MudChip>
                        @if (run.Kind == AgentRunKind.Revise)
                        {
                            <MudText Typo="Typo.caption" Class="agent-run-kind">Revision</MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary"><TimeAgo At="@(run.StartedAt ?? run.CreatedAt)" /></MudText>
                        @if (run.Duration is { } duration)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">· @FormatDuration(duration)</MudText>
                        }
                        @if (run.Attempts > 1)
                        {
                            @* Retries are runs of the same task; the background tasks page lists them. *@
                            <MudText Typo="Typo.caption" Color="Color.Secondary">· @run.Attempts runs</MudText>
                        }
                        @if (run.PullRequestNumber is { } number)
                        {
                            <MudLink Href="@run.PullRequestUrl" Target="_blank" Typo="Typo.caption">#@number</MudLink>
                        }
                    </MudStack>
                    @if (run.AiCredits is { } credits)
                    {
                        <MudText Typo="Typo.caption" Class="d-block" title="@TokenDetails(run)">
                            @AiModel.FormatCredits(credits)@(run.UsageComplete ? null : " (at least)")
                            @if (run.Models is not null)
                            {
                                <span> · @run.Models</span>
                            }
                        </MudText>
                    }
                    else if (run.RequestedModel is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@run.RequestedModel</MudText>
                    }
                    @if (run.Error is not null)
                    {
                        <MudText Typo="Typo.caption" Color="@(run.Status == AgentRunStatus.Succeeded ? Color.Warning : Color.Error)" Class="d-block agent-run-error">@run.Error</MudText>
                    }
                    @if (run.IsActive)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="() => CancelAsync(run)" Disabled="_busy">Cancel run</MudButton>
                    }
                </div>
            }
        </MudStack>

        @if (CanStart && !_runs.Any(r => r.IsActive))
        {
            <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                @if (RevisablePullRequest is { } revised)
                {
                    @* Feedback that no revision handled yet (it failed, or was never started) is still new for this one. *@
                    <MudTooltip Text="Address the feedback written on the pull request since the agent's last run on it, on the same branch">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RateReview"
                                   OnClick="ReviseAsync" Disabled="_busy">Revise #@revised</MudButton>
                    </MudTooltip>
                }
                <MudTooltip Text="Start over from the base branch, on a new branch with a new pull request">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Replay"
                               OnClick="StartAsync" Disabled="_busy">Start over (new pull request)</MudButton>
                </MudTooltip>
            </MudStack>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public Guid WorkItemId { get; set; }

    /// <summary>Whether another run can be started (the item is in progress).</summary>
    [Parameter]
    public bool CanStart { get; set; }

    /// <summary>Called after a run was started or cancelled, so the page can refresh the item.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private IReadOnlyList<AgentRun>? _runs;
    private bool _busy;

    private decimal TotalCredits
    {
        get
        {
            return _runs?.Sum(r => r.AiCredits ?? 0) ?? 0;
        }
    }

    /// <summary>
    /// The pull request the worker opened for the item (the newest), which a revision continues; whether it is still open is
    /// checked when the revision starts.
    /// </summary>
    private int? RevisablePullRequest
    {
        get
        {
            return _runs?.FirstOrDefault(r => r is { Kind: AgentRunKind.Implement, Status: AgentRunStatus.Succeeded, PullRequestNumber: not null })?.PullRequestNumber;
        }
    }

    private (string, Guid)? _loaded;

    /// <summary>Loads once per work item; the page re-renders the panel often (the callback counts as a changed parameter).</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != (RepositoryFullName, WorkItemId))
        {
            _loaded = (RepositoryFullName, WorkItemId);
            await LoadAsync();
        }
    }

    /// <summary>Reads the runs again, e.g. after the page refreshed the item.</summary>
    public async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            _runs = await AgentRuns.GetRunsAsync(RepositoryFullName, WorkItemId);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            _runs ??= [];
            Snackbar.Add($"Could not load the agent worker's runs: {ex.Message}", Severity.Error);
        }
    }

    private async Task StartAsync()
    {
        _busy = true;
        try
        {
            await AgentRuns.StartRunAsync(RepositoryFullName, WorkItemId);
            Snackbar.Add("The agent worker will start a new run shortly.", Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not start a run: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReviseAsync()
    {
        _busy = true;
        try
        {
            await AgentRuns.StartRevisionAsync(RepositoryFullName, WorkItemId);
            Snackbar.Add("The agent worker will start a revision run on the same branch shortly.", Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not start a revision run: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync(AgentRun run)
    {
        _busy = true;
        try
        {
            await AgentRuns.CancelRunAsync(RepositoryFullName, run.Id);
            Snackbar.Add("Cancelled the run. A worker that is running it stops within a few minutes and pushes nothing.", Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not cancel the run: {ex.Message}", Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    public static Color ColorOf(AgentRunStatus status)
    {
        return status switch
        {
            AgentRunStatus.Succeeded => Color.Success,
            AgentRunStatus.Failed => Color.Error,
            AgentRunStatus.Running => Color.Info,
            AgentRunStatus.Cancelled => Color.Default,
            _ => Color.Secondary
        };
    }

    public static string IconOf(AgentRunStatus status)
    {
        return status switch
        {
            AgentRunStatus.Succeeded => Icons.Material.Filled.CheckCircle,
            AgentRunStatus.Failed => Icons.Material.Filled.Error,
            AgentRunStatus.Running => Icons.Material.Filled.SmartToy,
            AgentRunStatus.Cancelled => Icons.Material.Filled.Block,
            _ => Icons.Material.Filled.Schedule
        };
    }

    public static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1 ? $"{(int)duration.TotalHours} h {duration.Minutes} min"
            : duration.TotalMinutes >= 1 ? $"{(int)duration.TotalMinutes} min"
            : $"{duration.Seconds} s";
    }

    public static string TokenDetails(AgentRun run)
    {
        var premium = run.PremiumRequests is { } requests ? $", {requests:#,0.##} premium requests" : string.Empty;
        return $"{run.InputTokens:#,0} input, {run.OutputTokens:#,0} output, {run.CacheReadTokens:#,0} cached, {run.CacheWriteTokens:#,0} cache write tokens{premium}";
    }
}
