@* The colored token usage and cost figures of one internal agent, or of all of them together. *@

<UsageTileGrid Tiles="Tiles" SingleRow="SingleRow" />

@code {
    [Parameter, EditorRequired] public InternalAgentUsageTotals Totals { get; set; } = default!;

    /// <summary>Shows the tiles next to each other, with the total cost as the first tile.</summary>
    [Parameter] public bool SingleRow { get; set; }

    private List<UsageTile> Tiles
    {
        get
        {
            var tiles = new List<UsageTile>();
            if (SingleRow)
            {
                tiles.Add(new("Total cost", InternalAgentUsage.FormatCost(Totals.TotalCost), "usage-total"));
            }
            tiles.Add(new("Requests", Totals.RequestCount.ToString("N0"), "usage-requests", Wide: true));
            tiles.Add(new("Input cost", InternalAgentUsage.FormatCost(Totals.InputCost), "usage-input"));
            tiles.Add(new("Output cost", InternalAgentUsage.FormatCost(Totals.OutputCost), "usage-output"));
            tiles.Add(new("Input tokens", Totals.InputTokens.ToString("N0"), "usage-input"));
            tiles.Add(new("Output tokens", Totals.OutputTokens.ToString("N0"), "usage-output"));
            tiles.Add(new("Of which cached", Totals.CachedInputTokens.ToString("N0"), "usage-cached"));
            tiles.Add(new("Of which reasoning", Totals.ReasoningTokens.ToString("N0"), "usage-reasoning"));
            return tiles;
        }
    }
}
