@implements IDisposable
@inject AssistantService Assistant
@inject ISnackbar Snackbar

@*
    A chat with one of DGHSF's internal Copilots. The Copilot (system prompt, name, enabled state) is managed on the
    internal agents page; the page supplies the tools that read and fill its form. With an Owner the conversation is stored
    with it and shown again when the page is reopened; a page without an Owner yet calls AttachAsync once it has one. Before the conversation starts, the Chat Suggestions agent writes suggestion chips in the
    background; the static suggestions are the fallback.
*@
@if (_copilot is { IsEnabled: false })
{
    @* Disabled on the internal agents page. *@
}
else
{
    <MudPaper Class="pa-4 assistant-chat" Outlined="true" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.h6">@(Title ?? _copilot?.Name ?? AssistantService.AgentName)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
                </div>
            </MudStack>
            @if (_messages.Count > 0)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="StartNewConversationAsync" Disabled="_busy">Start new conversation</MudButton>
            }
        </MudStack>

        @if (!Assistant.IsConfigured)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-3">
                DGHSF Copilot is not configured yet. Set <code>OpenAI:Endpoint</code>, <code>OpenAI:Model</code> and
                <code>OpenAI:ApiKey</code> (for example with <code>dotnet user-secrets</code>) and restart the app.
            </MudAlert>
        }
        else if (_loadError is not null)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Class="mt-3">@_loadError</MudAlert>
        }
        else
        {
            @if (_messages.Count > 0)
            {
                <div class="chat-log mt-3">
                    <div>
                        @foreach (var message in _messages)
                        {
                            <div class="@($"chat-message {(message.FromUser ? "from-user" : "from-assistant")}{(message.IsError ? " is-error" : string.Empty)}")">
                                @if (message.Text.Length == 0 && _busy)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else if (message.FromUser || message.IsError)
                                {
                                    @message.Text
                                }
                                else
                                {
                                    @* Copilot replies are Markdown; ChatMarkdown escapes raw HTML and keeps only safe links. *@
                                    <div class="chat-markdown">@((MarkupString)ChatMarkdown.ToHtml(message.Text))</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_suggesting)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2 suggestions-loading" aria-live="polite">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Thinking of suggestions…</MudText>
                </MudStack>
            }
            else if (CurrentSuggestions.Count > 0)
            {
                <div class="mt-2">
                    @foreach (var suggestion in CurrentSuggestions)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SendAsync(suggestion)">@suggestion</MudChip>
                    }
                </div>
            }

            @* Read-only rather than disabled while busy, so the Stop adornment stays clickable. *@
            <MudTextField Variant="Variant.Outlined" @bind-Value="_input" Label="@Placeholder" Immediate="true" Class="mt-2"
                          ReadOnly="_busy" Disabled="_copilot is null" OnKeyDown="OnKeyDownAsync"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_busy ? Icons.Material.Filled.Stop : Icons.Material.Filled.Send)"
                          AdornmentColor="@(_busy ? Color.Error : string.IsNullOrWhiteSpace(_input) ? Color.Default : Color.Primary)"
                          AdornmentAriaLabel="@(_busy ? "Stop" : "Send (Enter)")"
                          OnAdornmentClick="OnAdornmentClickAsync" />
        }
    </MudPaper>
}

@code {
    private sealed record ChatEntry(bool fromUser, string text)
    {
        public bool FromUser { get; } = fromUser;
        public string Text { get; set; } = text;
        public bool IsError { get; set; }
    }

    /// <summary>The internal Copilot, see <see cref="InternalAgentKeys"/>.</summary>
    [Parameter, EditorRequired] public string CopilotKey { get; set; } = string.Empty;

    /// <summary>Overrides the Copilot's name as the title.</summary>
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Ask DGHSF Copilot";

    [Parameter] public AssistantTools? Tools { get; set; }

    /// <summary>What the conversation is stored with; <c>null</c> while that doesn't exist yet, such as on a new item.</summary>
    [Parameter] public ChatOwner? Owner { get; set; }

    /// <summary>Example prompts shown before the conversation starts when the Chat Suggestions agent has none.</summary>
    [Parameter] public IReadOnlyList<string> Suggestions { get; set; } = [];

    /// <summary>Extra page context for the Chat Suggestions agent, e.g. the selected repository.</summary>
    [Parameter] public string? SuggestionContext { get; set; }

    private readonly List<ChatEntry> _messages = [];
    private InternalAgent? _copilot;
    private string? _loadedKey;
    private ChatOwner? _loadedOwner;
    private string? _loadError;
    private AssistantConversation? _conversation;
    private CancellationTokenSource? _cancellation;
    private CancellationTokenSource? _suggestionCancellation;
    private IReadOnlyList<string>? _generatedSuggestions;
    private bool _suggestionsRequested;
    private bool _suggesting;
    private string? _input;
    private bool _busy;

    private IReadOnlyList<string> CurrentSuggestions => _generatedSuggestions is { Count: > 0 } generated ? generated : Suggestions;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedKey != CopilotKey || _loadedOwner != Owner)
        {
            _loadedKey = CopilotKey;
            _loadedOwner = Owner;
            _copilot = null;
            _conversation = null;
            _loadError = null;
            _messages.Clear();
            try
            {
                var copilot = await Assistant.GetCopilotAsync(CopilotKey);
                if (Owner is not null)
                {
                    var history = await Assistant.GetHistoryAsync(Owner);
                    _messages.AddRange(history.Select(m => new ChatEntry(m.Role == ChatMessageRole.User, m.Text) { IsError = m.IsError }));
                }

                // Last: the suggestions wait for it, and aren't written for a conversation that continues.
                _copilot = copilot;
            }
            catch (Exception ex)
            {
                _loadError = $"Could not load the Copilot: {ex.Message}";
            }
        }

        StartSuggestions();
    }

    /// <summary>Starts the Chat Suggestions agent once the page's tools (and so its form) are available.</summary>
    private void StartSuggestions()
    {
        if (_suggestionsRequested || _copilot is not { IsEnabled: true } copilot || Tools is null
            || !Assistant.IsConfigured || _messages.Count > 0)
        {
            return;
        }

        _suggestionsRequested = true;
        _suggesting = true;
        _suggestionCancellation = new CancellationTokenSource();
        _ = GenerateSuggestionsAsync(copilot, Tools, _suggestionCancellation.Token);
    }

    private async Task GenerateSuggestionsAsync(InternalAgent copilot, AssistantTools tools, CancellationToken cancellationToken)
    {
        IReadOnlyList<string> suggestions = [];
        try
        {
            // Let the page finish rendering its form first; the tools read it on the UI thread.
            await Task.Yield();
            suggestions = await Assistant.SuggestPromptsAsync(copilot, SuggestionContext, tools, cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }

        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        await InvokeAsync(() =>
        {
            _generatedSuggestions = suggestions;
            _suggesting = false;
            StateHasChanged();
        });
    }

    private void CancelSuggestions()
    {
        _suggestionCancellation?.Cancel();
        _suggestionCancellation?.Dispose();
        _suggestionCancellation = null;
        _suggesting = false;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy)
        {
            await SendAsync(_input);
        }
    }

    private async Task SendAsync(string? text)
    {
        text = text?.Trim();
        if (string.IsNullOrEmpty(text) || _busy || _copilot is null)
        {
            return;
        }

        CancelSuggestions();
        _input = null;
        _busy = true;
        _messages.Add(new ChatEntry(true, text));
        var reply = new ChatEntry(false, string.Empty);
        _messages.Add(reply);
        _cancellation = new CancellationTokenSource();

        try
        {
            _conversation ??= Assistant.CreateConversation(_copilot, Tools, Owner);
            await foreach (var update in _conversation.RunStreamingAsync(text, _cancellation.Token))
            {
                reply.Text += update;
                StateHasChanged();
            }

            if (reply.Text.Length == 0)
            {
                reply.Text = "Done.";
            }
        }
        catch (OperationCanceledException)
        {
            reply.Text += reply.Text.Length == 0 ? "(stopped)" : " (stopped)";
        }
        catch (Exception ex)
        {
            reply.IsError = true;
            reply.Text = $"Something went wrong: {ex.Message}";
        }

        try
        {
            await SaveTurnAsync(text, reply);
        }
        finally
        {
            _busy = false;
            _cancellation.Dispose();
            _cancellation = null;
        }
    }

    private async Task SaveTurnAsync(string text, ChatEntry reply)
    {
        if (_conversation is null)
        {
            return;
        }

        try
        {
            await _conversation.SaveTurnAsync(text, reply.Text, reply.IsError);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save this message yet; it's tried again with the next one: {ex.Message}", Severity.Warning);
        }
    }

    /// <summary>Stores the conversation so far with its owner, once that exists; call it before leaving the page.</summary>
    public async Task AttachAsync(ChatOwner owner)
    {
        if (_conversation is null)
        {
            return;
        }

        try
        {
            await _conversation.AttachAsync(owner);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Saved, but the Copilot conversation could not be stored: {ex.Message}", Severity.Warning);
        }
    }

    private async Task OnAdornmentClickAsync()
    {
        if (_busy)
        {
            Cancel();
        }
        else
        {
            await SendAsync(_input);
        }
    }

    private void Cancel()
    {
        _cancellation?.Cancel();
    }

    /// <summary>
    /// Lets the Chat Suggestions agent write new chips for the form as it is now, e.g. after a field changed.
    /// Ignored while a conversation is going on (no chips are shown then; a reset writes new ones).
    /// </summary>
    public void RefreshSuggestions()
    {
        if (_messages.Count > 0 || !_suggestionsRequested)
        {
            return;
        }

        CancelSuggestions();
        _generatedSuggestions = null;
        _suggestionsRequested = false;
        StartSuggestions();
        StateHasChanged();
    }

    /// <summary>Closes the conversation; it stays stored, and the next message starts a new one.</summary>
    private async Task StartNewConversationAsync()
    {
        if (Owner is not null)
        {
            try
            {
                await Assistant.CloseConversationAsync(Owner);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not start a new conversation: {ex.Message}", Severity.Error);
                return;
            }
        }

        _messages.Clear();
        _conversation = null;
        _input = null;

        // New suggestions for the form as it is now.
        _generatedSuggestions = null;
        _suggestionsRequested = false;
        StartSuggestions();
    }

    public void Dispose()
    {
        _cancellation?.Cancel();
        CancelSuggestions();
    }
}
