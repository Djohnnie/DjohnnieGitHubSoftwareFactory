@implements IDisposable
@inject AssistantService AgentFactory

@*
    A chat with DGHSF Copilot. The page supplies the task instructions and the tools that read and fill its form;
    the conversation (agent session) lives as long as the component.
*@
<MudPaper Class="pa-4 assistant-chat" Outlined="true" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">@Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
            </div>
        </MudStack>
        @if (_messages.Count > 0)
        {
            <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.RestartAlt" OnClick="Reset" Disabled="_busy" title="Start a new conversation" />
        }
    </MudStack>

    @if (!AgentFactory.IsConfigured)
    {
        <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-3">
            DGHSF Copilot is not configured yet. Set <code>OpenAI:Endpoint</code>, <code>OpenAI:Model</code> and
            <code>OpenAI:ApiKey</code> (for example with <code>dotnet user-secrets</code>) and restart the app.
        </MudAlert>
    }
    else
    {
        @if (_messages.Count > 0)
        {
            <div class="chat-log mt-3">
                <div>
                    @foreach (var message in _messages)
                    {
                        <div class="@($"chat-message {(message.FromUser ? "from-user" : "from-assistant")}{(message.IsError ? " is-error" : string.Empty)}")">
                            @if (message.Text.Length == 0 && _busy)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                @message.Text
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (Suggestions.Count > 0)
        {
            <div class="mt-2">
                @foreach (var suggestion in Suggestions)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SendAsync(suggestion)">@suggestion</MudChip>
                }
            </div>
        }

        <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-2">
            <MudTextField Variant="Variant.Outlined" @bind-Value="_input" Label="@Placeholder" Immediate="true" Disabled="_busy"
                          OnKeyDown="OnKeyDownAsync" />
            @if (_busy)
            {
                <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Stop" Color="Color.Error" OnClick="Cancel" title="Stop" />
            }
            else
            {
                <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_input)"
                               OnClick="() => SendAsync(_input)" title="Send (Enter)" />
            }
        </MudStack>
    }
</MudPaper>

@code {
    private sealed record ChatEntry(bool fromUser, string text)
    {
        public bool FromUser { get; } = fromUser;
        public string Text { get; set; } = text;
        public bool IsError { get; set; }
    }

    [Parameter] public string Title { get; set; } = AssistantService.AgentName;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Ask DGHSF Copilot";

    /// <summary>The task-specific instructions, on top of the generic DGHSF Copilot instructions.</summary>
    [Parameter, EditorRequired] public string Instructions { get; set; } = string.Empty;

    [Parameter] public AssistantTools? Tools { get; set; }

    /// <summary>Example prompts shown before the conversation starts.</summary>
    [Parameter] public IReadOnlyList<string> Suggestions { get; set; } = [];

    private readonly List<ChatEntry> _messages = [];
    private AssistantConversation? _conversation;
    private CancellationTokenSource? _cancellation;
    private string? _input;
    private bool _busy;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy)
        {
            await SendAsync(_input);
        }
    }

    private async Task SendAsync(string? text)
    {
        text = text?.Trim();
        if (string.IsNullOrEmpty(text) || _busy)
        {
            return;
        }

        _input = null;
        _busy = true;
        _messages.Add(new ChatEntry(true, text));
        var reply = new ChatEntry(false, string.Empty);
        _messages.Add(reply);
        _cancellation = new CancellationTokenSource();

        try
        {
            _conversation ??= AgentFactory.CreateConversation(Instructions, Tools);
            await foreach (var update in _conversation.RunStreamingAsync(text, _cancellation.Token))
            {
                reply.Text += update;
                StateHasChanged();
            }

            if (reply.Text.Length == 0)
            {
                reply.Text = "Done.";
            }
        }
        catch (OperationCanceledException)
        {
            reply.Text += reply.Text.Length == 0 ? "(stopped)" : " (stopped)";
        }
        catch (Exception ex)
        {
            reply.IsError = true;
            reply.Text = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _cancellation.Dispose();
            _cancellation = null;
        }
    }

    private void Cancel() => _cancellation?.Cancel();

    private void Reset()
    {
        _messages.Clear();
        _conversation?.Reset();
        _input = null;
    }

    public void Dispose() => _cancellation?.Cancel();
}
