<MudDialog>
    <DialogContent>
        <RepositoryPicker SelectedFullName="@SelectedFullName" OnSelected="Select" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? SelectedFullName { get; set; }

    private void Select(GitHubRepository repository)
    {
        MudDialog.Close(DialogResult.Ok(repository));
    }
}