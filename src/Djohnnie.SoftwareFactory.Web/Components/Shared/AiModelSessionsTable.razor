@* The DGHSF agent worker sessions that were counted on one GitHub Copilot model, newest first, a page at a time. *@
@inject AiModelService Models
@inject RepositoryContext Repository
@inject BrowserTimeZone LocalTime

<MudTable @ref="_table" T="AiModelUsage" ServerData="LoadAsync" RowsPerPage="25" Outlined="true" Striped="true" Dense="true" Hover="true"
          Elevation="0" LoadingProgressColor="Color.Primary" aria-label="Agent sessions">
    <HeaderContent>
        <MudTh>When</MudTh>
        <MudTh>Work item</MudTh>
        <MudTh>Repository</MudTh>
        <MudTh Style="text-align:right">Attempt</MudTh>
        <MudTh Style="text-align:right">Requests</MudTh>
        <MudTh Style="text-align:right">Input tokens</MudTh>
        <MudTh Style="text-align:right">Cache read</MudTh>
        <MudTh Style="text-align:right">Cache write</MudTh>
        <MudTh Style="text-align:right">Output tokens</MudTh>
        <MudTh Style="text-align:right">Of which reasoning</MudTh>
        <MudTh Style="text-align:right">AI credits</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="When" Style="white-space:nowrap">@LocalTime.Format(context.OccurredAt, "yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="Work item">
            @if (context.WorkItem is { } item)
            {
                <MudIcon Icon="@WorkItemRoutes.Icon(item.Type)" Size="Size.Small" Style="vertical-align:text-bottom" Class="mr-1" />
                @if (IsSelectedRepository(context))
                {
                    <MudLink Href="@WorkItemRoutes.ItemPath(item.Type, item.Id)" Typo="Typo.body2">@item.Title</MudLink>
                }
                else
                {
                    @item.Title
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Deleted work item</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Repository" Class="mono">@context.RepositoryFullName</MudTd>
        <MudTd DataLabel="Attempt" Style="text-align:right">@context.Attempt</MudTd>
        <MudTd DataLabel="Requests" Style="text-align:right">@context.Requests.ToString("N0")</MudTd>
        <MudTd DataLabel="Input tokens" Style="text-align:right">@context.InputTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Cache read" Style="text-align:right">@context.CacheReadTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Cache write" Style="text-align:right">@context.CacheWriteTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Output tokens" Style="text-align:right">@context.OutputTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="Of which reasoning" Style="text-align:right">@context.ReasoningTokens.ToString("N0")</MudTd>
        <MudTd DataLabel="AI credits" Style="text-align:right; white-space:nowrap">@AiModel.FormatCredits(context.AiCredits)@(context.Complete ? null : " (at least)")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">@(_error ?? "No agent sessions used this model yet.")</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="[25, 50, 100]" />
    </PagerContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public Guid ModelId { get; set; }

    private MudTable<AiModelUsage>? _table;
    private string? _error;

    /// <summary>Loads the newest sessions again, back on the first page.</summary>
    public async Task ReloadAsync()
    {
        if (_table is not null)
        {
            _table.NavigateTo(Page.First);
            await _table.ReloadServerData();
        }
    }

    // Work item pages belong to the selected repository, so only its items are linked.
    private bool IsSelectedRepository(AiModelUsage usage)
    {
        return string.Equals(Repository.Current?.FullName, usage.RepositoryFullName, StringComparison.OrdinalIgnoreCase);
    }

    private async Task<TableData<AiModelUsage>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var page = await Models.GetUsagePageAsync(new AiModelUsageQuery(ModelId, state.Page, state.PageSize), cancellationToken);
            _error = null;
            return new TableData<AiModelUsage> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Could not load the sessions: {ex.Message}";
            return new TableData<AiModelUsage> { Items = [], TotalItems = 0 };
        }
    }
}
