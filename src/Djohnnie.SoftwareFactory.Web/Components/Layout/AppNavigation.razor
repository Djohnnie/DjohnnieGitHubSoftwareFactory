@* The main navigation links: a horizontal bar of icons with tooltips below the app bar on desktop, a vertical list in the navigation panel on mobile.
   Template pages aren't linked here: each list page links its own templates. *@

@if (Vertical)
{
    <nav class="app-navigation app-navigation-vertical" aria-label="Main navigation">
        @if (HasRepository)
        {
            <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Dashboard">Overview</MudButton>
            <MudButton Href="@ChatRoutes.Path" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Forum">Chat</MudButton>

            <MudDivider Class="my-1" />

            <MudButton Href="/mindmaps" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Hub">Mindmaps</MudButton>
            <MudButton Href="/work-item-map" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.BubbleChart">Work item map</MudButton>
            <MudButton Href="@KnowledgeBaseRoutes.Path" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.LocalLibrary">Knowledge base</MudButton>

            <MudDivider Class="my-1" />

            <MudButton Href="@GitHubHref("/copilot-instructions")" Disabled="!GitHubAvailable" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                       StartIcon="@Icons.Material.Filled.IntegrationInstructions" title="@GitHubTitle("Instructions")">Instructions</MudButton>
            <MudButton Href="/skills" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.AutoFixHigh">Skills</MudButton>
            <MudButton Href="@GitHubHref("/agents")" Disabled="!GitHubAvailable" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                       StartIcon="@Icons.Material.Filled.SmartToy" title="@GitHubTitle("Agents")">Agents</MudButton>

            <MudDivider Class="my-1" />

            @foreach (var type in WorkItemTypeRules.All)
            {
                <MudButton Href="@WorkItemRoutes.ListPath(type)" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                           StartIcon="@WorkItemRoutes.Icon(type)">@type.PluralName</MudButton>
            }

            <MudDivider Class="my-1" />

            <MudButton Href="/models" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Cloud">GitHub Copilot Models</MudButton>
        }
        <MudButton Href="/internal-agents" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Material.Filled.Psychology">Internal agents</MudButton>
        <MudButton Href="/internal-models" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Material.Filled.Memory">Internal models</MudButton>

        @if (HasRepository)
        {
            <MudDivider Class="my-1" />

            <MudButton Href="@GitHubHref("/actions")" Disabled="!GitHubAvailable" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                       StartIcon="@Icons.Material.Filled.PlayCircle" title="@GitHubTitle("Actions")">Actions</MudButton>
            <MudButton Href="@GitHubHref("/copilot-code-review")" Disabled="!GitHubAvailable" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                       StartIcon="@Icons.Material.Filled.RateReview" title="@GitHubTitle("Code review")">Code review</MudButton>
        }

        <MudDivider Class="my-1" />

        @if (HasRepository)
        {
            <MudButton Href="/background-tasks" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.PendingActions">Background tasks</MudButton>
        }
        <MudButton Href="/sync-log" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Material.Filled.ManageHistory">Sync log</MudButton>

        <MudDivider Class="my-1" />

        <MudButton Href="@ProjectRepositoryUrl" Target="_blank" rel="noopener noreferrer" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Custom.Brands.GitHub" EndIcon="@Icons.Material.Filled.OpenInNew" aria-label="@ExternalLinkLabel">GitHub</MudButton>
    </nav>
}
else
{
    <nav class="app-navigation app-navigation-horizontal" aria-label="Main navigation">
        @if (HasRepository)
        {
            @IconLink("/", Icons.Material.Filled.Dashboard, "Overview")
            @IconLink(ChatRoutes.Path, Icons.Material.Filled.Forum, "Chat")

            <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

            @IconLink("/mindmaps", Icons.Material.Filled.Hub, "Mindmaps")
            @IconLink("/work-item-map", Icons.Material.Filled.BubbleChart, "Work item map")
            @IconLink(KnowledgeBaseRoutes.Path, Icons.Material.Filled.LocalLibrary, "Knowledge base")

            <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

            @IconLink("/copilot-instructions", Icons.Material.Filled.IntegrationInstructions, "Instructions", requiresGitHub: true)
            @IconLink("/skills", Icons.Material.Filled.AutoFixHigh, "Skills")
            @IconLink("/agents", Icons.Material.Filled.SmartToy, "Agents", requiresGitHub: true)

            <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

            @foreach (var type in WorkItemTypeRules.All)
            {
                @IconLink(WorkItemRoutes.ListPath(type), WorkItemRoutes.Icon(type), type.PluralName)
            }

            <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

            @IconLink("/models", Icons.Material.Filled.Cloud, "GitHub Copilot Models")
        }
        @IconLink("/internal-agents", Icons.Material.Filled.Psychology, "Internal agents")
        @IconLink("/internal-models", Icons.Material.Filled.Memory, "Internal models")

        @if (HasRepository)
        {
            <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

            @IconLink("/actions", Icons.Material.Filled.PlayCircle, "Actions", requiresGitHub: true)
            @IconLink("/copilot-code-review", Icons.Material.Filled.RateReview, "Code review", requiresGitHub: true)
        }

        <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

        @if (HasRepository)
        {
            @IconLink("/background-tasks", Icons.Material.Filled.PendingActions, "Background tasks")
        }
        @IconLink("/sync-log", Icons.Material.Filled.ManageHistory, "Sync log")

        <MudDivider Vertical="true" FlexItem="true" Class="app-navigation-divider" />

        @* The corner badge marks the link as external: it opens the repository on GitHub in a new tab. *@
        <MudTooltip Text="@ExternalLinkLabel">
            <span class="external-link">
                <MudIconButton Href="@ProjectRepositoryUrl" Target="_blank" rel="noopener noreferrer" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit"
                               Class="header-link" aria-label="@ExternalLinkLabel" />
                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="external-link-badge" aria-hidden="true" />
            </span>
        </MudTooltip>
    </nav>
}

@code {
    /// <summary>The GitHub repository of this project itself, linked last in the navigation.</summary>
    private const string ProjectRepositoryUrl = "https://github.com/Djohnnie/DjohnnieGitHubSoftwareFactory";

    private const string ExternalLinkLabel = "GitHub repository (opens in a new tab)";

    /// <summary>Whether a repository is selected; without one, only the repository-independent pages are linked.</summary>
    [Parameter] public bool HasRepository { get; set; }

    /// <summary>Renders the links as a vertical list (navigation panel) instead of a horizontal bar.</summary>
    [Parameter] public bool Vertical { get; set; }

    /// <summary>
    /// Whether the selected repository is still on GitHub; when it was removed, the pages that only work with GitHub are
    /// shown disabled.
    /// </summary>
    [Parameter] public bool GitHubAvailable { get; set; } = true;

    private RenderFragment IconLink(string href, string icon, string label, bool requiresGitHub = false)
    {
        if (requiresGitHub && !GitHubAvailable)
        {
            var text = GitHubTitle(label);
            // A disabled button ignores the mouse, so a wrapper carries the tooltip.
            return @<MudTooltip Text="@text">
                <span class="app-navigation-disabled">
                    <MudIconButton Disabled="true" Icon="@icon" Color="Color.Inherit" Class="header-link" aria-label="@text" />
                </span>
            </MudTooltip>;
        }
        return @<MudTooltip Text="@label">
            <MudIconButton Href="@href" Icon="@icon" Color="Color.Inherit" Class="header-link" aria-label="@label" />
        </MudTooltip>;
    }

    /// <summary>The link of a page that only works with GitHub, or none when the repository was removed from GitHub.</summary>
    private string? GitHubHref(string href)
    {
        return GitHubAvailable ? href : null;
    }

    private string? GitHubTitle(string label)
    {
        return GitHubAvailable ? null : $"{label} needs GitHub, but this repository was removed from GitHub";
    }
}
