@* The main navigation links: a horizontal bar of icons with tooltips below the app bar on desktop, a vertical list in the navigation panel on mobile.
   Template pages aren't linked here: each list page links its own templates. *@

@if (Vertical)
{
    <nav class="app-navigation app-navigation-vertical" aria-label="Main navigation">
        @if (HasRepository)
        {
            <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Dashboard">Overview</MudButton>
            <MudButton Href="/mindmaps" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Hub">Mindmaps</MudButton>
            <MudButton Href="/work-item-map" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.BubbleChart">Work item map</MudButton>
            <MudButton Href="/actions" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.PlayCircle">Actions</MudButton>
            <MudButton Href="/copilot-instructions" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                       StartIcon="@Icons.Material.Filled.IntegrationInstructions">Instructions</MudButton>
            <MudButton Href="/skills" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.AutoFixHigh">Skills</MudButton>
            <MudButton Href="/agents" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.SmartToy">Agents</MudButton>

            <MudDivider Class="my-1" />

            @foreach (var type in WorkItemTypeRules.All)
            {
                <MudButton Href="@WorkItemRoutes.ListPath(type)" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                           StartIcon="@WorkItemRoutes.Icon(type)">@type.PluralName</MudButton>
            }

            <MudDivider Class="my-1" />

            <MudButton Href="/copilot-code-review" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.RateReview">Code review</MudButton>
            <MudButton Href="/models" Variant="Variant.Text" Color="Color.Inherit" Class="header-link" StartIcon="@Icons.Material.Filled.Memory">Models</MudButton>
        }
        <MudButton Href="/internal-agents" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Material.Filled.Psychology">Internal agents</MudButton>
        <MudButton Href="/internal-models" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Material.Filled.Memory">Internal models</MudButton>
        <MudButton Href="/sync-log" Variant="Variant.Text" Color="Color.Inherit" Class="header-link"
                   StartIcon="@Icons.Material.Filled.ManageHistory">Sync log</MudButton>
    </nav>
}
else
{
    <nav class="app-navigation app-navigation-horizontal" aria-label="Main navigation">
        @if (HasRepository)
        {
            @IconLink("/", Icons.Material.Filled.Dashboard, "Overview")
            @IconLink("/mindmaps", Icons.Material.Filled.Hub, "Mindmaps")
            @IconLink("/work-item-map", Icons.Material.Filled.BubbleChart, "Work item map")
            @IconLink("/actions", Icons.Material.Filled.PlayCircle, "Actions")
            @IconLink("/copilot-instructions", Icons.Material.Filled.IntegrationInstructions, "Instructions")
            @IconLink("/skills", Icons.Material.Filled.AutoFixHigh, "Skills")
            @IconLink("/agents", Icons.Material.Filled.SmartToy, "Agents")
            @foreach (var type in WorkItemTypeRules.All)
            {
                @IconLink(WorkItemRoutes.ListPath(type), WorkItemRoutes.Icon(type), type.PluralName)
            }
            @IconLink("/copilot-code-review", Icons.Material.Filled.RateReview, "Code review")
            @IconLink("/models", Icons.Material.Filled.Memory, "Models")
        }
        @IconLink("/internal-agents", Icons.Material.Filled.Psychology, "Internal agents")
        @IconLink("/internal-models", Icons.Material.Filled.Memory, "Internal models")
        @IconLink("/sync-log", Icons.Material.Filled.ManageHistory, "Sync log")
    </nav>
}

@code {
    /// <summary>Whether a repository is selected; without one, only the repository-independent pages are linked.</summary>
    [Parameter] public bool HasRepository { get; set; }

    /// <summary>Renders the links as a vertical list (navigation panel) instead of a horizontal bar.</summary>
    [Parameter] public bool Vertical { get; set; }

    private RenderFragment IconLink(string href, string icon, string label)
    {
        return @<MudTooltip Text="@label">
            <MudIconButton Href="@href" Icon="@icon" Color="Color.Inherit" Class="header-link" aria-label="@label" />
        </MudTooltip>;
    }
}
