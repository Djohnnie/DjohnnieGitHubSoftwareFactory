@inherits LayoutComponentBase
@implements IDisposable
@inject RepositoryContext Repository
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <div class="app-header">
        <MudAppBar Elevation="0" Dense="false" Fixed="false">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="header-link mobile-only mr-1"
                           aria-label="Open navigation" aria-expanded="@(_navigationOpen ? "true" : "false")" OnClick="ToggleNavigation" />
            <a href="/" class="brand">
                <img src="logo.svg" alt="" width="28" height="28" />
                <span>DGHSF</span>
            </a>

            @if (Repository.Current is { } repo)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3 appbar-divider desktop-only" />
                <div class="current-repo">
                    <MudAvatar Size="Size.Small"><MudImage Src="@repo.Owner.AvatarUrl" Alt="" /></MudAvatar>
                    <div class="current-repo-text">
                        <span class="current-repo-owner">@repo.Owner.Login /</span>
                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener" class="current-repo-name" title="Open on GitHub">@repo.Name</a>
                    </div>
                    <MudIcon Icon="@(repo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)" Size="Size.Small" Class="ml-1 appbar-muted desktop-only" />
                    <MudTooltip Text="Switch repository" RootClass="desktop-only">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link ml-3"
                                   StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="SwitchRepositoryAsync">Switch</MudButton>
                    </MudTooltip>
                </div>
            }
            else if (_loaded && IsRepositoryIndependent)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3 appbar-divider desktop-only" />
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link desktop-only"
                           StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="SwitchRepositoryAsync">Select repository</MudButton>
            }

            <MudSpacer />

            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="logout desktop-only">
                        <AntiforgeryToken />
                        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                        <a href="@($"https://github.com/{Uri.EscapeDataString(context.User.Identity?.Name ?? string.Empty)}")"
                           target="_blank" rel="noopener" class="current-user-name" title="Open GitHub profile">@context.User.Identity?.Name</a>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" Class="header-link"
                                   StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                    </form>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>

        @if (ShowNavigation)
        {
            <div class="desktop-only">
                <AppNavigation HasRepository="@(Repository.Current is not null)" />
            </div>
        }
    </div>

    @* Mobile: the navigation, repository switch and sign out move into a panel behind the hamburger button. *@
    <MudDrawer @bind-Open="_navigationOpen" Variant="DrawerVariant.Temporary" Anchor="Anchor.Start" Elevation="2" Class="app-drawer">
        <div class="app-drawer-content">
            <div class="app-drawer-header">
                <a href="/" class="brand">
                    <img src="logo.svg" alt="" width="28" height="28" />
                    <span>DGHSF</span>
                </a>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Class="header-link"
                               aria-label="Close navigation" OnClick="CloseNavigation" />
            </div>

            @if (Repository.Current is { } drawerRepo)
            {
                <div class="app-drawer-section app-drawer-repo">
                    <MudAvatar Size="Size.Small"><MudImage Src="@drawerRepo.Owner.AvatarUrl" Alt="" /></MudAvatar>
                    <div class="app-drawer-repo-text">
                        <span class="current-repo-owner">@drawerRepo.Owner.Login /</span>
                        <a href="@drawerRepo.HtmlUrl" target="_blank" rel="noopener" class="current-repo-name" title="Open on GitHub">@drawerRepo.Name</a>
                    </div>
                    <MudIcon Icon="@(drawerRepo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)" Size="Size.Small" Class="appbar-muted" />
                </div>
                <div class="app-drawer-section">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link"
                               StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="SwitchRepositoryAsync">Switch repository</MudButton>
                </div>
            }
            else if (_loaded)
            {
                <div class="app-drawer-section">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link"
                               StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="SwitchRepositoryAsync">Select repository</MudButton>
                </div>
            }

            @if (ShowNavigation)
            {
                <AppNavigation HasRepository="@(Repository.Current is not null)" Vertical="true" />
            }

            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="app-drawer-section app-drawer-user">
                        <AntiforgeryToken />
                        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                        <a href="@($"https://github.com/{Uri.EscapeDataString(context.User.Identity?.Name ?? string.Empty)}")"
                           target="_blank" rel="noopener" class="current-user-name" title="Open GitHub profile">@context.User.Identity?.Name</a>
                        <MudSpacer />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" Class="header-link"
                                   StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </MudDrawer>

    <MudMainContent Class="pt-0">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @if (!_loaded)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (Repository.Current is null && !IsRepositoryIndependent)
            {
                <MudText Typo="Typo.h4" GutterBottom="true">Select a repository</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                    Everything in DGHSF works on one repository at a time. Pick the one you want to work on; you can switch at any time from the top bar.
                    Templates don't need a repository: manage <MudLink Href="/agent-templates">agent templates</MudLink>
                    or the templates of <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Epic)">epics</MudLink>,
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Feature)">features</MudLink>,
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Story)">user stories</MudLink>,
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Bug)">bugs</MudLink> and
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Task)">tasks</MudLink>.
                </MudText>
                <MudPaper Outlined="true" Elevation="0">
                    <RepositoryPicker OnSelected="SelectAsync" />
                </MudPaper>
            }
            else
            {
                @* Keyed on the repository, so pages are recreated (and reload their data) after a switch. *@
                <div @key="@(IsRepositoryIndependent ? string.Empty : Repository.Current!.FullName)">
                    @Body
                </div>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private RouteData? RouteData { get; set; }

    private bool _loaded;
    private bool _navigationOpen;

    private bool IsRepositoryIndependent =>
        RouteData?.PageType.IsDefined(typeof(RepositoryIndependentAttribute), inherit: false) == true;

    private bool ShowNavigation
    {
        get
        {
            return Repository.Current is not null || (_loaded && IsRepositoryIndependent);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Repository.Changed += OnRepositoryChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Repository.LoadAsync();
        _loaded = true;

        // Show the restored repository right away, then bring it up to date with GitHub.
        StateHasChanged();
        await Repository.RefreshAsync();
    }

    private void ToggleNavigation()
    {
        _navigationOpen = !_navigationOpen;
    }

    private void CloseNavigation()
    {
        _navigationOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Picking a link in the navigation panel closes it.
        if (_navigationOpen)
        {
            _navigationOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task SwitchRepositoryAsync()
    {
        _navigationOpen = false;
        var parameters = new DialogParameters<RepositoryPickerDialog>
        {
            { d => d.SelectedFullName, Repository.Current?.FullName }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };

        var dialog = await Dialogs.ShowAsync<RepositoryPickerDialog>("Switch repository", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: GitHubRepository repository })
        {
            await SelectAsync(repository);
        }
    }

    private async Task SelectAsync(GitHubRepository repository)
    {
        var changed = Repository.Current is not null && repository.FullName != Repository.Current.FullName;
        try
        {
            await Repository.SelectAsync(repository);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not select repository: {ex.Message}", Severity.Error);
            return;
        }

        // Deep pages (like a specific agent) belong to the previous repository; a new agent can move along.
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        if (changed && path.StartsWith("/agents/", StringComparison.OrdinalIgnoreCase)
            && !path.Equals("/agents/new", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/agents");
        }
        else if (changed && WorkItemRoutes.IsItemPage(path) && WorkItemRoutes.TypeOf(path) is { } type)
        {
            Navigation.NavigateTo(WorkItemRoutes.ListPath(type));
        }
    }

    private void OnRepositoryChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Repository.Changed -= OnRepositoryChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}