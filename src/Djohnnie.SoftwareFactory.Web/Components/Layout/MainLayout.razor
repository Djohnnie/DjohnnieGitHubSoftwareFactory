@inherits LayoutComponentBase
@implements IDisposable
@inject RepositoryContext Repository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using Djohnnie.SoftwareFactory.Contracts.Repositories

<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <div class="app-header">
        <MudAppBar Elevation="0" Dense="false" Fixed="false">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="header-link mobile-only mr-1"
                           aria-label="Open navigation" aria-expanded="@(_navigationOpen ? "true" : "false")" OnClick="ToggleNavigation" />
            <a href="/" class="brand">
                <img src="logo.svg" alt="" width="28" height="28" />
                <span>DGHSF</span>
            </a>

            @if (Repository.Current is { } repo)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3 appbar-divider desktop-only" />
                <div class="current-repo">
                    @RepositoryAvatar(repo)
                    <div class="current-repo-text">
                        <span class="current-repo-owner">@repo.Owner.Login /</span>
                        @RepositoryName(repo)
                    </div>
                    @if (Repository.IsRemovedFromGitHub)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Inventory2"
                                 Class="ml-2 desktop-only">Removed from GitHub</MudChip>
                    }
                    else
                    {
                        <MudIcon Icon="@(repo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)" Size="Size.Small" Class="ml-1 appbar-muted desktop-only" />
                    }
                    <MudTooltip Text="Switch repository" RootClass="desktop-only">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link ml-3"
                                   StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="OpenRepositoryPicker">Switch</MudButton>
                    </MudTooltip>
                </div>
            }
            else if (_loaded && IsRepositoryIndependent)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3 appbar-divider desktop-only" />
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link desktop-only"
                           StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenRepositoryPicker">Select repository</MudButton>
            }

            <MudSpacer />

            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="logout desktop-only">
                        <AntiforgeryToken />
                        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                        <a href="@($"https://github.com/{Uri.EscapeDataString(context.User.Identity?.Name ?? string.Empty)}")"
                           target="_blank" rel="noopener" class="current-user-name" title="Open GitHub profile">@context.User.Identity?.Name</a>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" Class="header-link"
                                   StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                    </form>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>

        @if (ShowNavigation)
        {
            <div class="desktop-only">
                <AppNavigation HasRepository="@(Repository.Current is not null)" GitHubAvailable="@(!Repository.IsRemovedFromGitHub)" />
            </div>
        }
    </div>

    @* Mobile: the navigation, repository switch and sign out move into a panel behind the hamburger button. *@
    <MudDrawer @bind-Open="_navigationOpen" Variant="DrawerVariant.Temporary" Anchor="Anchor.Start" Elevation="2" Class="app-drawer">
        <div class="app-drawer-content">
            <div class="app-drawer-header">
                <a href="/" class="brand">
                    <img src="logo.svg" alt="" width="28" height="28" />
                    <span>DGHSF</span>
                </a>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Class="header-link"
                               aria-label="Close navigation" OnClick="CloseNavigation" />
            </div>

            @if (Repository.Current is { } drawerRepo)
            {
                <div class="app-drawer-section app-drawer-repo">
                    @RepositoryAvatar(drawerRepo)
                    <div class="app-drawer-repo-text">
                        <span class="current-repo-owner">@drawerRepo.Owner.Login /</span>
                        @RepositoryName(drawerRepo)
                    </div>
                    @if (Repository.IsRemovedFromGitHub)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Warning" title="Removed from GitHub" />
                    }
                    else
                    {
                        <MudIcon Icon="@(drawerRepo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)" Size="Size.Small" Class="appbar-muted" />
                    }
                </div>
                <div class="app-drawer-section">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link"
                               StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="OpenRepositoryPicker">Switch repository</MudButton>
                </div>
            }
            else if (_loaded)
            {
                <div class="app-drawer-section">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" Class="header-link"
                               StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenRepositoryPicker">Select repository</MudButton>
                </div>
            }

            @if (ShowNavigation)
            {
                <AppNavigation HasRepository="@(Repository.Current is not null)" GitHubAvailable="@(!Repository.IsRemovedFromGitHub)" Vertical="true" />
            }

            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="app-drawer-section app-drawer-user">
                        <AntiforgeryToken />
                        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                        <a href="@($"https://github.com/{Uri.EscapeDataString(context.User.Identity?.Name ?? string.Empty)}")"
                           target="_blank" rel="noopener" class="current-user-name" title="Open GitHub profile">@context.User.Identity?.Name</a>
                        <MudSpacer />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" Class="header-link"
                                   StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </MudDrawer>

    <MudMainContent Class="pt-0">
        <MudContainer MaxWidth="MaxWidth.False" Class="py-6 app-container">
            @if (!_loaded)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else
            {
                if (ShowRepositoryPicker)
                {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h4">Select a repository</MudText>
                    @if (CanRenderPage)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="CloseRepositoryPicker">Cancel</MudButton>
                    }
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                    Everything in DGHSF works on one repository at a time. Pick the one you want to work on; you can switch at any time from the top bar.
                    Templates don't need a repository: manage <MudLink Href="/agent-templates">agent templates</MudLink>
                    or the templates of <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Epic)">epics</MudLink>,
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Feature)">features</MudLink>,
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Story)">user stories</MudLink>,
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Bug)">bugs</MudLink> and
                    <MudLink Href="@WorkItemRoutes.TemplatesPath(WorkItemType.Task)">tasks</MudLink>.
                </MudText>
                <MudPaper Outlined="true" Elevation="0">
                    <RepositoryPicker SelectedFullName="@Repository.Current?.FullName" OnSelected="SelectAsync" OnArchivedSelected="SelectArchivedAsync" />
                </MudPaper>
                }

                if (CanRenderPage)
                {
                @* Keyed on the repository, so pages are recreated (and reload their data) after a switch.
                   Only hidden behind the picker, so cancelling a switch keeps the page and its unsaved input. *@
                <div @key="@(IsRepositoryIndependent ? string.Empty : Repository.Current!.FullName)" hidden="@ShowRepositoryPicker">
                    @if (IsBlockedWithoutGitHub)
                    {
                        <RemovedFromGitHubNotice RequiresGitHub="true" />
                    }
                    else
                    {
                        @if (!IsRepositoryIndependent)
                        {
                            <RemovedFromGitHubNotice Class="mb-4" />
                        }
                        @Body
                    }
                </div>
                }
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private RouteData? RouteData { get; set; }

    private bool _loaded;
    private bool _navigationOpen;
    private bool _choosingRepository;

    private bool IsRepositoryIndependent =>
        RouteData?.PageType.IsDefined(typeof(RepositoryIndependentAttribute), inherit: false) == true;

    private bool RequiresGitHub
    {
        get
        {
            return RouteData?.PageType.IsDefined(typeof(RequiresGitHubAttribute), inherit: false) == true;
        }
    }

    /// <summary>The page only works with GitHub, but the current repository was removed from it.</summary>
    private bool IsBlockedWithoutGitHub
    {
        get
        {
            return RequiresGitHub && Repository.IsRemovedFromGitHub;
        }
    }

    private bool CanRenderPage
    {
        get
        {
            return Repository.Current is not null || IsRepositoryIndependent;
        }
    }

    private bool ShowRepositoryPicker
    {
        get
        {
            return _choosingRepository || !CanRenderPage;
        }
    }

    private bool ShowNavigation
    {
        get
        {
            return Repository.Current is not null || (_loaded && IsRepositoryIndependent);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Repository.Changed += OnRepositoryChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Repository.LoadAsync();
        _loaded = true;

        // Show the restored repository right away, then bring it up to date with GitHub.
        StateHasChanged();
        await Repository.RefreshAsync();
    }

    private void ToggleNavigation()
    {
        _navigationOpen = !_navigationOpen;
    }

    private void CloseNavigation()
    {
        _navigationOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Picking a link closes the navigation panel and leaves the repository picker.
        if (_navigationOpen || _choosingRepository)
        {
            _navigationOpen = false;
            _choosingRepository = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OpenRepositoryPicker()
    {
        _navigationOpen = false;
        _choosingRepository = true;
    }

    private void CloseRepositoryPicker()
    {
        _choosingRepository = false;
    }

    private Task SelectAsync(GitHubRepository repository)
    {
        return SelectAsync(repository.FullName, () => Repository.SelectAsync(repository));
    }

    /// <summary>Opens a repository removed from GitHub, to view what DGHSF stored about it.</summary>
    private Task SelectArchivedAsync(RepositorySummary repository)
    {
        return SelectAsync(repository.FullName, () => Repository.SelectArchivedAsync(repository));
    }

    private async Task SelectAsync(string fullName, Func<Task> select)
    {
        var changed = Repository.Current is not null && !string.Equals(fullName, Repository.Current.FullName, StringComparison.OrdinalIgnoreCase);
        try
        {
            await select();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not select repository: {ex.Message}", Severity.Error);
            return;
        }

        _choosingRepository = false;

        // Deep pages (like a specific agent) belong to the previous repository; a new agent can move along.
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        if (changed && path.StartsWith("/agents/", StringComparison.OrdinalIgnoreCase)
            && !path.Equals("/agents/new", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/agents");
        }
        else if (changed && WorkItemRoutes.IsItemPage(path) && WorkItemRoutes.TypeOf(path) is { } type)
        {
            Navigation.NavigateTo(WorkItemRoutes.ListPath(type));
        }
    }

    /// <summary>The owner's avatar; an archive icon for a repository removed from GitHub, which has no avatar to link to.</summary>
    private RenderFragment RepositoryAvatar(GitHubRepository repository)
    {
        return @<MudAvatar Size="Size.Small">
            @if (Repository.IsRemovedFromGitHub || repository.Owner.AvatarUrl is null)
            {
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
            }
            else
            {
                <MudImage Src="@repository.Owner.AvatarUrl" Alt="" />
            }
        </MudAvatar>;
    }

    /// <summary>The repository name, linked to GitHub unless it was removed from there.</summary>
    private RenderFragment RepositoryName(GitHubRepository repository)
    {
        if (Repository.IsRemovedFromGitHub || string.IsNullOrEmpty(repository.HtmlUrl))
        {
            return @<span class="current-repo-name" title="Removed from GitHub">@repository.Name</span>;
        }
        return @<a href="@repository.HtmlUrl" target="_blank" rel="noopener" class="current-repo-name" title="Open on GitHub">@repository.Name</a>;
    }

    private void OnRepositoryChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Repository.Changed -= OnRepositoryChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}