@page "/internal-agents/{Key}"
@attribute [RepositoryIndependent]
@inject InternalAgentService Agents
@inject AssistantService Assistant
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(_agent?.Name ?? "Internal agent")</PageTitle>

<PageBreadcrumbs Parents="@([new("Internal agents", "/internal-agents")])" Current="@(_agent?.Name ?? Key)" BackDisabled="_saving" />

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_agent is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4">@_agent.Name</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(_agent.Kind == InternalAgentKind.Copilot ? "Copilot" : "Background agent")</MudChip>
        @if (_agent.IsCustomized)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Customized</MudChip>
        }
    </MudStack>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @_agent.Description Used: @InternalAgents.UsedOn(_agent).
    </MudText>

    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!CanSave)"
                   StartIcon="@Icons.Material.Filled.Save">Save</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ResetToStoredAsync" Disabled="_saving || _testing"
                   StartIcon="@Icons.Material.Filled.Undo" title="Discard your changes and load the saved version">Reset</MudButton>
    </MudStack>
    @if (_saving)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudText Typo="Typo.h6">System prompt</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@PromptHelp</MudText>
                @* Raw Markdown: the WYSIWYG round trip would reformat the prompt and make it differ from the default. *@
                <MarkdownEditor @bind-Value="_agent.Instructions" RawMarkdown="true" Height="640px" MaxLength="InternalAgent.MaxInstructionsLength" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudStack Spacing="4" Class="sticky-side">
                @if (_agent.Kind == InternalAgentKind.Copilot)
                {
                    <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                        <MudText Typo="Typo.h6">Model</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            The model or deployment name this Copilot uses on the configured endpoint. A new or changed model must pass the test before you can save.
                        </MudText>
                        <MudTextField T="string" @bind-Value="_agent.Model" Variant="Variant.Outlined" Label="Model" Required="true"
                                      MaxLength="InternalAgent.MaxModelLength" Immediate="true" Disabled="_saving || _testing" />
                        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="TestModelAsync" StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Disabled="@(_saving || _testing || CurrentModel.Length == 0 || !Assistant.IsConfigured)">Test</MudButton>
                        </MudStack>
                        @if (_testing)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                        }
                        else if (ModelPassedTest)
                        {
                            <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Dense="true" Class="mt-2">The model responded.</MudAlert>
                        }
                        else if (ModelFailedTest)
                        {
                            <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Dense="true" Class="mt-2">@_testError</MudAlert>
                        }
                        @if (!Assistant.IsConfigured)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                                Models can't be tested until <code>OpenAI:Model</code> and <code>OpenAI:ApiKey</code> are configured.
                            </MudText>
                        }
                    </MudPaper>
                }
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudText Typo="Typo.h6">Status</MudText>
                    <MudSwitch T="bool" @bind-Value="_agent.IsEnabled" Color="Color.Primary" Disabled="_saving"
                               Label="@(_agent.IsEnabled ? "Enabled" : "Disabled")" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@EnabledHelp</MudText>
                    @if (_agent.Id != 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                            Updated @_agent.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    }
                </MudPaper>
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudText Typo="Typo.h6">Default prompt</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        @(_agent.IsCustomized ? "The prompt differs from DGHSF's default." : "The prompt is DGHSF's default.")
                    </MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="() => _showDefault = !_showDefault">@(_showDefault ? "Hide default" : "Show default")</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                                   OnClick="ResetAsync" Disabled="_saving || !_stored.IsCustomized">Reset to default</MudButton>
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
        @if (_showDefault)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0" aria-label="Default prompt">
                    <MudText Typo="Typo.h6" GutterBottom="true">Default system prompt</MudText>
                    <pre class="preview">@_agent.DefaultInstructions</pre>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    private InternalAgent? _agent;
    private InternalAgent _stored = new();
    private bool _loading = true;
    private bool _saving;
    private bool _testing;
    private bool _showDefault;
    private string? _testedModel;
    private string? _testError;
    private string? _error;
    private string? _loadedKey;

    private string CurrentModel => _agent?.Model?.Trim() ?? string.Empty;
    private bool ModelPassedTest => _testedModel == CurrentModel && _testError is null;
    private bool ModelFailedTest => _testedModel == CurrentModel && _testError is not null;
    private bool ModelIsVerified => CurrentModel.Length > 0 && (CurrentModel == _stored.Model || ModelPassedTest);
    private bool CanSave => !_saving && !_testing && (_agent!.Kind != InternalAgentKind.Copilot || ModelIsVerified);

    private string PromptHelp => _agent!.Kind == InternalAgentKind.Copilot
        ? "Markdown instructions for the chat. Keep the tool names (in backticks) as they are: the Copilot uses those tools to read and fill in the form."
        : "Instructions for the agent. It receives its input from DGHSF as JSON; DGHSF enforces the output format, so the prompt only needs to describe how to decide.";

    private string EnabledHelp => _agent!.Kind == InternalAgentKind.Copilot
        ? "A disabled Copilot is hidden from its page."
        : _agent.Key switch
        {
            InternalAgentKeys.ModelSelector => "When disabled, the assignment settings show no model suggestion.",
            InternalAgentKeys.DescriptionWriter => "When disabled, a dictated description is added as it was recognized, at the end of the description.",
            _ => "When disabled, Copilot chats show their built-in example suggestions."
        };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedKey == Key)
        {
            return;
        }
        _loadedKey = Key;
        _loading = true;
        _error = null;
        _agent = null;
        try
        {
            _stored = await Agents.GetAsync(Key);
            _agent = Editable(_stored);
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException)
        {
            _error = "This internal agent does not exist.";
        }
        catch (Exception ex)
        {
            _error = $"Could not load the internal agent: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>An editable copy; a Copilot without a model starts from the configured model.</summary>
    private InternalAgent Editable(InternalAgent stored)
    {
        var agent = stored.Copy();
        if (agent.Kind == InternalAgentKind.Copilot && string.IsNullOrWhiteSpace(agent.Model))
        {
            agent.Model = Assistant.DefaultModel ?? string.Empty;
        }
        return agent;
    }

    private async Task TestModelAsync()
    {
        var model = CurrentModel;
        _testing = true;
        _testedModel = null;
        _testError = null;
        try
        {
            var result = await Agents.TestModelAsync(model);
            _testedModel = model;
            _testError = result.Error;
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException)
        {
            _testedModel = model;
            _testError = ex.Message;
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_agent!.Instructions))
        {
            Snackbar.Add("The system prompt is required.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _stored = await Agents.SaveAsync(_agent);
            _agent = Editable(_stored);
            Snackbar.Add($"Saved {_agent.Name}. New conversations use the updated settings.", Severity.Success);
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException or Djohnnie.SoftwareFactory.Contracts.PersistenceException)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Loads the stored agent again and discards unsaved changes.</summary>
    private async Task ResetToStoredAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Reset changes",
                $"Discard your changes to {_agent!.Name} and load the saved version again?",
                yesText: "Reset", cancelText: "Cancel") != true)
        {
            return;
        }

        _saving = true;
        try
        {
            _stored = await Agents.GetAsync(_agent.Key);
            _agent = Editable(_stored);
            _testedModel = null;
            _testError = null;
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException or Djohnnie.SoftwareFactory.Contracts.PersistenceException)
        {
            Snackbar.Add($"Could not reset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Reset to default",
                $"Replace the system prompt of {_agent!.Name} with DGHSF's default? Your customized prompt is lost.",
                yesText: "Reset", cancelText: "Cancel") != true)
        {
            return;
        }

        _saving = true;
        try
        {
            _stored = await Agents.ResetAsync(_agent.Key);
            _agent = Editable(_stored);
            Snackbar.Add($"{_agent.Name} uses the default prompt again.", Severity.Success);
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException or Djohnnie.SoftwareFactory.Contracts.PersistenceException)
        {
            Snackbar.Add($"Could not reset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
