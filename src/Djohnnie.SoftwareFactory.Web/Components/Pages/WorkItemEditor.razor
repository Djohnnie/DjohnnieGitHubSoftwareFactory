@page "/epics/new"
@page "/epics/{Id:guid}"
@page "/features/new"
@page "/features/{Id:guid}"
@page "/stories/new"
@page "/stories/{Id:guid}"
@page "/bugs/new"
@page "/bugs/{Id:guid}"
@page "/tasks/new"
@page "/tasks/{Id:guid}"
@implements IDisposable
@using Djohnnie.SoftwareFactory.Application.Features.AgentRuns
@using Djohnnie.SoftwareFactory.Contracts.AgentRuns
@inject WorkItemService WorkItemService
@inject WorkItemTemplateService Templates
@inject AiModelService ModelService
@inject GitHubService GitHub
@inject AssistantService Assistant
@inject InternalAgentService InternalAgents
@inject MindmapService Mindmaps
@inject KnowledgeBaseService Knowledge
@inject RepositoryContext Repository
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<WorkItemEditor> Logger
@inject AgentRunService AgentRunService

<PageTitle>@Heading</PageTitle>

<PageBreadcrumbs Parents="BreadcrumbParents" Current="@BreadcrumbCurrent" BackHref="@BackPath" BackDisabled="_busy" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">@Heading</MudText>
    <WorkItemTypeChip Type="_type" />
    @if (!_loading && _item is not null)
    {
        @* Follows _item, which every action on the page replaces with the stored item. *@
        <WorkItemStatusChip Status="_item.Status" Executor="_item.Executor" />
        @if (_item.Progress == CopilotProgress.CopilotReviewing)
        {
            <MudTooltip Text="@CopilotProgressChip.DescriptionOf(_item.Progress)">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CopilotProgressChip.ColorOf(_item.Progress)"
                         Icon="@CopilotProgressChip.IconOf(_item.Progress, _item.Executor)" Class="heading-copilot-reviewing">@CopilotProgressChip.LabelOf(_item.Progress, _item.Executor)</MudChip>
            </MudTooltip>
        }
        @if (_item.PullRequestHasConflicts)
        {
            <MudTooltip Text="@CopilotProgressChip.ConflictsDescription">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Icon="@CopilotProgressChip.ConflictsIcon"
                         Class="heading-merge-conflicts">@CopilotProgressChip.ConflictsLabel</MudChip>
            </MudTooltip>
        }
    }
    @foreach (var link in _linkedIdeas)
    {
        @* The mindmap ideas this item is linked to; each opens the map with the idea selected. *@
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@(link.IsDone ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.BubbleChart)"
                 Href="@MindmapRoutes.MapPath(link.MindmapId, link.IdeaId)" Class="mindmap-idea-chip"
                 title="@($"Linked to the idea '{link.IdeaText}' of the mindmap '{link.MindmapTitle}'{(link.IsDone ? ", done" : null)}")">
            @link.MindmapTitle › @link.IdeaText
        </MudChip>
    }
</MudStack>

@if (!_loading && _item?.PullRequestBranch is { } branch)
{
    @* The agent's branch, on its own line below the heading, to check the pull request out locally. *@
    <div class="mb-2">
        <span class="pr-branch">
            <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" />
            <GitHubLink Href="@BranchUrl(branch)" Class="pr-branch-name" Title="Open the branch on GitHub">@branch</GitHubLink>
            <MudTooltip Text="Copy branch name">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="pr-branch-copy" aria-label="Copy branch name"
                               OnClick="() => CopyBranchAsync(branch)" />
            </MudTooltip>
        </span>
    </div>
}

@if (!_loading && _item is not null)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        @if (_item.IsDraft || _item.CanEditAssignment)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Save">@(_item.IsDraft ? "Save draft" : "Save")</MudButton>
        }
        @if (_item.IsDraft)
        {
            var acceptBlocked = Removed ? GitHubLink.RemovedTitle : AcceptBlockedByParent;
            <MudTooltip Text="@(acceptBlocked ?? string.Empty)" Disabled="acceptBlocked is null">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AcceptAsync" Disabled="@(_busy || acceptBlocked is not null)"
                           StartIcon="@Icons.Material.Filled.RocketLaunch">@WorkItemActions.SaveAndAcceptText(_type)</MudButton>
            </MudTooltip>
        }
        else if (_item.Status == WorkItemStatus.Accepted && _type.CanBeAssigned)
        {
            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="AssignAsync" Disabled="@(_busy || Removed)"
                       title="@(Removed ? GitHubLink.RemovedTitle : null)" StartIcon="@Icons.Material.Filled.SmartToy">Assign agent</MudButton>
        }
        @if (_item.HasIssue)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RefreshAsync" Disabled="@(_busy || Removed)"
                       title="@(Removed ? GitHubLink.RemovedTitle : null)" StartIcon="@Icons.Material.Filled.Sync">@WorkItemActions.RefreshText</MudButton>
        }
        @if (!IsNew && (_item.IsDraft || _item.CanEditAssignment))
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ResetAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Undo">Reset</MudButton>
        }
        <MudSpacer />
        @if (!IsNew)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync"
                       Disabled="_busy">Delete @Name</MudButton>
        }
    </MudStack>
    @if (_busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
}

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_item is not null)
{
    RenderFragment workItemContent = @<MudForm @ref="_form" Model="_item">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudStack Spacing="4">
                    @if (IsNew)
                    {
                        <WorkItemMindmapOriginAlert Origin="_mindmapOrigin" Name="@Name" Busy="_busy" WriteAgain="WriteFromMindmapAsync" />
                    }
                    @if (IsNew && _templates.Count > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                            <MudSelect T="Guid" Value="_templateChoiceId" ValueChanged="ChangeTemplateAsync" Label="@($"{_type.DisplayName} template")"
                                       Variant="Variant.Outlined" Disabled="_busy"
                                       HelperText="The default template is proposed, or else the first alphabetically. Choose another or start blank.">
                                <MudSelectItem T="Guid" Value="Guid.Empty">No template</MudSelectItem>
                                @foreach (var template in _templates)
                                {
                                    <MudSelectItem T="Guid" Value="template.Id">@template.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudPaper>
                    }
                    @if (_item.IsDraft)
                    {
                        <AssistantChat @ref="_chat" @key="@($"{_type}:{Id}")" CopilotKey="@InternalAgentKeys.ForWorkItem(_type)" SuggestionRepository="@RepositoryName" Tools="_assistantTools"
                                       Owner="@(IsNew ? null : ChatOwner.ForWorkItem(RepositoryName, Id!.Value))"
                                       Placeholder="@ChatPlaceholder"
                                       Subtitle="@($"Describe the {Name}; I'll ask what I need to know and fill in the form.")"
                                       Suggestions="@(IsNew ? Suggestions : [])" />
                    }
                    else
                    {
                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true">
                            This @Name is accepted and lives on as GitHub issue #@_item.IssueNumber; its content is no longer edited here.
                        </MudAlert>
                    }
                    <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                        @* Dictating a title is like typing one and leaving the field: the chat suggestions follow it. *@
                        <DictationTextField @bind-Value="_item.Title" Label="Title" Required="true" Immediate="true" RequiredError="A title is required."
                                            MaxLength="256" ReadOnly="!_item.IsDraft" OnBlur="OnFieldBlur" OnDictated="OnFieldBlur"
                                            Placeholder="@SelectedTemplate?.TitleTemplate"
                                            HelperText="Becomes the title of the GitHub issue." />
                    </MudPaper>

                    <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                        @if (_item.IsDraft)
                        {
                            <MarkdownEditor Value="@_item.Description" ValueChanged="OnDescriptionChanged" OnBlur="OnFieldBlur" MaxLength="WorkItem.MaxDescriptionLength" AllowImages="true" AllowFileLinks="true"
                                            Placeholder="@($"Describe the {Name}...")"
                                            Dictation="@(new DescriptionDictation(Name, _item.Title, SelectedTemplate?.Description))">
                                <Header>
                                    <MudText Typo="Typo.h6">Description</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@DescriptionHelp</MudText>
                                </Header>
                            </MarkdownEditor>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">Description</MudText>
                            <MarkdownViewer Value="@_item.Description" />
                        }
                    </MudPaper>

                    @if (_item.IsDraft || !string.IsNullOrWhiteSpace(_item.TechnicalDetails))
                    {
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0" aria-label="Technical details">
                            @if (_item.IsDraft)
                            {
                                <MarkdownEditor @bind-Value="_item.TechnicalDetails" MaxLength="WorkItem.MaxTechnicalDetailsLength" AllowImages="true" AllowFileLinks="true" Height="300px"
                                                Placeholder="Files, APIs, patterns or constraints the agent should know about...">
                                    <Header>
                                        <MudText Typo="Typo.h6">Technical details</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                            Optional. Implementation notes for the agent that don't belong in the description. Accepting posts them as the first comment of the GitHub issue, before Copilot is assigned.
                                        </MudText>
                                    </Header>
                                </MarkdownEditor>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6">Technical details</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Posted as the first comment of the GitHub issue.</MudText>
                                <MarkdownViewer Value="@_item.TechnicalDetails" />
                            }
                        </MudPaper>
                    }

                    @if (!IsNew && _type.ChildTypes.Count > 0)
                    {
                        <WorkItemChildrenPanel Item="_item" Children="_children" GeneratorActive="_generatorActive" Busy="_busy" Generate="GenerateChildrenAsync" />
                    }
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudStack Spacing="4" Class="sticky-side">
                    <WorkItemStatusPanel Item="_item" IsWorker="IsWorker" />

                    @if (_type.ParentTypes.Count > 0)
                    {
                        <WorkItemParentPanel Item="_item" Parents="_parents" SelectedParent="SelectedParent" ParentChanged="OnParentChanged" />
                    }

                    @if (_type.CanBeAssigned)
                    {
                        <WorkItemAssignmentPanel Item="_item" ModelSuggestions="_modelSuggestions" DefaultBranch="@Repository.Current?.DefaultBranch" ExecutorChanged="OnExecutorChanged" />
                    }

                    @if (IsWorker && _item.HasIssue && !Removed)
                    {
                        <AgentRunsPanel @ref="_agentRuns" RepositoryFullName="@RepositoryName" WorkItemId="_item.Id"
                                        CanStart="@(_item.Status == WorkItemStatus.InProgress)" Changed="RefreshAsync" />
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudForm>;

    @* With a pull request or agent worker runs the page gets tabs; the pull request is loaded from GitHub in the background as soon
       as its tabs are shown (both tabs render because the panels stay alive), so their counts fill in by themselves. The panels stay alive, so unsaved changes in the form and pending line comments survive switching tabs. *@
    @if ((_item.PullRequestNumber is not null || _agentTasks.HasTasks) && !Removed)
    {
        var pullRequestNumber = _item.PullRequestNumber;
        @if (pullRequestNumber is not null && CanBeMerged)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Icon="@Icons.Material.Filled.MergeType" Class="mb-4 pr-mergeable">
                Pull request #@pullRequestNumber can be merged and closed. Go to the
                <MudLink OnClick="() => ShowPullRequestSection(PullRequestSection.Discussion)" Class="pr-mergeable-link">Discussion tab</MudLink>
                to merge it.
            </MudAlert>
        }
        @* Only the tab bar is outlined (no ApplyEffectsToContainer): the cards in the panels are outlined already. *@
        <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="ChangeTab" KeepPanelsAlive="true" Elevation="0" Outlined="true" Rounded="true">
            <MudTabPanel Text="@_type.DisplayName" Icon="@WorkItemRoutes.Icon(_type)">
                <div class="tab-panel">@workItemContent</div>
            </MudTabPanel>
            @if (_agentTasks.HasTasks)
            {
                <MudTabPanel Icon="@WorkItemRoutes.Icon(AgentExecutor.DghsfWorker)">
                    <TabContent>
                        Agent runs
                        <span class="tab-count" title="Runs">@_agentTasks.RunCount</span>
                    </TabContent>
                    <ChildContent><div class="tab-panel">
                        <WorkItemAgentTasksTab RepositoryFullName="@RepositoryName" Name="@Name" Tasks="_agentTasks.Tasks" Busy="_busy" Cancelled="RefreshAsync" />
                    </div></ChildContent>
                </MudTabPanel>
            }
            @if (pullRequestNumber is not null)
            {
            <MudTabPanel Icon="@Icons.Material.Filled.Difference">
                <TabContent>
                    Pull request #@pullRequestNumber
                    @if (_pullRequest.Changes is { } prChanges)
                    {
                        <span class="tab-count pr-files-count" title="Files changed">@(prChanges.Files.Count)@(prChanges.FilesTruncated ? "+" : "")</span>
                    }
                    @if (_pullRequest.Pending.Count > 0)
                    {
                        <span class="tab-count" title="Pending line comments">@_pullRequest.Pending.Count</span>
                    }
                </TabContent>
                <ChildContent><div class="tab-panel">
                    <WorkItemPullRequest RepositoryName="@RepositoryName" Item="_item" State="_pullRequest" Section="PullRequestSection.Changes"
                                         Active="@(_tab == ChangesTab)" OnNavigate="ShowPullRequestSection" />
                </div></ChildContent>
            </MudTabPanel>
            <MudTabPanel Icon="@Icons.Material.Filled.Forum">
                <TabContent>
                    Discussion
                    @if (_pullRequest.Changes is { Comments.Count: > 0 } changes)
                    {
                        <span class="tab-count" title="Comments">@changes.Comments.Count</span>
                    }
                </TabContent>
                <ChildContent><div class="tab-panel">
                    <WorkItemPullRequest RepositoryName="@RepositoryName" Item="_item" State="_pullRequest" Section="PullRequestSection.Discussion"
                                         Active="@(_tab == DiscussionTab)" OnNavigate="ShowPullRequestSection" OnMerged="RefreshAsync"
                                         OnAgentRunStarted="RefreshAsync" />
                </div></ChildContent>
            </MudTabPanel>
            }
        </MudTabs>
    }
    else
    {
        @workItemContent
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "template")] public Guid? TemplateId { get; set; }
    [SupplyParameterFromQuery(Name = "parent")] public Guid? ParentIdQuery { get; set; }

    /// <summary>With <see cref="IdeaId"/>: the mindmap idea a new item is written for (by the Mindmap Work Item Writer) and linked to on save.</summary>
    [SupplyParameterFromQuery(Name = "mindmap")] public Guid? MindmapId { get; set; }
    [SupplyParameterFromQuery(Name = "idea")] public Guid? IdeaId { get; set; }

    /// <summary>Changes on every navigation, so switching between the type pages (which share this component) reloads.</summary>
    [CascadingParameter] private RouteData? RouteData { get; set; }

    private const int AgentTasksTab = 1;

    /// <summary>The pull request's tabs come after the agent runs tab, when there is one.</summary>
    private int ChangesTab
    {
        get
        {
            return _agentTasks.HasTasks ? AgentTasksTab + 1 : AgentTasksTab;
        }
    }

    private int DiscussionTab
    {
        get
        {
            return ChangesTab + 1;
        }
    }

    private int _tab;
    private WorkItemPullRequestState _pullRequest = null!;

    private AssistantTools? _assistantTools;
    private AssistantChat? _chat;
    private (string Title, string Description) _suggestionsForm;
    private List<AgentSummary>? _customAgents;

    /// <summary>The Model Selector's suggestion under the model picker; see <see cref="WorkItemModelSuggestions"/>.</summary>
    private WorkItemModelSuggestions _modelSuggestions = null!;
    private bool _generatorActive;

    private WorkItemType _type;
    private MudForm? _form;
    private WorkItem? _item;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<WorkItemTemplate> _templates = [];
    private List<WorkItem> _parents = [];
    private List<WorkItem> _children = [];
    private Guid _selectedTemplateId;
    private Guid _templateChoiceId;
    private bool _initialized;
    private (WorkItemType Type, Guid? Id, Guid? TemplateId, Guid? ParentId, Guid? MindmapId, Guid? IdeaId) _loadedParameters;

    /// <summary>The mindmap idea a new item is created for; see <see cref="WorkItemMindmapOrigin"/>.</summary>
    private WorkItemMindmapOrigin _mindmapOrigin = null!;

    /// <summary>The DGHSF agent worker's tasks on the item, shown in the agent runs tab.</summary>
    private WorkItemAgentTasks _agentTasks = null!;
    private AgentRunsPanel? _agentRuns;

    // The mindmap ideas a stored item is linked to.
    private List<MindmapIdeaLink> _linkedIdeas = [];

    private bool IsNew => Id is null;
    private string Name => WorkItemActions.Name(_type);
    private string Heading => IsNew ? $"New {Name}" : _item?.Title ?? _type.DisplayName;
    private string ChatPlaceholder =>_type == WorkItemType.Bug ? "Describe what goes wrong" : "Describe what you want to build";
    private WorkItemTemplate? SelectedTemplate => _templates.FirstOrDefault(t => t.Id == _selectedTemplateId);
    private string RepositoryName => Repository.Current!.FullName;

    /// <summary>
    /// The repository was removed from GitHub: accepting, assigning, refreshing, the pull request and agent runs need GitHub,
    /// and its links would lead nowhere.
    /// </summary>
    private bool Removed
    {
        get
        {
            return Repository.IsRemovedFromGitHub;
        }
    }
    private string ParentNames => string.Join(" or ", _type.ParentTypes.Select(WorkItemActions.Name));

    /// <summary>The Runs on select changed: the agent runs panel and the status texts follow the agent (rendered by the callback).</summary>
    private void OnExecutorChanged(AgentExecutor executor)
    {
    }

    /// <summary>The chosen parent: from the candidates while editing, otherwise as stored.</summary>
    private WorkItemReference? SelectedParent
    {
        get
        {
            if (_item?.ParentId is not { } parentId)
            {
                return null;
            }
            return _parents.FirstOrDefault(p => p.Id == parentId) is { } candidate
                ? new WorkItemReference(candidate.Id, candidate.Type, candidate.Title, candidate.Status, candidate.IssueNumber, candidate.IssueUrl)
                : _item.Parent is { } stored && stored.Id == parentId ? stored : null;
        }
    }

    private string? AcceptBlockedByParent
    {
        get
        {
            return WorkItemActions.AcceptBlockedByParent(_type, SelectedParent);
        }
    }

    private string BackPath => IsNew && _mindmapOrigin.Mindmap is { } mindmap
        ? MindmapRoutes.MapPath(mindmap.Id)
        : _item?.Parent is { } parent && !IsNew
        ? WorkItemRoutes.ItemPath(parent.Type, parent.Id)
        : SelectedParent is { } selected ? WorkItemRoutes.ItemPath(selected.Type, selected.Id) : WorkItemRoutes.ListPath(_type);

    private IReadOnlyList<BreadcrumbItem> BreadcrumbParents
    {
        get
        {
            List<BreadcrumbItem> parents = [new(_type.PluralName, WorkItemRoutes.ListPath(_type))];
            if (_item?.Parent is { } parent)
            {
                parents.Add(new(parent.Title, WorkItemRoutes.ItemPath(parent.Type, parent.Id)));
            }
            return parents;
        }
    }

    private string BreadcrumbCurrent => _item is not null && _item.Id != Guid.Empty ? _item.Title : IsNew ? "New" : "…";

    private string DescriptionHelp => _type switch
    {
        WorkItemType.Epic => "The goal and scope of the epic. This becomes the issue body; the work itself is split into features.",
        WorkItemType.Feature => "What the feature enables and its acceptance criteria. This becomes the issue body; the work itself is split into user stories.",
        WorkItemType.Bug => "Steps to reproduce, expected and actual behavior. This becomes the issue body and is what the Copilot cloud agent works from.",
        _ => $"What needs to be done and why, with acceptance criteria. This becomes the issue body and is what the Copilot cloud agent works from."
    };

    private IReadOnlyList<string> Suggestions => _type switch
    {
        WorkItemType.Epic => ["Add passkey login next to the existing sign-in", "Add a dark mode that follows the system setting", "Export all data to CSV"],
        WorkItemType.Feature => ["Sign in with a passkey", "Switch between light and dark mode", "Download a CSV export of my data"],
        WorkItemType.Story => ["As a user I want to reset my password by email", "As an admin I want to see who signed in last", "As a visitor I want to filter products by price"],
        WorkItemType.Bug => ["The login page crashes when the password is empty", "Dates are shown in UTC instead of local time", "Saving twice creates duplicate records"],
        _ => ["Upgrade the project to the latest .NET version", "Add unit tests for the order service", "Set up a GitHub Actions build"]
    };

    protected override void OnInitialized()
    {
        _pullRequest = new WorkItemPullRequestState(WorkItemService);
        _pullRequest.Changed += OnPullRequestChanged;
        _modelSuggestions = new WorkItemModelSuggestions(WorkItemService, Logger, change => InvokeAsync(() =>
        {
            change();
            StateHasChanged();
        }));
        _agentTasks = new WorkItemAgentTasks(AgentRunService, Snackbar, reload => InvokeAsync(reload), OnAgentTasksReloadedAsync);
        _mindmapOrigin = new WorkItemMindmapOrigin(Mindmaps, Assistant, InternalAgents, Snackbar, StateHasChanged);
    }

    /// <summary>The tabs (and their badges) follow what either pull request tab changes.</summary>
    private void OnPullRequestChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ChangeTab(int index)
    {
        _tab = index;
    }

    /// <summary>
    /// The agent is done with the pull request and it is still open: from the stored progress, or from GitHub once a pull
    /// request tab loaded it.
    /// </summary>
    private bool CanBeMerged
    {
        get
        {
            // Like the merge button: not while the agent runs, a requested Copilot code review is still coming or the branch conflicts.
            if (_item is null || _item.Progress is CopilotProgress.Queued or CopilotProgress.Working or CopilotProgress.CopilotReviewing)
            {
                return false;
            }
            if (_pullRequest.Changes is { } changes)
            {
                return changes.IsOpen && !changes.IsDraft && !changes.Review.CopilotReviewRequested && !WorkItemPullRequest.HasConflicts(_item, changes);
            }
            if (_item.PullRequestHasConflicts)
            {
                return false;
            }
            return _item.Progress is CopilotProgress.ReadyForReview or CopilotProgress.ChangesRequested or CopilotProgress.Approved or CopilotProgress.Stopped;
        }
    }

    private void ShowPullRequestSection(PullRequestSection section)
    {
        _tab = section == PullRequestSection.Changes ? ChangesTab : DiscussionTab;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (WorkItemRoutes.IsOutOfStep(RouteData, GetType(), Id))
        {
            return;
        }

        var type = WorkItemRoutes.TypeOf(Navigation);
        var parameters = (type, Id, TemplateId, ParentIdQuery, MindmapId, IdeaId);
        if (_initialized && _loadedParameters == parameters)
        {
            return;
        }
        _initialized = true;
        _loadedParameters = parameters;
        _type = type;
        // Another work item: start on its own tab, with nothing of the previous pull request.
        _tab = 0;
        _pullRequest.Follow(null);
        _agentTasks.Clear();
        _loading = true;
        _error = null;
        _templates = [];
        _parents = [];
        _children = [];
        _selectedTemplateId = Guid.Empty;
        _templateChoiceId = Guid.Empty;
        _mindmapOrigin.Clear();
        _linkedIdeas = [];
        try
        {
            _item = IsNew
                ? new WorkItem { RepositoryFullName = RepositoryName, Type = _type, ParentId = ParentIdQuery }
                : await WorkItemService.GetAsync(RepositoryName, Id!.Value);
            if (_item is null)
            {
                _error = $"This {Name} does not exist in the selected repository.";
            }
            else if (_item.Type != _type)
            {
                // E.g. an old link: show the item on the page of its own type.
                Navigation.NavigateTo(WorkItemRoutes.ItemPath(_item.Type, _item.Id), replace: true);
                return;
            }
            else
            {
                await LoadHierarchyAsync();
                await LoadLinkedIdeasAsync();
                if (IsNew)
                {
                    await LoadTemplatesAsync();
                    await _mindmapOrigin.LoadAsync(RepositoryName, MindmapId, IdeaId);
                }
                await LoadAgentTasksAsync();
                _generatorActive = !IsNew && _type.GeneratedChildType is not null && Assistant.IsConfigured
                    && (await InternalAgents.GetAsync(InternalAgentKeys.WorkItemBreakdown)).IsEnabled;
            }
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            _error = $"Could not load the {Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        // The suggestion only follows changes made to the description from here on.
        _modelSuggestions.Reset(_item);
        _suggestionsForm = (_item?.Title ?? string.Empty, _item?.Description ?? string.Empty);
        await CreateAssistantToolsAsync();
        _modelSuggestions.SuggestOnOpen(_item);
        await WriteFromMindmapAsync();
    }

    private async Task LoadHierarchyAsync()
    {
        if (_item!.IsDraft && _type.ParentTypes.Count > 0)
        {
            _parents = (await WorkItemService.GetAllAsync(RepositoryName, _type.ParentTypes))
                .OrderBy(p => p.Type).ThenBy(p => p.Title, StringComparer.OrdinalIgnoreCase).ToList();
            if (IsNew && ParentIdQuery is { } requested && _parents.All(p => p.Id != requested))
            {
                _item.ParentId = null;
                Snackbar.Add($"The requested parent can't contain {(_type == WorkItemType.Epic ? "an" : "a")} {Name}, or no longer exists. Choose another.", Severity.Warning);
            }
        }
        if (!IsNew && _type.ChildTypes.Count > 0)
        {
            _children = (await WorkItemService.GetAllAsync(RepositoryName, parentId: _item.Id))
                .OrderBy(c => c.Type).ThenBy(c => c.Status).ThenBy(c => c.Title, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private async Task LoadTemplatesAsync()
    {
        try
        {
            _templates = await Templates.GetAllAsync(_type);
            var template = TemplateId is { } id
                ? _templates.FirstOrDefault(t => t.Id == id)
                : WorkItemTemplate.Proposed(_templates);
            if (TemplateId is not null && template is null)
            {
                Snackbar.Add($"The requested {Name} template no longer exists. Start blank or choose another template.", Severity.Warning);
            }
            _selectedTemplateId = template?.Id ?? Guid.Empty;
            _templateChoiceId = _selectedTemplateId;
            _item!.Description = template?.Description ?? string.Empty;
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not load the {Name} templates: {ex.Message}", Severity.Warning);
        }
    }

    /// <summary>Without them the item still works; the chips to its mindmap ideas are then missing.</summary>
    private async Task LoadLinkedIdeasAsync()
    {
        if (IsNew || _item is null)
        {
            return;
        }
        try
        {
            _linkedIdeas = await Mindmaps.GetLinkedIdeasAsync(RepositoryName, _item.Id);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Logger.LogWarning(ex, "Could not load the mindmap ideas linked to work item {Id}.", _item.Id);
        }
    }

    /// <summary>
    /// Lets the Mindmap Work Item Writer fill in the title and description from the whole map, following the chosen template
    /// (on opening the new item and on Write again); see <see cref="WorkItemMindmapOrigin.WriteAsync"/>.
    /// </summary>
    private async Task WriteFromMindmapAsync()
    {
        if (_item is null || !_mindmapOrigin.HasIdea)
        {
            return;
        }

        _busy = true;
        try
        {
            if (await _mindmapOrigin.WriteAsync(_item, _selectedTemplateId == Guid.Empty ? null : _selectedTemplateId))
            {
                _suggestionsForm = (_item.Title, _item.Description);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reads the agent worker's tasks on the item (only for a stored item on the worker with an issue), and keeps the open tab
    /// when the agent runs tab appears or disappears before it.
    /// </summary>
    private async Task LoadAgentTasksAsync()
    {
        var workItemId = _item is { HasIssue: true } item && item.Id != Guid.Empty && IsWorker && !Removed ? item.Id : (Guid?)null;
        KeepTab(await _agentTasks.LoadAsync(RepositoryName, workItemId));
    }

    /// <summary>A background reload of the agent tasks: keeps the tab, and the runs panel follows a task that ended.</summary>
    private async Task OnAgentTasksReloadedAsync(WorkItemAgentTasksChange change)
    {
        KeepTab(change);
        if (change.Ended && _agentRuns is not null)
        {
            await _agentRuns.ReloadAsync();
        }
        StateHasChanged();
    }

    private void KeepTab(WorkItemAgentTasksChange change)
    {
        if (change.HadTasks != change.HasTasks && _tab >= AgentTasksTab)
        {
            // The tab was removed: back to the item from it, or the pull request's tabs move one to the left; it was added: they
            // move one to the right.
            _tab = change.HadTasks ? (_tab == AgentTasksTab ? 0 : _tab - 1) : _tab + 1;
        }
    }

    private async Task ChangeTemplateAsync(Guid templateId)
    {
        _templateChoiceId = templateId;
        if (templateId == _selectedTemplateId)
        {
            return;
        }

        var previousDescription = SelectedTemplate?.Description ?? string.Empty;
        if (_item!.Description != previousDescription)
        {
            if (await Dialogs.ShowMessageBoxAsync("Replace description?",
                $"Changing the template replaces your current description. The {Name} title and other settings stay unchanged.",
                yesText: "Replace", cancelText: "Cancel") != true)
            {
                _templateChoiceId = _selectedTemplateId;
                return;
            }
        }

        _selectedTemplateId = templateId;
        _item.Description = SelectedTemplate?.Description ?? string.Empty;
    }

    private async Task CreateAssistantToolsAsync()
    {
        if (_item is null)
        {
            return;
        }

        List<AiModel> models = [];
        var modelSelectorActive = false;
        if (_type.CanBeAssigned)
        {
            try
            {
                models = await ModelService.GetEnabledAsync();
                modelSelectorActive = Assistant.IsConfigured && models.Count > 0
                    && (await InternalAgents.GetAsync(InternalAgentKeys.ModelSelector)).IsEnabled;
            }
            catch (Exception ex) when (WorkItemActions.IsExpected(ex))
            {
                Snackbar.Add($"Could not load the managed models for DGHSF Agent: {ex.Message}", Severity.Warning);
            }
        }

        _modelSuggestions.Configure(modelSelectorActive, models);
        _assistantTools = AssistantForms.ForWorkItem(
            () => _item!,
            () => SelectedTemplate,
            models,
            // A repository removed from GitHub has no custom agents to read anymore.
            async cancellationToken => _customAgents ??= Removed ? [] : await GitHub.GetCustomAgentsAsync(RepositoryName, cancellationToken),
            change => InvokeAsync(() => { change(); _modelSuggestions.Schedule(_item); StateHasChanged(); }),
            (parentId, cancellationToken) => WorkItemService.GetAncestorsAsync(RepositoryName, parentId, cancellationToken),
            Knowledge.IsSearchEnabled ? SearchKnowledgeBaseAsync : null);
    }

    /// <summary>The agent's <c>search_knowledge_base</c> tool: the global files and this repository's files.</summary>
    private async Task<IReadOnlyList<KnowledgeSearchResult>> SearchKnowledgeBaseAsync(string query, CancellationToken cancellationToken)
    {
        try
        {
            return await Knowledge.SearchAsync(RepositoryName, query, cancellationToken);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The agent is told the tool failed; the details are only logged.
            Logger.LogWarning(ex, "Searching the knowledge base of {Repository} failed.", RepositoryName);
            throw;
        }
    }

    /// <summary>The agent's suggestion chips follow the title and description, once a changed field loses focus.</summary>
    private void OnFieldBlur()
    {
        if (_item is null)
        {
            return;
        }

        var form = (_item.Title ?? string.Empty, _item.Description ?? string.Empty);
        if (form != _suggestionsForm)
        {
            _suggestionsForm = form;
            _chat?.RefreshSuggestions();
        }
    }

    /// <summary>A different parent changes what the item builds on, so the agent's suggestion chips follow it.</summary>
    private void OnParentChanged(Guid? parentId)
    {
        if (_item is null || _item.ParentId == parentId)
        {
            return;
        }

        _item.ParentId = parentId;
        _chat?.RefreshSuggestions();
    }

    private void OnDescriptionChanged(string description)
    {
        _item!.Description = description;
        _modelSuggestions.Schedule(_item);
    }

    public void Dispose()
    {
        _pullRequest.Changed -= OnPullRequestChanged;
        _modelSuggestions.Dispose();
        _agentTasks.Dispose();
    }

    private async Task<bool> SaveCoreAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return false;
        }

        var wasNew = _item!.Id == Guid.Empty;
        _item = await WorkItemService.SaveAsync(_item);
        if (wasNew)
        {
            await _mindmapOrigin.LinkAsync(RepositoryName, _item.Id);
            if (_chat is not null)
            {
                await _chat.AttachAsync(ChatOwner.ForWorkItem(RepositoryName, _item.Id));
            }
            Navigation.NavigateTo(WorkItemRoutes.ItemPath(_item.Type, _item.Id), replace: true);
        }
        return true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (await SaveCoreAsync())
            {
                Snackbar.Add($"Saved '{_item!.Title}'.", Severity.Success);
            }
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The agent works from the stored item, so unsaved changes are saved first (they'd be lost by leaving the page anyway).</summary>
    private async Task GenerateChildrenAsync()
    {
        _busy = true;
        try
        {
            if ((!_item!.IsDraft && !_item.CanEditAssignment) || await SaveCoreAsync())
            {
                Navigation.NavigateTo(WorkItemRoutes.GeneratePath(_type, _item!.Id));
            }
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Loads the stored item again and discards unsaved changes; the agent conversation is kept.</summary>
    private async Task ResetAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Reset changes", $"Discard your changes and load the saved {Name} again?",
                yesText: "Reset", cancelText: "Cancel") != true)
        {
            return;
        }

        _busy = true;
        try
        {
            var stored = await WorkItemService.GetAsync(RepositoryName, _item!.Id);
            if (stored is null)
            {
                Snackbar.Add($"This {Name} no longer exists.", Severity.Warning);
                return;
            }

            _item = stored;
            await LoadHierarchyAsync();
            await _form!.ResetValidationAsync();

            // Like opening the item: the suggestions follow the stored title and description.
            _modelSuggestions.Reset(_item);
            OnFieldBlur();
            _modelSuggestions.SuggestOnOpen(_item);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not reset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcceptAsync()
    {
        if (string.IsNullOrWhiteSpace(_item!.Description))
        {
            Snackbar.Add($"Describe the {Name} before accepting it.", Severity.Warning);
            return;
        }
        if (_type.RequiresParent && _item.ParentId is null)
        {
            Snackbar.Add($"Choose the {ParentNames} this {Name} is part of before accepting it.", Severity.Warning);
            return;
        }
        if (await WorkItemActions.ConfirmAcceptAsync(Dialogs, _item, SelectedParent, RepositoryName) != true)
        {
            return;
        }

        _busy = true;
        try
        {
            if (await SaveCoreAsync())
            {
                var result = await WorkItemService.AcceptAsync(RepositoryName, _item!.Id);
                _item = result.WorkItem;
                WorkItemActions.Report(Snackbar, result);
            }
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not accept: {ex.Message}", Severity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Whether the item's agent is the DGHSF agent worker instead of the Copilot cloud agent.</summary>
    private bool IsWorker
    {
        get
        {
            return _type.CanBeAssigned && _item?.Executor == AgentExecutor.DghsfWorker;
        }
    }

    private async Task AssignAsync()
    {
        _busy = true;
        try
        {
            _item = await WorkItemService.SaveAsync(_item!);
            var result = await WorkItemService.AssignAgentAsync(RepositoryName, _item.Id);
            _item = result.WorkItem;
            WorkItemActions.Report(Snackbar, result);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not assign: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The branch on GitHub; each path segment is escaped, the slashes between them stay.</summary>
    private string BranchUrl(string branch)
    {
        return $"https://github.com/{RepositoryName}/tree/{string.Join('/', branch.Split('/').Select(Uri.EscapeDataString))}";
    }

    private async Task CopyBranchAsync(string branch)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", branch);
            Snackbar.Add($"Copied '{branch}' to the clipboard.", Severity.Success);
        }
        catch (JSException ex)
        {
            // E.g. the browser denies clipboard access.
            Snackbar.Add($"Could not copy the branch name: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>Stores the issue's current state. Unsaved assignment settings stay in the form while they can still be edited.</summary>
    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            var form = _item!;
            var result = await WorkItemService.RefreshAsync(RepositoryName, form.Id);
            _item = result.WorkItem;
            if (_item.CanEditAssignment)
            {
                _item.Executor = form.Executor;
                _item.CustomAgent = form.CustomAgent;
                _item.Model = form.Model;
                _item.BaseBranch = form.BaseBranch;
                _item.CustomInstructions = form.CustomInstructions;
                _item.IncludeScreenshots = form.IncludeScreenshots;
                _item.ReviseOnCopilotReview = form.ReviseOnCopilotReview;
                _item.FixMergeConflicts = form.FixMergeConflicts;
            }
            WorkItemActions.Report(Snackbar, result);
            _modelSuggestions.Schedule(_item);
            if (_agentRuns is not null)
            {
                await _agentRuns.ReloadAsync();
            }
            await LoadAgentTasksAsync();
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not refresh: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (await WorkItemActions.ConfirmDeleteAsync(Dialogs, _item!) != true)
        {
            return;
        }

        try
        {
            var back = _item!.Parent is { } parent ? WorkItemRoutes.ItemPath(parent.Type, parent.Id) : WorkItemRoutes.ListPath(_type);
            await WorkItemService.DeleteAsync(RepositoryName, _item.Id);
            Snackbar.Add($"Deleted '{_item.Title}'.", Severity.Success);
            Navigation.NavigateTo(back);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not delete: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        if (_item is not null && _item.Id != Guid.Empty && await WorkItemService.GetAsync(RepositoryName, _item.Id) is { } fresh)
        {
            _item = fresh;
        }
    }
}
