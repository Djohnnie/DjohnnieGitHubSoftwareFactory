@page "/epics/new"
@page "/epics/{Id:int}"
@page "/features/new"
@page "/features/{Id:int}"
@page "/stories/new"
@page "/stories/{Id:int}"
@page "/bugs/new"
@page "/bugs/{Id:int}"
@page "/tasks/new"
@page "/tasks/{Id:int}"
@implements IDisposable
@inject WorkItemService WorkItemService
@inject WorkItemTemplateService Templates
@inject AiModelService ModelService
@inject GitHubService GitHub
@inject AssistantService Assistant
@inject InternalAgentService InternalAgents
@inject RepositoryContext Repository
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ILogger<WorkItemEditor> Logger

<PageTitle>@Heading</PageTitle>

<PageBreadcrumbs Parents="BreadcrumbParents" Current="@BreadcrumbCurrent" BackHref="@BackPath" BackDisabled="_busy" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">@Heading</MudText>
    <WorkItemTypeChip Type="_type" />
</MudStack>

@if (!_loading && _item is not null)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        @if (_item.IsDraft || _item.CanEditAssignment)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Save">@(_item.IsDraft ? "Save draft" : "Save")</MudButton>
        }
        @if (_item.IsDraft)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AcceptAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.RocketLaunch">@WorkItemActions.AcceptText(_type)</MudButton>
        }
        else if (_item.Status == WorkItemStatus.Accepted && _type.CanBeAssigned)
        {
            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="AssignAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.SmartToy">Assign agent</MudButton>
        }
        @if (!IsNew && (_item.IsDraft || _item.CanEditAssignment))
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ResetAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Undo">Reset</MudButton>
        }
        <MudSpacer />
        @if (!IsNew)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync"
                       Disabled="_busy">Delete @Name</MudButton>
        }
    </MudStack>
    @if (_busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
}

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_item is not null)
{
    <MudForm @ref="_form" Model="_item">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudStack Spacing="4">
                    @if (IsNew && _templates.Count > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                            <MudSelect T="int" Value="_templateChoiceId" ValueChanged="ChangeTemplateAsync" Label="@($"{_type.DisplayName} template")"
                                       Variant="Variant.Outlined" Disabled="_busy"
                                       HelperText="The first template alphabetically is proposed. Choose another or start blank.">
                                <MudSelectItem T="int" Value="0">No template</MudSelectItem>
                                @foreach (var template in _templates)
                                {
                                    <MudSelectItem T="int" Value="template.Id">@template.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudPaper>
                    }
                    @if (_item.IsDraft)
                    {
                        <AssistantChat @ref="_chat" @key="@($"{_type}:{Id}")" CopilotKey="@InternalAgentKeys.ForWorkItem(_type)" SuggestionContext="@($"Repository: {RepositoryName}")" Tools="_assistantTools"
                                       Owner="@(IsNew ? null : ChatOwner.ForWorkItem(RepositoryName, Id!.Value))"
                                       Placeholder="@ChatPlaceholder"
                                       Subtitle="@($"Describe the {Name}; I'll ask what I need to know and fill in the form.")"
                                       Suggestions="@(IsNew ? Suggestions : [])" />
                    }
                    else
                    {
                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true">
                            This @Name is accepted and lives on as GitHub issue #@_item.IssueNumber; its content is no longer edited here.
                        </MudAlert>
                    }
                    <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                        @* Dictating a title is like typing one and leaving the field: the chat suggestions follow it. *@
                        <DictationTextField @bind-Value="_item.Title" Label="Title" Required="true" RequiredError="A title is required."
                                            MaxLength="256" ReadOnly="!_item.IsDraft" OnBlur="OnFieldBlur" OnDictated="OnFieldBlur"
                                            Placeholder="@SelectedTemplate?.TitleTemplate"
                                            HelperText="Becomes the title of the GitHub issue." />
                    </MudPaper>

                    <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                        @if (_item.IsDraft)
                        {
                            <MarkdownEditor Value="@_item.Description" ValueChanged="OnDescriptionChanged" OnBlur="OnFieldBlur" MaxLength="WorkItem.MaxDescriptionLength" AllowImages="true"
                                            Placeholder="@($"Describe the {Name}...")"
                                            Dictation="@(new DescriptionDictation(Name, _item.Title, SelectedTemplate?.Description))">
                                <Header>
                                    <MudText Typo="Typo.h6">Description</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@DescriptionHelp</MudText>
                                </Header>
                            </MarkdownEditor>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">Description</MudText>
                            <MarkdownViewer Value="@_item.Description" />
                        }
                    </MudPaper>

                    @if (!IsNew && _type.ChildTypes.Count > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0" aria-label="Children">
                            <MudText Typo="Typo.h6">Part of this @Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                Accepted children become sub-issues of this @Name's issue on GitHub.
                            </MudText>
                            @if (_children.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mb-2">Nothing yet.</MudText>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-2">
                                    <tbody>
                                        @foreach (var child in _children)
                                        {
                                            <tr>
                                                <td style="width:1%; white-space:nowrap"><WorkItemTypeChip Type="child.Type" /></td>
                                                <td><MudLink Href="@WorkItemRoutes.ItemPath(child.Type, child.Id)">@child.Title</MudLink></td>
                                                <td style="width:1%; white-space:nowrap"><WorkItemStatusChip Status="child.Status" /></td>
                                                <td style="width:1%; white-space:nowrap">
                                                    @if (child.IssueNumber is { } childNumber)
                                                    {
                                                        <MudLink Href="@child.IssueUrl" Target="_blank">#@childNumber</MudLink>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var childType in _type.ChildTypes)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                               Href="@WorkItemRoutes.NewPath(childType, parentId: _item.Id)">Add @WorkItemActions.Name(childType)</MudButton>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudStack Spacing="4" Class="sticky-side">
                    <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                        <MudText Typo="Typo.h6" GutterBottom="true">Status</MudText>
                        <WorkItemStatusChip Status="_item.Status" />
                        @if (_item.IssueNumber is { } number)
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">
                                GitHub issue <MudLink Href="@_item.IssueUrl" Target="_blank">#@number</MudLink>
                            </MudText>
                        }
                        @if (_item.AcceptedAt is { } accepted)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Accepted @accepted.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                        }
                        @if (_item.AssignedAt is { } assigned)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Assigned to Copilot @assigned.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                        }
                        @if (_item.Status == WorkItemStatus.Accepted && _type.CanBeAssigned)
                        {
                            <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Class="mt-2">
                                The issue exists but is not assigned to Copilot yet. Check the assignment and try again.
                            </MudAlert>
                        }
                        @if (!_type.CanBeAssigned)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                                @_type.PluralName give structure and are not assigned to an agent; their user stories, bugs and tasks are.
                            </MudText>
                        }
                    </MudPaper>

                    @if (_type.ParentTypes.Count > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                            <MudText Typo="Typo.h6">Part of</MudText>
                            @if (_item.IsDraft)
                            {
                                <MudSelect T="int?" Variant="Variant.Outlined" @bind-Value="_item.ParentId" Label="Parent"
                                           Required="_type.RequiresParent" RequiredError="@($"Choose the {ParentNames} this {Name} is part of.")"
                                           Clearable="!_type.RequiresParent" ToStringFunc="ParentLabel" AnchorOrigin="Origin.BottomCenter" MaxHeight="420"
                                           HelperText="@ParentHelp">
                                    @if (!_type.RequiresParent)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)null)">Standalone (no parent)</MudSelectItem>
                                    }
                                    @foreach (var parent in _parents)
                                    {
                                        <MudSelectItem T="int?" Value="@parent.Id">
                                            <MudText Typo="Typo.body2">
                                                <MudIcon Icon="@WorkItemRoutes.Icon(parent.Type)" Size="Size.Small" Style="vertical-align:text-bottom" Class="mr-1" />
                                                @parent.Title
                                                @if (parent.IssueNumber is { } parentNumber)
                                                {
                                                    <span class="mono"> #@parentNumber</span>
                                                }
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@parent.Type.DisplayName · @WorkItemStatusChip.LabelOf(parent.Status)</MudText>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                                @if (_type.RequiresParent && _parents.Count == 0)
                                {
                                    <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Class="mt-2">
                                        There is no @ParentNames yet in this repository.
                                        <MudLink Href="@WorkItemRoutes.NewPath(_type.ParentTypes[0])">Create one first</MudLink>.
                                    </MudAlert>
                                }
                                @if (SelectedParent is { IssueNumber: null } waiting)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                                        '@waiting.Title' isn't accepted yet: this issue becomes its sub-issue once it is.
                                    </MudText>
                                }
                            }
                            else if (SelectedParent is { } parent)
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">
                                    <MudIcon Icon="@WorkItemRoutes.Icon(parent.Type)" Size="Size.Small" Style="vertical-align:text-bottom" />
                                    <MudLink Href="@WorkItemRoutes.ItemPath(parent.Type, parent.Id)">@parent.Title</MudLink>
                                    @if (parent.IssueNumber is { } parentNumber)
                                    {
                                        <span> (<MudLink Href="@parent.IssueUrl" Target="_blank">#@parentNumber</MudLink>)</span>
                                    }
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">Standalone</MudText>
                            }
                        </MudPaper>
                    }

                    @if (_type.CanBeAssigned)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                            <MudText Typo="Typo.h6">Assignment</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                On accept, the issue is assigned to the Copilot cloud agent with these settings.
                            </MudText>
                            <AgentPicker @bind-Value="_item.CustomAgent" ReadOnly="!_item.CanEditAssignment"
                                         HelperText="A custom agent from .github/agents, or the default Copilot agent." />
                            <ModelPicker @bind-Value="_item.Model" ReadOnly="!_item.CanEditAssignment" DefaultText="Auto (Copilot picks the model)"
                                         HelperText="The model the cloud agent uses." />
                            @if (_modelSelectorActive && _item.CanEditAssignment && (_suggestingModel || _modelSuggestion is not null))
                            {
                                <div class="mb-2 model-suggestion" aria-label="Model suggestion" aria-live="polite">
                                    @if (_suggestingModel)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">The Model Selector is reading the description…</MudText>
                                        </MudStack>
                                    }
                                    else if (_modelSuggestion is { } suggestion)
                                    {
                                        var applied = string.Equals(_item.Model, suggestion.ModelId, StringComparison.OrdinalIgnoreCase);
                                        <MudTooltip Text="@($"{Capitalize(suggestion.Complexity)} complexity. {suggestion.Reason}")">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                     Icon="@(applied ? Icons.Material.Filled.Check : Icons.Material.Filled.AutoAwesome)"
                                                     OnClick="ApplyModelSuggestion" Disabled="applied">
                                                @(applied ? "Suggested" : "Suggestion"): @ModelName(suggestion.ModelId) · @suggestion.Complexity
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                            <MudTextField Variant="Variant.Outlined" @bind-Value="_item.BaseBranch" Label="Base branch" ReadOnly="!_item.CanEditAssignment"
                                          Placeholder="@Repository.Current?.DefaultBranch" MaxLength="250"
                                          HelperText="The branch Copilot starts from. Empty for the default branch." />
                            <MudTextField Variant="Variant.Outlined" @bind-Value="_item.CustomInstructions" Label="Custom instructions" ReadOnly="!_item.CanEditAssignment"
                                          Lines="3" Sizing="InputSizing.Auto" MaxLength="10000"
                                          HelperText="Extra guidance for Copilot on top of the issue." />
                        </MudPaper>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudForm>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "template")] public int? TemplateId { get; set; }
    [SupplyParameterFromQuery(Name = "parent")] public int? ParentIdQuery { get; set; }

    /// <summary>Changes on every navigation, so switching between the type pages (which share this component) reloads.</summary>
    [CascadingParameter] private RouteData? RouteData { get; set; }

    private AssistantTools? _assistantTools;
    private AssistantChat? _chat;
    private (string Title, string Description) _suggestionsForm;
    private List<AgentSummary>? _customAgents;
    /// <summary>How long the description must stay unchanged before the Model Selector suggests a model (a debounce).</summary>
    private static readonly TimeSpan ModelSuggestionDelay = TimeSpan.FromSeconds(3);

    private List<AiModel> _models = [];
    private bool _modelSelectorActive;
    private bool _suggestingModel;
    private ModelSelection? _modelSuggestion;
    private string? _suggestedDescription;
    private CancellationTokenSource? _modelSuggestionCancellation;

    private WorkItemType _type;
    private MudForm? _form;
    private WorkItem? _item;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<WorkItemTemplate> _templates = [];
    private List<WorkItem> _parents = [];
    private List<WorkItem> _children = [];
    private int _selectedTemplateId;
    private int _templateChoiceId;
    private bool _initialized;
    private (WorkItemType Type, int? Id, int? TemplateId, int? ParentId) _loadedParameters;

    private bool IsNew => Id is null;
    private string Name => WorkItemActions.Name(_type);
    private string Heading => IsNew ? $"New {Name}" : _item?.Title ?? _type.DisplayName;
    private string ChatPlaceholder =>_type == WorkItemType.Bug ? "Describe what goes wrong" : "Describe what you want to build";
    private WorkItemTemplate? SelectedTemplate => _templates.FirstOrDefault(t => t.Id == _selectedTemplateId);
    private string RepositoryName => Repository.Current!.FullName;
    private string ParentNames => string.Join(" or ", _type.ParentTypes.Select(WorkItemActions.Name));

    /// <summary>The chosen parent: from the candidates while editing, otherwise as stored.</summary>
    private WorkItemReference? SelectedParent
    {
        get
        {
            if (_item?.ParentId is not { } parentId)
            {
                return null;
            }
            return _parents.FirstOrDefault(p => p.Id == parentId) is { } candidate
                ? new WorkItemReference(candidate.Id, candidate.Type, candidate.Title, candidate.Status, candidate.IssueNumber, candidate.IssueUrl)
                : _item.Parent is { } stored && stored.Id == parentId ? stored : null;
        }
    }

    private string BackPath => _item?.Parent is { } parent && !IsNew
        ? WorkItemRoutes.ItemPath(parent.Type, parent.Id)
        : SelectedParent is { } selected ? WorkItemRoutes.ItemPath(selected.Type, selected.Id) : WorkItemRoutes.ListPath(_type);

    private IReadOnlyList<BreadcrumbItem> BreadcrumbParents
    {
        get
        {
            List<BreadcrumbItem> parents = [new(_type.PluralName, WorkItemRoutes.ListPath(_type))];
            if (_item?.Parent is { } parent)
            {
                parents.Add(new(parent.Title, WorkItemRoutes.ItemPath(parent.Type, parent.Id)));
            }
            return parents;
        }
    }

    private string BreadcrumbCurrent => _item is { Id: > 0 } ? _item.Title : IsNew ? "New" : $"#{Id}";

    private string ParentHelp => _type.RequiresParent
        ? $"Every {Name} is part of {(_type.ParentTypes[0] == WorkItemType.Epic ? "an" : "a")} {ParentNames}; its issue becomes a sub-issue of the parent's issue."
        : $"Optional: an {ParentNames} this {Name} belongs to; its issue then becomes a sub-issue of the parent's issue.";

    private string DescriptionHelp => _type switch
    {
        WorkItemType.Epic => "The goal and scope of the epic. This becomes the issue body; the work itself is split into features.",
        WorkItemType.Feature => "What the feature enables and its acceptance criteria. This becomes the issue body; the work itself is split into user stories.",
        WorkItemType.Bug => "Steps to reproduce, expected and actual behavior. This becomes the issue body and is what the Copilot cloud agent works from.",
        _ => $"What needs to be done and why, with acceptance criteria. This becomes the issue body and is what the Copilot cloud agent works from."
    };

    private IReadOnlyList<string> Suggestions => _type switch
    {
        WorkItemType.Epic => ["Add passkey login next to the existing sign-in", "Add a dark mode that follows the system setting", "Export all data to CSV"],
        WorkItemType.Feature => ["Sign in with a passkey", "Switch between light and dark mode", "Download a CSV export of my data"],
        WorkItemType.Story => ["As a user I want to reset my password by email", "As an admin I want to see who signed in last", "As a visitor I want to filter products by price"],
        WorkItemType.Bug => ["The login page crashes when the password is empty", "Dates are shown in UTC instead of local time", "Saving twice creates duplicate records"],
        _ => ["Upgrade the project to the latest .NET version", "Add unit tests for the order service", "Set up a GitHub Actions build"]
    };

    protected override async Task OnParametersSetAsync()
    {
        var type = WorkItemRoutes.TypeOf(Navigation);
        var parameters = (type, Id, TemplateId, ParentIdQuery);
        if (_initialized && _loadedParameters == parameters)
        {
            return;
        }
        _initialized = true;
        _loadedParameters = parameters;
        _type = type;
        _loading = true;
        _error = null;
        _templates = [];
        _parents = [];
        _children = [];
        _selectedTemplateId = 0;
        _templateChoiceId = 0;
        try
        {
            _item = IsNew
                ? new WorkItem { RepositoryFullName = RepositoryName, Type = _type, ParentId = ParentIdQuery }
                : await WorkItemService.GetAsync(RepositoryName, Id!.Value);
            if (_item is null)
            {
                _error = $"This {Name} does not exist in the selected repository.";
            }
            else if (_item.Type != _type)
            {
                // E.g. an old link: show the item on the page of its own type.
                Navigation.NavigateTo(WorkItemRoutes.ItemPath(_item.Type, _item.Id), replace: true);
                return;
            }
            else
            {
                await LoadHierarchyAsync();
                if (IsNew)
                {
                    await LoadTemplatesAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load the {Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        // The suggestion only follows changes made to the description from here on.
        CancelModelSuggestion();
        _modelSuggestion = null;
        _suggestedDescription = _item?.Description;
        _suggestionsForm = (_item?.Title ?? string.Empty, _item?.Description ?? string.Empty);
        await CreateAssistantToolsAsync();
        SuggestModelOnOpen();
    }

    private async Task LoadHierarchyAsync()
    {
        if (_item!.IsDraft && _type.ParentTypes.Count > 0)
        {
            _parents = (await WorkItemService.GetAllAsync(RepositoryName, _type.ParentTypes))
                .OrderBy(p => p.Type).ThenBy(p => p.Title, StringComparer.OrdinalIgnoreCase).ToList();
            if (IsNew && ParentIdQuery is { } requested && _parents.All(p => p.Id != requested))
            {
                _item.ParentId = null;
                Snackbar.Add($"The requested parent can't contain {(_type == WorkItemType.Epic ? "an" : "a")} {Name}, or no longer exists. Choose another.", Severity.Warning);
            }
        }
        if (!IsNew && _type.ChildTypes.Count > 0)
        {
            _children = (await WorkItemService.GetAllAsync(RepositoryName, parentId: _item.Id))
                .OrderBy(c => c.Type).ThenBy(c => c.Status).ThenBy(c => c.Title, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private async Task LoadTemplatesAsync()
    {
        try
        {
            _templates = await Templates.GetAllAsync(_type);
            var template = TemplateId is { } id
                ? _templates.FirstOrDefault(t => t.Id == id)
                : _templates.FirstOrDefault();
            if (TemplateId is not null && template is null)
            {
                Snackbar.Add($"The requested {Name} template no longer exists. Start blank or choose another template.", Severity.Warning);
            }
            _selectedTemplateId = template?.Id ?? 0;
            _templateChoiceId = _selectedTemplateId;
            _item!.Description = template?.Description ?? string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load the {Name} templates: {ex.Message}", Severity.Warning);
        }
    }

    private async Task ChangeTemplateAsync(int templateId)
    {
        _templateChoiceId = templateId;
        if (templateId == _selectedTemplateId)
        {
            return;
        }

        var previousDescription = SelectedTemplate?.Description ?? string.Empty;
        if (_item!.Description != previousDescription)
        {
            StateHasChanged();
            if (await Dialogs.ShowMessageBoxAsync("Replace description?",
                $"Changing the template replaces your current description. The {Name} title and other settings stay unchanged.",
                yesText: "Replace", cancelText: "Cancel") != true)
            {
                _templateChoiceId = _selectedTemplateId;
                return;
            }
        }

        _selectedTemplateId = templateId;
        _item.Description = SelectedTemplate?.Description ?? string.Empty;
    }

    private async Task CreateAssistantToolsAsync()
    {
        if (_item is null)
        {
            return;
        }

        List<AiModel> models = [];
        if (_type.CanBeAssigned)
        {
            try
            {
                models = await ModelService.GetEnabledAsync();
                _modelSelectorActive = Assistant.IsConfigured && models.Count > 0
                    && (await InternalAgents.GetAsync(InternalAgentKeys.ModelSelector)).IsEnabled;
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not load the managed models for DGHSF Copilot: {ex.Message}", Severity.Warning);
            }
        }

        _models = models;
        _assistantTools = AssistantForms.ForWorkItem(
            () => _item!,
            () => SelectedTemplate,
            models,
            async cancellationToken => _customAgents ??= await GitHub.GetCustomAgentsAsync(RepositoryName, cancellationToken),
            change => InvokeAsync(() => { change(); ScheduleModelSuggestion(); StateHasChanged(); }));
    }

    /// <summary>The Copilot's suggestion chips follow the title and description, once a changed field loses focus.</summary>
    private void OnFieldBlur()
    {
        if (_item is null)
        {
            return;
        }

        var form = (_item.Title ?? string.Empty, _item.Description ?? string.Empty);
        if (form != _suggestionsForm)
        {
            _suggestionsForm = form;
            _chat?.RefreshSuggestions();
        }
    }

    private void OnDescriptionChanged(string description)
    {
        _item!.Description = description;
        ScheduleModelSuggestion();
    }

    /// <summary>
    /// Debounces the Model Selector: every change to the description restarts the delay, and only when the description
    /// stays unchanged for <see cref="ModelSuggestionDelay"/> is a model suggested. Other fields don't trigger it.
    /// </summary>
    private void ScheduleModelSuggestion()
    {
        if (_item is null || !_modelSelectorActive || !_item.CanEditAssignment
            || string.Equals(_item.Description, _suggestedDescription, StringComparison.Ordinal))
        {
            return;
        }

        CancelModelSuggestion();
        _suggestedDescription = _item.Description;
        if (string.IsNullOrWhiteSpace(_item.Description))
        {
            _modelSuggestion = null;
            return;
        }

        _modelSuggestionCancellation = new CancellationTokenSource();
        _ = SuggestModelAsync(_item.Copy(), ModelSuggestionDelay, _modelSuggestionCancellation.Token);
    }

    /// <summary>An existing draft with a description gets a suggestion right away; new items only after their description changes.</summary>
    private void SuggestModelOnOpen()
    {
        if (IsNew || _item is null || !_modelSelectorActive || !_item.CanEditAssignment || string.IsNullOrWhiteSpace(_item.Description))
        {
            return;
        }

        _modelSuggestionCancellation = new CancellationTokenSource();
        _ = SuggestModelAsync(_item.Copy(), TimeSpan.Zero, _modelSuggestionCancellation.Token);
    }

    private async Task SuggestModelAsync(WorkItem item, TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            if (delay > TimeSpan.Zero)
            {
                await Task.Delay(delay, cancellationToken);
            }
            await InvokeAsync(() =>
            {
                _suggestingModel = true;
                StateHasChanged();
            });
            var suggestion = await WorkItemService.SelectModelAsync(item, cancellationToken);
            await InvokeAsync(() =>
            {
                if (!cancellationToken.IsCancellationRequested)
                {
                    _modelSuggestion = suggestion;
                    _suggestingModel = false;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            // Fire and forget: nothing else observes this task, so a failure must not leave the spinner running.
            Logger.LogWarning(ex, "Suggesting a model for work item {Id} failed.", item.Id);
            await InvokeAsync(() =>
            {
                _suggestingModel = false;
                StateHasChanged();
            });
        }
    }

    private void CancelModelSuggestion()
    {
        _modelSuggestionCancellation?.Cancel();
        _modelSuggestionCancellation?.Dispose();
        _modelSuggestionCancellation = null;
        _suggestingModel = false;
    }

    private void ApplyModelSuggestion()
    {
        if (_modelSuggestion is { } suggestion && _item is { CanEditAssignment: true })
        {
            _item.Model = suggestion.ModelId;
        }
    }

    private string ModelName(string modelId)
    {
        return _models.FirstOrDefault(m => string.Equals(m.ModelId, modelId, StringComparison.OrdinalIgnoreCase))?.Name ?? modelId;
    }

    private static string Capitalize(string value)
    {
        return value.Length == 0 ? value : string.Concat(value[..1].ToUpperInvariant(), value[1..]);
    }

    public void Dispose()
    {
        CancelModelSuggestion();
    }

    private string ParentLabel(int? parentId)
    {
        if (parentId is null)
        {
            return _type.RequiresParent ? string.Empty : "Standalone (no parent)";
        }
        return _parents.FirstOrDefault(p => p.Id == parentId) is { } parent
            ? $"{parent.Type.DisplayName}: {parent.Title}"
            : _item?.Parent?.Title ?? $"#{parentId}";
    }

    private async Task<bool> SaveCoreAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return false;
        }

        var wasNew = _item!.Id == 0;
        _item = await WorkItemService.SaveAsync(_item);
        if (wasNew)
        {
            if (_chat is not null)
            {
                await _chat.AttachAsync(ChatOwner.ForWorkItem(RepositoryName, _item.Id));
            }
            Navigation.NavigateTo(WorkItemRoutes.ItemPath(_item.Type, _item.Id), replace: true);
        }
        return true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (await SaveCoreAsync())
            {
                Snackbar.Add($"Saved '{_item!.Title}'.", Severity.Success);
            }
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Loads the stored item again and discards unsaved changes; the Copilot conversation is kept.</summary>
    private async Task ResetAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Reset changes", $"Discard your changes and load the saved {Name} again?",
                yesText: "Reset", cancelText: "Cancel") != true)
        {
            return;
        }

        _busy = true;
        try
        {
            var stored = await WorkItemService.GetAsync(RepositoryName, _item!.Id);
            if (stored is null)
            {
                Snackbar.Add($"This {Name} no longer exists.", Severity.Warning);
                return;
            }

            _item = stored;
            await LoadHierarchyAsync();
            await _form!.ResetValidationAsync();

            // Like opening the item: the suggestions follow the stored title and description.
            CancelModelSuggestion();
            _modelSuggestion = null;
            _suggestedDescription = _item.Description;
            OnFieldBlur();
            SuggestModelOnOpen();
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not reset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcceptAsync()
    {
        if (string.IsNullOrWhiteSpace(_item!.Description))
        {
            Snackbar.Add($"Describe the {Name} before accepting it.", Severity.Warning);
            return;
        }
        if (_type.RequiresParent && _item.ParentId is null)
        {
            Snackbar.Add($"Choose the {ParentNames} this {Name} is part of before accepting it.", Severity.Warning);
            return;
        }
        if (await WorkItemActions.ConfirmAcceptAsync(Dialogs, _item, SelectedParent, RepositoryName) != true)
        {
            return;
        }

        _busy = true;
        try
        {
            if (await SaveCoreAsync())
            {
                var result = await WorkItemService.AcceptAsync(RepositoryName, _item!.Id);
                _item = result.WorkItem;
                WorkItemActions.Report(Snackbar, result);
            }
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not accept: {ex.Message}", Severity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AssignAsync()
    {
        _busy = true;
        try
        {
            _item = await WorkItemService.SaveAsync(_item!);
            var result = await WorkItemService.AssignAgentAsync(RepositoryName, _item.Id);
            _item = result.WorkItem;
            WorkItemActions.Report(Snackbar, result);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not assign: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (await WorkItemActions.ConfirmDeleteAsync(Dialogs, _item!) != true)
        {
            return;
        }

        try
        {
            var back = _item!.Parent is { } parent ? WorkItemRoutes.ItemPath(parent.Type, parent.Id) : WorkItemRoutes.ListPath(_type);
            await WorkItemService.DeleteAsync(RepositoryName, _item.Id);
            Snackbar.Add($"Deleted '{_item.Title}'.", Severity.Success);
            Navigation.NavigateTo(back);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        if (_item is { Id: > 0 } && await WorkItemService.GetAsync(RepositoryName, _item.Id) is { } fresh)
        {
            _item = fresh;
        }
    }
}
