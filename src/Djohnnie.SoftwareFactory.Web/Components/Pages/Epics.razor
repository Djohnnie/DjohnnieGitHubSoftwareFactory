@page "/epics"
@inject EpicService EpicService
@inject RepositoryContext Repository
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Epics</PageTitle>

<MudStack Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Epics</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Epics of <b>@Repository.Current?.FullName</b>. Drafts stay in DGHSF; accepting an epic creates a GitHub issue
            labelled <code>@Epic.Label</code> and assigns it to the Copilot cloud agent.
        </MudText>
    </div>
    <MudStack Row="true" Wrap="Wrap.Wrap">
        <MudButton Href="/epics/new" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New epic</MudButton>
        <MudSpacer />
        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading" title="Reload" />
    </MudStack>
</MudStack>

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudTable Outlined="true" Striped="true" T="Epic" Items="_epics" Filter="Matches" Loading="_loading" LoadingProgressColor="Color.Primary" Hover="true" Elevation="0">
    <ToolBarContent>
        <MudTextField Variant="Variant.Text" Underline="false" @bind-Value="_search" Placeholder="Search epics" Adornment="Adornment.Start" Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Clearable="true" />
        <MudSpacer />
        <MudSelect Variant="Variant.Outlined" T="WorkItemStatus?" @bind-Value="_status" Label="Status" Dense="true" Clearable="true" Style="max-width:200px">
            @foreach (var status in Enum.GetValues<WorkItemStatus>())
            {
                <MudSelectItem T="WorkItemStatus?" Value="status">@WorkItemStatusChip.LabelOf(status)</MudSelectItem>
            }
        </MudSelect>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Epic</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Issue</MudTh>
        <MudTh>Agent</MudTh>
        <MudTh>Model</MudTh>
        <MudTh>Updated</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Epic">
            <MudLink Href="@($"/epics/{context.Id}")" Typo="Typo.body1"><b>@context.Title</b></MudLink>
        </MudTd>
        <MudTd DataLabel="Status"><WorkItemStatusChip Status="context.Status" /></MudTd>
        <MudTd DataLabel="Issue">
            @if (context.IssueNumber is { } number)
            {
                <MudLink Href="@context.IssueUrl" Target="_blank">#@number</MudLink>
            }
        </MudTd>
        <MudTd DataLabel="Agent"><span class="mono">@(context.CustomAgent ?? "Copilot")</span></MudTd>
        <MudTd DataLabel="Model"><span class="mono">@(context.Model ?? "auto")</span></MudTd>
        <MudTd DataLabel="Updated">@context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
        <MudTd Style="text-align:right; white-space:nowrap">
            @if (context.IsDraft)
            {
                <MudTooltip Text="Accept and assign">
                    <MudIconButton Variant="Variant.Text" Color="Color.Primary" Icon="@Icons.Material.Filled.RocketLaunch"
                                   Disabled="_busy" OnClick="() => AcceptAsync(context)" aria-label="Accept and assign" />
                </MudTooltip>
            }
            else if (context.Status == WorkItemStatus.Accepted)
            {
                <MudTooltip Text="Assign agent">
                    <MudIconButton Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.SmartToy"
                                   Disabled="_busy" OnClick="() => AssignAsync(context)" aria-label="Assign agent" />
                </MudTooltip>
            }
            <MudIconButton Variant="Variant.Text" Icon="@(context.IsDraft ? Icons.Material.Filled.Edit : Icons.Material.Filled.Visibility)"
                           Href="@($"/epics/{context.Id}")" title="@(context.IsDraft ? "Edit" : "View")" />
            <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="_busy" OnClick="() => DeleteAsync(context)" title="Delete" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Large" Color="Color.Secondary" />
            <MudText>No epics yet for this repository.</MudText>
            <MudButton Href="/epics/new" Variant="Variant.Text" Color="Color.Primary">Create the first epic</MudButton>
        </MudStack>
    </NoRecordsContent>
</MudTable>

@code {
    private List<Epic> _epics = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _search;
    private WorkItemStatus? _status;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _epics = await EpicService.GetAllAsync(Repository.Current!.FullName);
        }
        catch (Exception ex)
        {
            _error = $"Could not load epics: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private bool Matches(Epic epic) =>
        (_status is null || epic.Status == _status) &&
        (string.IsNullOrWhiteSpace(_search) || epic.Title.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private async Task AcceptAsync(Epic epic)
    {
        if (await EpicActions.ConfirmAcceptAsync(Dialogs, epic, Repository.Current!.FullName) != true)
        {
            return;
        }

        _busy = true;
        try
        {
            EpicActions.Report(Snackbar, await EpicService.AcceptAsync(Repository.Current.FullName, epic.Id));
        }
        catch (Exception ex) when (EpicActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not accept '{epic.Title}': {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
        await LoadAsync();
    }

    private async Task AssignAsync(Epic epic)
    {
        _busy = true;
        try
        {
            EpicActions.Report(Snackbar, await EpicService.AssignAgentAsync(Repository.Current!.FullName, epic.Id));
        }
        catch (Exception ex) when (EpicActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not assign '{epic.Title}': {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
        await LoadAsync();
    }

    private async Task DeleteAsync(Epic epic)
    {
        if (await EpicActions.ConfirmDeleteAsync(Dialogs, epic) != true)
        {
            return;
        }

        try
        {
            await EpicService.DeleteAsync(Repository.Current!.FullName, epic.Id);
            _epics.Remove(epic);
            Snackbar.Add($"Deleted '{epic.Title}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete '{epic.Title}': {ex.Message}", Severity.Error);
        }
    }
}
