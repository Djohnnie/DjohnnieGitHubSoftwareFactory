@page "/work-item-map"
@using System.Globalization
@inject WorkItemService WorkItemService
@inject RepositoryContext Repository
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Work item map</PageTitle>

<PageBreadcrumbs Current="Work item map" />

<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-3">
    <div>
        <MudText Typo="Typo.h4">Work item map</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            All work items of <b>@Repository.Current?.FullName</b> in one view. Expand an epic to put it in the middle with everything below it;
            click an item to open it.
        </MudText>
    </div>
    <MudSpacer />
    <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading" title="Reload" aria-label="Reload" />
</MudStack>

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<div class="map-stage" @ref="_stage">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="map-progress" />
    }
    else if (_layout is { } map && (map.Epics.Count > 0 || map.Loose.Count > 0))
    {
        @if (map.Center is { } expanded)
        {
            var progress = map.Progress(expanded.Id);
            <div class="map-progress-strip" @key="@($"progress-{expanded.Id}")">
                <span class="map-progress-title" title="@expanded.Title">
                    <b>@progress.PercentDone%</b> completed
                </span>
                <div class="map-progress-bar" role="progressbar" aria-label="@($"Completed below {expanded.Title}")"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.PercentDone"
                     aria-valuetext="@($"{progress.PercentDone}% completed: {progress.Done} closed, {progress.Accepted} accepted, {progress.Draft} draft")">
                    @if (progress.Total == 0)
                    {
                        <span class="map-progress-empty">Nothing below this epic yet</span>
                    }
                    else
                    {
                        <span class="map-progress-fill">
                        <span class="map-progress-part status-done" style="@Width(progress.Share(progress.Done))" title="@($"{progress.Done} closed")"></span>
                        <span class="map-progress-part status-accepted" style="@Width(progress.Share(progress.Accepted))" title="@($"{progress.Accepted} accepted or in progress")"></span>
                        <span class="map-progress-part status-draft" style="@Width(progress.Share(progress.Draft))" title="@($"{progress.Draft} draft")"></span>
                        </span>
                    }
                </div>
                <span class="map-progress-counts">
                    <span class="status-done"><i></i>@progress.Done closed</span>
                    <span class="status-accepted"><i></i>@progress.Accepted accepted</span>
                    <span class="status-draft"><i></i>@progress.Draft draft</span>
                </span>
            </div>
        }

        <div class="map-canvas">
            <svg class="map-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @foreach (var edge in map.Edges)
                {
                    <path @key="@($"{_mapKey}-{edge.Key}")" d="@edge.Path" class="map-edge @(map.Center is null ? "map-edge-hub" : null)"
                          style="@($"--c:#{edge.Type.LabelColor}; --delay:{edge.Depth * 110}ms")" />
                }
            </svg>

            @if (map.Center is null)
            {
                <div class="map-hub" @key="@("hub")">
                    <img src="@Repository.Current?.Owner.AvatarUrl" alt="" class="map-hub-avatar" hidden="@(Repository.Current?.Owner.AvatarUrl is null)" />
                    <span class="map-hub-name">@Repository.Current?.Name</span>
                    <span class="map-hub-caption">@Plural(map.Epics.Count, "epic") · @Plural(map.Loose.Count, "standalone item")</span>
                </div>
            }

            @foreach (var node in map.Nodes)
            {
                // Epics keep their element between the hub and the middle, so they glide there; the rest grows from its parent.
                var key = node.Item.Type == WorkItemType.Epic ? node.Item.Id.ToString() : $"{_mapKey}-{node.Item.Id}";
                <div @key="key" class="@NodeClass(node)" style="@NodeStyle(node)">
                    <div class="map-node-body">
                        <a href="@WorkItemRoutes.ItemPath(node.Item.Type, node.Item.Id)" class="map-node-link" title="@Tooltip(node)">
                            <span class="map-badge">
                                <svg viewBox="0 0 24 24" class="map-icon" aria-hidden="true">@((MarkupString)WorkItemRoutes.Icon(node.Item.Type))</svg>
                                @if (node.Item.Status == WorkItemStatus.Done)
                                {
                                    <span class="map-done" aria-hidden="true">
                                        <svg viewBox="0 0 24 24">@((MarkupString)Icons.Material.Filled.Check)</svg>
                                    </span>
                                }
                            </span>
                            <span class="map-label">@node.Item.Title</span>
                        </a>
                        @if (node.Role == WorkItemMapRole.Center)
                        {
                            <span class="map-summary">
                                @foreach (var (type, count) in map.DescendantsByType(node.Item.Id))
                                {
                                    <span style="@($"--c:#{type.LabelColor}")">@count @(count == 1 ? type.DisplayName.ToLowerInvariant() : type.PluralName.ToLowerInvariant())</span>
                                }
                                @if (node.DescendantCount == 0)
                                {
                                    <span>Nothing below this epic yet</span>
                                }
                            </span>
                            <button type="button" class="map-toggle" @onclick="ShowAllEpics" aria-label="Collapse @node.Item.Title" title="Show all epics">
                                <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.Remove)</svg>
                            </button>
                        }
                        else if (node.Role == WorkItemMapRole.Epic)
                        {
                            <button type="button" class="map-toggle" @onclick="() => Expand(node.Item.Id)" aria-label="Expand @node.Item.Title"
                                    title="@($"Expand ({Plural(node.DescendantCount, "item")})")">
                                @if (node.DescendantCount > 0)
                                {
                                    <span class="map-toggle-count">@node.DescendantCount</span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.Add)</svg>
                                }
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="map-legend" aria-hidden="true">
                @foreach (var type in WorkItemTypeRules.All)
                {
                    <span class="map-legend-type" style="@($"--c:#{type.LabelColor}")">
                        <svg viewBox="0 0 24 24">@((MarkupString)WorkItemRoutes.Icon(type))</svg>@type.DisplayName
                    </span>
                }
                <span class="map-legend-status"><i class="map-legend-dot status-draft"></i>Draft</span>
                <span class="map-legend-status"><i class="map-legend-dot status-inprogress"></i>In progress</span>
                <span class="map-legend-status"><i class="map-legend-dot status-done"></i>Closed</span>
            </div>
        </div>

        <nav class="map-dock" aria-label="Epics">
            <button type="button" class="@($"map-dock-item map-dock-hub{(map.Center is null ? " active" : null)}")" @onclick="ShowAllEpics"
                    aria-pressed="@(map.Center is null ? "true" : "false")">
                <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.Hub)</svg>
                <span>All epics</span>
            </button>
            @foreach (var epic in map.Epics)
            {
                var active = map.Center?.Id == epic.Id;
                <button type="button" class="@($"map-dock-item{(active ? " active" : null)}{(epic.Status == WorkItemStatus.Done ? " done" : null)}")"
                        @onclick="() => Expand(epic.Id)" aria-pressed="@(active ? "true" : "false")" title="@epic.Title">
                    <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)WorkItemRoutes.Icon(WorkItemType.Epic))</svg>
                    <span class="map-dock-title">@epic.Title</span>
                    <span class="map-dock-count">@map.DescendantCount(epic.Id)</span>
                </button>
            }
        </nav>
    }
    else if (_error is null)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="map-empty">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Large" Color="Color.Secondary" />
            <MudText>This repository has no work items yet.</MudText>
            <MudButton Href="@WorkItemRoutes.NewPath(WorkItemType.Epic)" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New epic</MudButton>
        </MudStack>
    }
</div>

@code {
    private const string AllEpics = "all";

    /// <summary>The expanded epic's id, or <c>all</c> for the repository hub; without it the first open epic is expanded.</summary>
    [SupplyParameterFromQuery(Name = "epic")]
    public string? Epic { get; set; }

    private List<WorkItem> _items = [];
    private WorkItemMapLayout? _layout;
    private string? _expanded;
    private bool _loading = true;
    private string? _error;

    // Changes with every expansion, so the descendants and lines are new elements that animate in again.
    private int _mapKey;

    // The height of the epics dock below the map, which the stage's measured height includes.
    private const double DockHeight = 53;

    // The height of the progress strip above the map, shown while an epic is expanded.
    private const double ProgressHeight = 41;

    private ElementReference _stage;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<WorkItemMap>? _selfReference;
    private double _width = WorkItemMapLayout.DefaultWidth;
    private double _height = WorkItemMapLayout.DefaultHeight + DockHeight;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/WorkItemMap.razor.js");
            _selfReference = DotNetObjectReference.Create(this);
            _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _stage, _selfReference);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>The browser reports the stage's size: the map spreads its items over that room, or fits them closer together.</summary>
    [JSInvokable]
    public void Resize(double width, double height)
    {
        if (Math.Abs(width - _width) < 1 && Math.Abs(height - _height) < 1)
        {
            return;
        }
        _width = width;
        _height = height;
        if (!_loading)
        {
            Arrange();
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        _selfReference?.Dispose();
    }

    protected override void OnParametersSet()
    {
        // Back and forward (or a link) can change the expanded epic while the page stays.
        if (!_loading && Epic != _expanded)
        {
            _expanded = Epic;
            Arrange();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await WorkItemService.GetAllAsync(Repository.Current!.FullName);
        }
        catch (Exception ex)
        {
            _items = [];
            _error = $"Could not load the work items: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
        _expanded = Epic;
        Arrange();
    }

    private void Arrange()
    {
        Guid? epic = _expanded switch
        {
            AllEpics => null,
            { } value when Guid.TryParse(value, out var id) && _items.Any(i => i.Id == id && i.Type == WorkItemType.Epic) => id,
            _ => WorkItemMapLayout.DefaultEpic(_items)
        };
        if (_layout is null || _layout.Center?.Id != epic)
        {
            _mapKey++;
        }
        _layout = WorkItemMapLayout.Create(_items, epic, _width, _height - DockHeight - (epic is null ? 0 : ProgressHeight));
    }

    private void Expand(Guid epic)
    {
        Show(epic.ToString());
    }

    private void ShowAllEpics()
    {
        Show(AllEpics);
    }

    private void Show(string expanded)
    {
        _expanded = expanded;
        Arrange();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("epic", expanded), replace: true);
    }

    private static string NodeClass(WorkItemMapNode node)
    {
        var role = node.Role switch
        {
            WorkItemMapRole.Center => "map-node-center",
            WorkItemMapRole.Epic => "map-node-epic",
            WorkItemMapRole.Loose => "map-node-loose",
            _ => $"map-node-depth{Math.Min(node.Depth, 3)}"
        };
        var status = node.Item.Status switch
        {
            WorkItemStatus.Draft => "status-draft",
            WorkItemStatus.InProgress => "status-inprogress",
            WorkItemStatus.Done => "status-done",
            _ => "status-accepted"
        };
        return $"map-node {role} {status}{(node.Crowded ? " crowded" : null)}";
    }

    private static string NodeStyle(WorkItemMapNode node)
    {
        return string.Create(CultureInfo.InvariantCulture,
            $"left:{node.X:0.##}%; top:{node.Y:0.##}%; --fx:{node.FromX:0.##}%; --fy:{node.FromY:0.##}%; --scale:{node.Scale:0.###}; --c:#{node.Item.Type.LabelColor}; --delay:{node.Depth * 110}ms");
    }

    private static string Tooltip(WorkItemMapNode node)
    {
        var issue = node.Item.IssueNumber is { } number ? $" · #{number}" : string.Empty;
        return $"{node.Item.Type.DisplayName}: {node.Item.Title} ({WorkItemStatusChip.LabelOf(node.Item.Status)}{issue})";
    }

    private static string Width(double percent)
    {
        return string.Create(CultureInfo.InvariantCulture, $"width:{percent:0.##}%");
    }

    private static string Plural(int count, string noun)
    {
        return $"{count} {noun}{(count == 1 ? string.Empty : "s")}";
    }
}
