@page "/epic-templates/new"
@page "/epic-templates/edit/{Id:int}"
@attribute [RepositoryIndependent]
@inject EpicTemplateService Templates
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(Id is null ? "New epic template" : "Edit epic template")</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />
<MudText Typo="Typo.h4" GutterBottom="true">@(Id is null ? "New epic template" : "Edit epic template")</MudText>

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_template is not null)
{
    <MudForm @ref="_form" Model="_template">
        <MudStack Spacing="4">
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudTextField Variant="Variant.Outlined" @bind-Value="_template.Name" Label="Template name" Required="true"
                              MaxLength="200" Immediate="true" />
                <MudTextField Variant="Variant.Outlined" @bind-Value="_template.TitleTemplate" Label="Title example" Required="true"
                              MaxLength="256" Immediate="true" HelperText="Shown as a placeholder for the epic title, not saved as its actual title." />
            </MudPaper>
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudText Typo="Typo.h6">Description skeleton</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Markdown proposed when creating a new epic, for example headings for goals, scope and acceptance criteria.
                </MudText>
                <MarkdownEditor @bind-Value="_template.Description" MaxLength="Epic.MaxDescriptionLength" />
            </MudPaper>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Stored in DGHSF, not in a repository. Saving does not change existing epics.
            </MudText>
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Outlined" Href="/epic-templates" Disabled="_saving">Cancel</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                           StartIcon="@Icons.Material.Filled.Save">Save template</MudButton>
            </MudStack>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private EpicTemplate? _template;
    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _template = null;
        try
        {
            _template = Id is null ? new EpicTemplate() : await Templates.GetAsync(Id.Value);
            if (_template is null)
            {
                _error = "This epic template does not exist.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load the epic template: {ex.Message}";
        }
        finally
        {
            _breadcrumbs =
            [
                new("Epic templates", "/epic-templates"),
                new(Id is null ? "New" : _template?.Name ?? $"#{Id}", null, disabled: true)
            ];
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_template!.Description))
        {
            Snackbar.Add("A description skeleton is required.", Severity.Warning);
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var template = await Templates.SaveAsync(_template);
            Snackbar.Add($"Saved the template '{template.Name}'.", Severity.Success);
            Navigation.NavigateTo("/epic-templates");
        }
        catch (Exception ex) when (ex is InvalidOperationException or Djohnnie.SoftwareFactory.Contracts.PersistenceException)
        {
            _error = $"Could not save the template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
