@page "/epic-templates/new"
@page "/epic-templates/edit/{Id:int}"
@page "/feature-templates/new"
@page "/feature-templates/edit/{Id:int}"
@page "/story-templates/new"
@page "/story-templates/edit/{Id:int}"
@page "/bug-templates/new"
@page "/bug-templates/edit/{Id:int}"
@page "/task-templates/new"
@page "/task-templates/edit/{Id:int}"
@attribute [RepositoryIndependent]
@inject WorkItemTemplateService Templates
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@Heading</PageTitle>

<PageBreadcrumbs Parents="@([new($"{_type.DisplayName} templates", WorkItemRoutes.TemplatesPath(_type))])"
                 Current="@(Id is null ? "New" : _template?.Name ?? $"#{Id}")" BackDisabled="_saving" />
<MudText Typo="Typo.h4" GutterBottom="true">@Heading</MudText>

@if (!_loading && _template is not null)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                   StartIcon="@Icons.Material.Filled.Save">Save template</MudButton>
        @if (Id is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ResetAsync" Disabled="_saving"
                       StartIcon="@Icons.Material.Filled.Undo">Reset</MudButton>
        }
    </MudStack>
}

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_template is not null)
{
    <MudForm @ref="_form" Model="_template">
        <MudStack Spacing="4">
            <AssistantChat @ref="_chat" @key="@($"{_type}:{Id}")" CopilotKey="@InternalAgentKeys.ForWorkItemTemplate(_type)" Tools="_assistantTools"
                           Owner="@(Id is null ? null : ChatOwner.ForWorkItemTemplate(Id.Value))"
                           Placeholder="@($"Describe the {Name} template you need")"
                           Subtitle="@(Id is null ? $"Describe the {_type.PluralName.ToLowerInvariant()} this template is for; I'll ask what I need to know and fill in the form." : "Ask me to improve this template; I'll update the form.")"
                           Suggestions="@(Id is null ? Suggestions : [])" />
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudTextField Variant="Variant.Outlined" @bind-Value="_template.Name" Label="Template name" Required="true"
                              MaxLength="200" Immediate="true" />
                <DictationTextField @bind-Value="_template.TitleTemplate" Label="Title example" Required="true"
                                    MaxLength="256" HelperText="@($"Shown as a placeholder for the {Name} title, not saved as its actual title.")" />
                <MudSwitch T="bool" @bind-Value="_template.IsDefault" Color="Color.Primary" Class="mt-4" Label="Default template" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Proposed for new @_type.PluralName.ToLowerInvariant() and followed when they are generated. Each type has one default: this replaces the current one.
                </MudText>
            </MudPaper>
            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MarkdownEditor @bind-Value="_template.Description" MaxLength="WorkItem.MaxDescriptionLength" AllowImages="true"
                                Dictation="@(new DescriptionDictation($"{Name} template skeleton", _template.TitleTemplate))">
                    <Header>
                        <MudText Typo="Typo.h6">Description skeleton</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Markdown proposed when creating a new @Name, for example @SkeletonExample.
                        </MudText>
                    </Header>
                </MarkdownEditor>
            </MudPaper>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Stored in DGHSF, not in a repository. Saving does not change existing @_type.PluralName.ToLowerInvariant().
            </MudText>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    /// <summary>Changes on every navigation, so switching between the type pages (which share this component) reloads.</summary>
    [CascadingParameter] private RouteData? RouteData { get; set; }

    private WorkItemType _type;
    private WorkItemTemplate? _template;
    private MudForm? _form;
    private AssistantChat? _chat;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private (WorkItemType Type, int? Id)? _loadedParameters;
    private AssistantTools? _assistantTools;

    private string Name => WorkItemActions.Name(_type);

    private IReadOnlyList<string> Suggestions => _type switch
    {
        WorkItemType.Bug => ["A crash report with steps to reproduce", "A visual glitch template with screenshots", "A performance regression report"],
        WorkItemType.Story => ["A classic user story with Given/When/Then criteria", "A story for an API endpoint", "A UI story with design notes"],
        WorkItemType.Task => ["A technical chore such as a dependency upgrade", "A refactoring task with a clear scope", "A task to add missing tests"],
        WorkItemType.Feature => ["A feature with requirements and acceptance criteria", "A feature behind a feature flag", "An integration with an external service"],
        _ => ["A product epic with goals and success metrics", "A technical epic for a platform migration", "An epic for a new customer-facing area"]
    };
    private string Heading => Id is null ? $"New {Name} template" : $"Edit {Name} template";

    private string SkeletonExample => _type switch
    {
        WorkItemType.Bug => "headings for steps to reproduce, expected and actual behavior",
        WorkItemType.Story => "the \"As a ..., I want ... so that ...\" line and acceptance criteria",
        WorkItemType.Task => "headings for the goal, details and when it is done",
        _ => "headings for goals, scope and acceptance criteria"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (WorkItemRoutes.IsOutOfStep(RouteData, GetType(), Id))
        {
            return;
        }

        var parameters = (WorkItemRoutes.TypeOf(Navigation), Id);
        if (_loadedParameters == parameters)
        {
            return;
        }
        _loadedParameters = parameters;
        _type = parameters.Item1;
        _loading = true;
        _error = null;
        _template = null;
        _assistantTools = null;
        try
        {
            _template = Id is null ? new WorkItemTemplate { Type = _type } : await Templates.GetAsync(Id.Value);
            if (_template is null || _template.Type != _type)
            {
                _template = null;
                _error = $"This {Name} template does not exist.";
            }
            else
            {
                _assistantTools = AssistantForms.ForWorkItemTemplate(
                    () => _template!,
                    change => InvokeAsync(() => { change(); StateHasChanged(); }));
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load the {Name} template: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Loads the stored template again and discards unsaved changes; the Copilot conversation is kept.</summary>
    private async Task ResetAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Reset template", "Discard your changes and load the saved template again?",
                yesText: "Reset", cancelText: "Cancel") != true)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var template = await Templates.GetAsync(Id!.Value);
            if (template is null)
            {
                _error = $"This {Name} template does not exist.";
                return;
            }

            _template = template;
            await _form!.ResetValidationAsync();
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException or Djohnnie.SoftwareFactory.Contracts.PersistenceException)
        {
            _error = $"Could not reset the template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_template!.Description))
        {
            Snackbar.Add("A description skeleton is required.", Severity.Warning);
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var template = await Templates.SaveAsync(_template);
            if (Id is null && _chat is not null)
            {
                await _chat.AttachAsync(ChatOwner.ForWorkItemTemplate(template.Id));
            }
            Snackbar.Add($"Saved the template '{template.Name}'.", Severity.Success);
            Navigation.NavigateTo(WorkItemRoutes.TemplatesPath(_type));
        }
        catch (Exception ex) when (ex is Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException or Djohnnie.SoftwareFactory.Contracts.PersistenceException)
        {
            _error = $"Could not save the template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
