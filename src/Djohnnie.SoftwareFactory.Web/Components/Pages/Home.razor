@page "/"
@inject RepositoryContext Repository

<PageTitle>DGHSF</PageTitle>

@if (Repository.Current is { } repo)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-6">
        <MudAvatar Size="Size.Large"><MudImage Src="@repo.Owner.AvatarUrl" Alt="" /></MudAvatar>
        <div>
            <MudText Typo="Typo.h4">@repo.FullName</MudText>
            @if (!string.IsNullOrEmpty(repo.Description))
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">@repo.Description</MudText>
            }
        </div>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-6" Wrap="Wrap.Wrap">
        <MudChip Variant="Variant.Outlined" T="string" Icon="@(repo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)">@(repo.Private ? "Private" : "Public")</MudChip>
        @if (!string.IsNullOrEmpty(repo.Language))
        {
            <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.Code">@repo.Language</MudChip>
        }
        @if (!string.IsNullOrEmpty(repo.DefaultBranch))
        {
            <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.AccountTree">@repo.DefaultBranch</MudChip>
        }
        @if (repo.PushedAt is { } pushedAt)
        {
            <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.Schedule">Last push @pushedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudChip>
        }
        <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Custom.Brands.GitHub" Href="@repo.HtmlUrl" Target="_blank">Open on GitHub</MudChip>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Elevation="0" Class="overview-tile">
                <MudCardHeader>
                    <CardHeaderAvatar><MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" /></CardHeaderAvatar>
                    <CardHeaderContent><MudText Typo="Typo.h6">Custom agents</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2">Create, edit and delete the Copilot agent profiles in <code>.github/agents</code>.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Href="/agents" Color="Color.Primary">Manage agents</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        @foreach (var type in WorkItemTypeRules.All)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Elevation="0" Class="overview-tile">
                    <MudCardHeader>
                        <CardHeaderAvatar><MudIcon Icon="@WorkItemRoutes.Icon(type)" Color="Color.Primary" /></CardHeaderAvatar>
                        <CardHeaderContent><MudText Typo="Typo.h6">@type.PluralName</MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">@TileText(type)</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Href="@WorkItemRoutes.ListPath(type)" Color="Color.Primary">Manage @type.PluralName.ToLowerInvariant()</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private static string TileText(WorkItemType type)
    {
        return type switch
        {
            WorkItemType.Epic => "Structure the work in epics; accepting one creates a labelled GitHub issue.",
            WorkItemType.Feature => "Split epics into features; their issues become sub-issues of the epic.",
            WorkItemType.Story => "Write user stories per feature and hand them to the Copilot cloud agent.",
            WorkItemType.Bug => "Report bugs, standalone or as part of an epic, feature or story, and let Copilot fix them.",
            _ => "Plan technical tasks, standalone or as part of an epic, feature or story, for Copilot to pick up."
        };
    }
}
