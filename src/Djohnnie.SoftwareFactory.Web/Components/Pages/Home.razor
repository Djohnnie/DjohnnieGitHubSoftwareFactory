@page "/"
@inject RepositoryContext Repository

<PageTitle>DGHSF</PageTitle>

@if (Repository.Current is { } repo)
{
    <PageBreadcrumbs />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-6">
        <MudAvatar Size="Size.Large" Color="Color.Primary">
            @if (Repository.IsRemovedFromGitHub || repo.Owner.AvatarUrl is null)
            {
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
            }
            else
            {
                <MudImage Src="@repo.Owner.AvatarUrl" Alt="" />
            }
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h4">@repo.FullName</MudText>
            @if (!string.IsNullOrEmpty(repo.Description))
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">@repo.Description</MudText>
            }
        </div>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-6" Wrap="Wrap.Wrap">
        @if (Repository.IsRemovedFromGitHub)
        {
            <MudChip Variant="Variant.Text" T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Inventory2">Removed from GitHub</MudChip>
        }
        else
        {
            <MudChip Variant="Variant.Text" T="string" Color="@(repo.Private ? Color.Warning : Color.Success)" Icon="@(repo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)">@(repo.Private ? "Private" : "Public")</MudChip>
        }
        @if (!string.IsNullOrEmpty(repo.Language))
        {
            <MudChip Variant="Variant.Text" T="string" Color="Color.Tertiary" Icon="@Icons.Material.Filled.Code">@repo.Language</MudChip>
        }
        @if (!string.IsNullOrEmpty(repo.DefaultBranch))
        {
            <MudChip Variant="Variant.Text" T="string" Color="Color.Info" Icon="@Icons.Material.Filled.AccountTree">@repo.DefaultBranch</MudChip>
        }
        @if (repo.PushedAt is { } pushedAt)
        {
            <MudChip Variant="Variant.Text" T="string" Color="Color.Secondary" Icon="@Icons.Material.Filled.Schedule">Last push @pushedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudChip>
        }
        @if (!Repository.IsRemovedFromGitHub)
        {
            <MudChip Variant="Variant.Text" T="string" Color="Color.Primary" Icon="@Icons.Custom.Brands.GitHub" Href="@repo.HtmlUrl" Target="_blank">Open on GitHub</MudChip>
        }
    </MudStack>

    @* Only the work item counts come from the database; the rest is read from GitHub, which no longer knows a removed repository. *@
    <RepositoryInfographic RepositoryFullName="@repo.FullName" GitHubAvailable="@(!Repository.IsRemovedFromGitHub)" />
    @if (!Repository.IsRemovedFromGitHub)
    {
        <WorkflowRunsInfographic Repository="@repo" />
        <CopilotSessionsInfographic Repository="@repo" />
        <CopilotActivityInfographic Repository="@repo" />
        <CopilotBillingInfographic Repository="@repo" />
    }
}
