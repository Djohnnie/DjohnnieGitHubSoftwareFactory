@page "/"
@inject RepositoryContext Repository

<PageTitle>DGHSF</PageTitle>

@if (Repository.Current is { } repo)
{
    <PageBreadcrumbs />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-6">
        <MudAvatar Size="Size.Large"><MudImage Src="@repo.Owner.AvatarUrl" Alt="" /></MudAvatar>
        <div>
            <MudText Typo="Typo.h4">@repo.FullName</MudText>
            @if (!string.IsNullOrEmpty(repo.Description))
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">@repo.Description</MudText>
            }
        </div>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-6" Wrap="Wrap.Wrap">
        <MudChip Variant="Variant.Outlined" T="string" Icon="@(repo.Private ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)">@(repo.Private ? "Private" : "Public")</MudChip>
        @if (!string.IsNullOrEmpty(repo.Language))
        {
            <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.Code">@repo.Language</MudChip>
        }
        @if (!string.IsNullOrEmpty(repo.DefaultBranch))
        {
            <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.AccountTree">@repo.DefaultBranch</MudChip>
        }
        @if (repo.PushedAt is { } pushedAt)
        {
            <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.Schedule">Last push @pushedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudChip>
        }
        <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Custom.Brands.GitHub" Href="@repo.HtmlUrl" Target="_blank">Open on GitHub</MudChip>
    </MudStack>

    <RepositoryInfographic RepositoryFullName="@repo.FullName" />
    <CopilotSessionsInfographic Repository="@repo" />
    <CopilotActivityInfographic Repository="@repo" />
    <CopilotBillingInfographic Repository="@repo" />

    <MudGrid>
        @Tile(Icons.Material.Filled.IntegrationInstructions, "Copilot instructions",
              @<text>Edit the repository-wide custom instructions in <code>@CopilotInstructionsFile.Path</code> that Copilot adds to every chat, cloud agent and code review.</text>,
              "/copilot-instructions", "Edit instructions")
        @Tile(Icons.Material.Filled.SmartToy, "Custom agents",
              @<text>Create, edit and delete the Copilot agent profiles in <code>.github/agents</code>.</text>,
              "/agents", "Manage agents", "/agent-templates")

        <MudItem xs="12"><MudDivider /></MudItem>

        @foreach (var type in WorkItemTypeRules.All)
        {
            @Tile(WorkItemRoutes.Icon(type), type.PluralName, @<text>@TileText(type)</text>,
                  WorkItemRoutes.ListPath(type), $"Manage {type.PluralName.ToLowerInvariant()}", WorkItemRoutes.TemplatesPath(type))
        }

        <MudItem xs="12"><MudDivider /></MudItem>

        @Tile(Icons.Material.Filled.Psychology, "Internal agents",
              @<text>Tune the system prompts of DGHSF's own copilots and background agents, shared across repositories.</text>,
              "/internal-agents", "Manage internal agents")
        @Tile(Icons.Material.Filled.Memory, "Models",
              @<text>Choose the AI models available to custom agents and keep their prices per 1M tokens up to date.</text>,
              "/models", "Manage models")
    </MudGrid>
}

@code {
    private static RenderFragment Tile(string icon, string title, RenderFragment text, string href, string label, string? templatesHref = null)
    {
        return @<MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Elevation="0" Class="overview-tile">
                <MudCardHeader>
                    <CardHeaderAvatar><MudIcon Icon="@icon" Color="Color.Primary" /></CardHeaderAvatar>
                    <CardHeaderContent><MudText Typo="Typo.h6">@title</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2">@text</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Href="@href" Color="Color.Primary">@label</MudButton>
                    @if (templatesHref is not null)
                    {
                        <MudButton Variant="Variant.Text" Href="@templatesHref" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.LibraryBooks">Templates</MudButton>
                    }
                </MudCardActions>
            </MudCard>
        </MudItem>;
    }

    private static string TileText(WorkItemType type)
    {
        return type switch
        {
            WorkItemType.Epic => "Structure the work in epics; accepting one creates a labelled GitHub issue.",
            WorkItemType.Feature => "Split epics into features; their issues become sub-issues of the epic.",
            WorkItemType.Story => "Write user stories per feature and hand them to the Copilot cloud agent.",
            WorkItemType.Bug => "Report bugs, standalone or as part of an epic, feature or story, and let Copilot fix them.",
            _ => "Plan technical tasks, standalone or as part of an epic, feature or story, for Copilot to pick up."
        };
    }
}
