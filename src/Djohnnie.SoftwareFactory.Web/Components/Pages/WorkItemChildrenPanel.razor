@* The work item editor's children box: the items that are part of this one, buttons to add them, and Generate. *@

<MudPaper Class="pa-4" Outlined="true" Elevation="0" aria-label="Children">
    <MudText Typo="Typo.h6">Part of this @Name</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Accepted children become sub-issues of this @Name's issue on GitHub.
    </MudText>
    @if (Children.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-2">Nothing yet.</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-2">
            <tbody>
                @foreach (var child in Children)
                {
                    <tr>
                        <td style="width:1%; white-space:nowrap"><WorkItemTypeChip Type="child.Type" /></td>
                        <td><MudLink Href="@WorkItemRoutes.ItemPath(child.Type, child.Id)">@child.Title</MudLink></td>
                        <td style="width:1%; white-space:nowrap"><WorkItemStatusChip Status="child.Status" /></td>
                        <td style="width:1%; white-space:nowrap">
                            @if (child.IssueNumber is { } childNumber)
                            {
                                <GitHubLink Href="@child.IssueUrl">#@childNumber</GitHubLink>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
        @foreach (var childType in Item.Type.ChildTypes)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Href="@WorkItemRoutes.NewPath(childType, parentId: Item.Id)">Add @WorkItemActions.Name(childType)</MudButton>
        }
        @if (GeneratorActive && Item.Type.GeneratedChildType is { } generatedType)
        {
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="Generate" Disabled="Busy"
                       title="@($"Saves your changes, then lets an agent propose {generatedType.PluralName.ToLowerInvariant()} for you to review.")">Generate @generatedType.PluralName.ToLowerInvariant()</MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public WorkItem Item { get; set; } = null!;

    [Parameter] public IReadOnlyList<WorkItem> Children { get; set; } = [];

    /// <summary>The Work Item Breakdown agent is configured and enabled, so Generate is shown.</summary>
    [Parameter] public bool GeneratorActive { get; set; }

    [Parameter] public bool Busy { get; set; }

    /// <summary>Generate was clicked; the page saves the item and opens the generator.</summary>
    [Parameter] public EventCallback Generate { get; set; }

    private string Name
    {
        get
        {
            return WorkItemActions.Name(Item.Type);
        }
    }
}
