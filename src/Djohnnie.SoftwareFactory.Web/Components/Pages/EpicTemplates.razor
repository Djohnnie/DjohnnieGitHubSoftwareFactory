@page "/epic-templates"
@attribute [RepositoryIndependent]
@inject EpicTemplateService Templates
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Epic templates</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Epic templates</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Reusable title examples and Markdown skeletons, shared across repositories. New epics start with the first template alphabetically.
        </MudText>
    </div>
    <MudStack Row="true">
        <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading" title="Reload" />
        <MudButton Href="/epic-templates/new" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New template</MudButton>
    </MudStack>
</MudStack>

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudTable Outlined="true" T="EpicTemplate" Items="_templates" Loading="_loading" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Template</MudTh>
        <MudTh>Title example</MudTh>
        <MudTh>Updated</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Template"><MudLink Href="@($"/epic-templates/edit/{context.Id}")">@context.Name</MudLink></MudTd>
        <MudTd DataLabel="Title example">@context.TitleTemplate</MudTd>
        <MudTd DataLabel="Updated">@context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
        <MudTd Style="text-align:right; white-space:nowrap">
            <MudTooltip Text="Create an epic from this template">
                <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary"
                               Href="@($"/epics/new?template={context.Id}")" aria-label="Create epic" />
            </MudTooltip>
            <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Edit" Href="@($"/epic-templates/edit/{context.Id}")" title="Edit" />
            <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteAsync(context)" title="Delete" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-6">There are no epic templates yet. Create one to propose a structure for new epics.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<EpicTemplate> _templates = [];
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _templates = await Templates.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load the epic templates: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(EpicTemplate template)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete epic template",
            $"Delete '{template.Name}'? Epics created from it are not affected.",
            yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Templates.DeleteAsync(template.Id);
            _templates.Remove(template);
            Snackbar.Add($"Deleted the template '{template.Name}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete '{template.Name}': {ex.Message}", Severity.Error);
        }
    }
}
