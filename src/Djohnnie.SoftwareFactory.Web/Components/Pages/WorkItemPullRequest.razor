@inject WorkItemService WorkItemService
@using Djohnnie.SoftwareFactory.Application.Features.Uploads
@inject ImageUploadService ImageUploads
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* One tab of a work item's pull request: the diff with line comments, or the discussion with a form to send feedback to its
   agent: Copilot (an @copilot comment or review), or, on a pull request the DGHSF agent worker opened, the worker (the comment
   or review without a mention, and a revision run). Both tabs share the State, which is loaded the first time one of them is shown. *@
<MudPaper Class="pa-4" Outlined="true" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h6">
            Pull request <MudLink Href="@Item.PullRequestUrl" Target="_blank">#@Item.PullRequestNumber</MudLink>
        </MudText>
        @if (Changes is not null)
        {
            <MudText Typo="Typo.body2" Class="mono">@Changes.Title</MudText>
            <MudText Typo="Typo.body2">
                <span class="pr-additions">+@Changes.Additions</span> <span class="pr-deletions">−@Changes.Deletions</span>
                in @Changes.Files.Count @(Changes.Files.Count == 1 ? "file" : "files")
            </MudText>
            @if (!Changes.IsOpen)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(Changes.IsMerged ? Color.Success : Color.Default)">@(Changes.IsMerged ? "Merged" : "Closed")</MudChip>
            }
            else
            {
                @if (Changes.IsDraft)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Draft</MudChip>
                }
                var (decision, decisionColor) = DecisionChip(Changes.Review.Decision);
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="decisionColor" Class="pr-review-decision">@decision</MudChip>
                @if (Changes.Review.CopilotReviewRequested)
                {
                    <MudTooltip Text="@CopilotReviewingHint">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassTop"
                                 Class="pr-copilot-reviewing">Copilot reviewing</MudChip>
                    </MudTooltip>
                }
                @if (MergeChip(Changes.Review.MergeState) is { } merge)
                {
                    <MudTooltip Text="@merge.Hint">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="merge.Color" Class="pr-merge-state">@merge.Text</MudChip>
                    </MudTooltip>
                }
            }
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync" Disabled="State.Loading || State.Sending"
                   StartIcon="@Icons.Material.Filled.Refresh">@(Changes is null ? "Load" : "Reload")</MudButton>
    </MudStack>

    @if (State.Loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }
    @if (State.Error is not null)
    {
        <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Dense="true" Class="mt-2">@State.Error</MudAlert>
    }

    @if (Changes is not null && Section == PullRequestSection.Changes)
    {
        @if (Changes.FilesTruncated)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-2">
                GitHub lists only the first 3,000 files of a pull request; see the rest on GitHub.
            </MudAlert>
        }
        @if (State.Pending.Count > 0)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-2">
                @State.Pending.Count line @(State.Pending.Count == 1 ? "comment is" : "comments are") pending. They are sent to Copilot as one review
                from the <MudLink OnClick="() => OnNavigate.InvokeAsync(PullRequestSection.Discussion)">discussion</MudLink>.
            </MudAlert>
        }

        <div class="pr-files mt-3">
            @foreach (var file in Changes.Files)
            {
                var expanded = State.Expanded.Contains(file.FileName);
                <div class="pr-file">
                    <div class="pr-file-header" @onclick="() => Toggle(file.FileName)" role="button" aria-expanded="@(expanded ? "true" : "false")">
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <span class="mono pr-file-name">
                            @if (file.PreviousFileName is { } previous)
                            {
                                <span>@previous → </span>
                            }
                            @file.FileName
                        </span>
                        <span class="pr-file-status">@file.Status</span>
                        <span class="pr-additions">+@file.Additions</span>
                        <span class="pr-deletions">−@file.Deletions</span>
                        @if (PendingFor(file.FileName) is > 0 and var pending)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@pending pending</MudChip>
                        }
                    </div>
                    @if (expanded)
                    {
                        @if (file.Patch is null)
                        {
                            <div class="pr-note">
                                No diff to show (a binary file or a diff that is too large).
                                @if (file.BlobUrl is not null)
                                {
                                    <MudLink Href="@file.BlobUrl" Target="_blank">View the file on GitHub</MudLink>
                                }
                            </div>
                        }
                        else
                        {
                            <table class="pr-diff">
                                <tbody>
                                    @foreach (var line in State.Patches[file.FileName])
                                    {
                                        <tr class="@RowClass(line)">
                                            <td class="pr-num">@line.OldLine</td>
                                            <td class="pr-num">@line.NewLine</td>
                                            <td class="pr-gutter">
                                                @if (State.CanSendFeedback && line.CanComment)
                                                {
                                                    <button type="button" class="pr-add" title="Comment on this line" aria-label="Comment on line @line.CommentLine"
                                                            @onclick="() => StartComment(file.FileName, line)">+</button>
                                                }
                                            </td>
                                            <td class="pr-code"><span class="pr-sign">@Sign(line)</span>@line.Text</td>
                                        </tr>
                                        @foreach (var existing in ExistingOn(file.FileName, line))
                                        {
                                            <tr class="pr-thread">
                                                <td colspan="4">
                                                    <div class="pr-comment @CommentClass(existing)">
                                                        @if (existing.IsReply)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Class="pr-reply-icon" />
                                                        }
                                                        <PullRequestAuthor Login="@existing.AuthorLogin" Kind="existing.AuthorKind" />
                                                        <MudLink Href="@existing.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="existing.CreatedAt" /></MudLink>
                                                        <div class="pr-comment-body pr-markdown">@CommentHtml(existing)</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var comment in PendingOn(file.FileName, line))
                                        {
                                            <tr class="pr-thread">
                                                <td colspan="4">
                                                    <div class="pr-comment pr-comment-pending">
                                                        <b>Pending</b>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="State.Sending"
                                                                       OnClick="() => RemoveComment(comment)" aria-label="Remove comment" />
                                                        <div class="pr-comment-body">@comment.Body</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (IsDraftTarget(file.FileName, line))
                                        {
                                            <tr class="pr-thread">
                                                <td colspan="4">
                                                    <div class="pr-comment">
                                                        <DictationTextField @bind-Value="_draftText" Label="@($"Comment on line {line.CommentLine}")"
                                                                      Lines="3" Immediate="true" MaxLength="PullRequestFeedback.MaxBodyLength" />
                                                        <MudStack Row="true" Class="mt-1">
                                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_draftText)"
                                                                       OnClick="AddComment">Add comment</MudButton>
                                                            <MudButton Variant="Variant.Text" OnClick="CancelComment">Cancel</MudButton>
                                                        </MudStack>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            }
        </div>
    }

    @if (Changes is not null && Section == PullRequestSection.Discussion)
    {
        @if (State.CanSendFeedback)
        {
            var readiness = MergeReadiness(Item, Changes);
            var mergeBlocked = MergeBlocked(Item, Changes);
            @* First on the tab: the "can be merged" banner at the top of the work item links here. *@
            <MudPaper Class="pa-4 mt-3 pr-merge-card" Outlined="true" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.MergeType" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1"><b>Merge and close pull request #@Changes.Number</b></MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Class="mt-2">
                    Merging puts the pull request's changes on its base branch and closes it, just like the merge button on GitHub. It's done as you,
                    so it also works on a pull request you opened yourself.
                </MudText>
                <MudAlert Variant="Variant.Text" Severity="readiness.Severity" Dense="true" Class="mt-2 pr-merge-readiness">@readiness.Text</MudAlert>
                <MudStack Row="true" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Spacing="3" Class="mt-2">
                    <MudSelect T="PullRequestMergeMethod" Value="State.MergeMethod" ValueChanged="ChangeMergeMethod" Label="How to merge" Dense="true" Variant="Variant.Outlined"
                               Disabled="@(State.Sending || mergeBlocked)" Class="pr-merge-method" Style="min-width: 260px; max-width: 320px"
                               HelperText="@MergeMethodHelp(State.MergeMethod)">
                        <MudSelectItem Value="PullRequestMergeMethod.Merge">Create a merge commit</MudSelectItem>
                        <MudSelectItem Value="PullRequestMergeMethod.Squash">Squash and merge</MudSelectItem>
                        <MudSelectItem Value="PullRequestMergeMethod.Rebase">Rebase and merge</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.MergeType" OnClick="MergeAsync"
                               Disabled="@(State.Sending || mergeBlocked)" Class="pr-merge mb-5">Merge and close</MudButton>
                    @if (State.Sending)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mb-6" />
                    }
                </MudStack>
            </MudPaper>
        }

        @if (Changes.Description is { } description)
        {
            @* The opening post, as on GitHub: the DGHSF agent worker writes its summary and screenshots there. *@
            <div class="pr-comment pr-description mt-2 @CommentClass(description)">
                <PullRequestAuthor Login="@description.AuthorLogin" Kind="description.AuthorKind" /> opened the pull request
                · <MudLink Href="@description.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="description.CreatedAt" /></MudLink>
                <div class="pr-comment-body pr-markdown">@CommentHtml(description)</div>
            </div>
        }
        @if (Changes.Comments.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">No comments yet.</MudText>
        }
        @* As on GitHub: conversation comments on their own, and each line comment with its answers in one thread. *@
        @foreach (var entry in Timeline(Changes.Comments))
        {
            var first = entry[0];
            if (first.Path is null)
            {
                <div class="pr-comment mt-2 @CommentClass(first)">
                    @if (first.ReviewState is not null)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Small" Class="pr-review-icon" />
                    }
                    <PullRequestAuthor Login="@first.AuthorLogin" Kind="first.AuthorKind" />
                    @if (first.ReviewState is { } state)
                    {
                        <span class="pr-review-verdict"> @ReviewEntryVerdict(state)</span>
                    }
                    · <MudLink Href="@first.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="first.CreatedAt" /></MudLink>
                    <div class="pr-comment-body pr-markdown">@CommentHtml(first)</div>
                </div>
            }
            else
            {
                var root = entry.FirstOrDefault(c => !c.IsReply);
                var replies = entry.Count(c => c.IsReply);
                var code = CodeOf(root ?? first);
                <div class="pr-thread-card mt-2">
                    <div class="pr-thread-location">
                        <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                        <span class="mono">@first.Path@LinesOf(root ?? first)</span>
                        @if (replies > 0)
                        {
                            <span class="pr-thread-count">· @replies @(replies == 1 ? "reply" : "replies")</span>
                        }
                    </div>
                    @if (code.Count > 0)
                    {
                        @* The lines the thread is about, as they were when it started (GitHub's diff hunk). *@
                        <div class="pr-thread-code">
                            <table class="pr-diff">
                                <tbody>
                                    @foreach (var codeLine in code)
                                    {
                                        <tr class="@RowClass(codeLine)">
                                            <td class="pr-num">@codeLine.OldLine</td>
                                            <td class="pr-num">@codeLine.NewLine</td>
                                            <td class="pr-code"><span class="pr-sign">@Sign(codeLine)</span>@codeLine.Text</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @foreach (var comment in entry)
                    {
                        <div class="pr-comment @CommentClass(comment)">
                            @if (comment.IsReply)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Class="pr-reply-icon" />
                            }
                            <PullRequestAuthor Login="@comment.AuthorLogin" Kind="comment.AuthorKind" />
                            @if (comment.IsReply && root is not null)
                            {
                                <span class="pr-reply-to">replied to @PullRequestAuthor.NameOf(root.AuthorLogin, root.AuthorKind)</span>
                            }
                            · <MudLink Href="@comment.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="comment.CreatedAt" /></MudLink>
                            <div class="pr-comment-body pr-markdown">@CommentHtml(comment)</div>
                        </div>
                    }
                </div>
            }
        }

        <MudText Typo="Typo.subtitle1" Class="mt-4"><b>Reviews</b></MudText>
        @if (Changes.Review.CopilotReviewRequested)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.HourglassTop" Class="mb-2 pr-copilot-review-pending">
                @CopilotReviewingHint Reload to see it once it's in.
            </MudAlert>
        }
        @if (Changes.Review.Reviewers.Count == 0 && !Changes.Review.CopilotReviewRequested)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nobody reviewed this pull request yet.</MudText>
        }
        else
        {
            <ul class="pr-reviewers">
                @foreach (var reviewer in Changes.Review.Reviewers)
                {
                    <li>
                        <PullRequestAuthor Login="@reviewer.Login" Kind="reviewer.Kind" /> @ReviewerVerdict(reviewer.State)
                        @if (reviewer.SubmittedAt is { } submitted)
                        {
                            <span> · </span>
                            @if (reviewer.Url is not null)
                            {
                                <MudLink Href="@reviewer.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="submitted" /></MudLink>
                            }
                            else
                            {
                                <TimeAgo At="submitted" />
                            }
                        }
                    </li>
                }
            </ul>
        }

        @if (State.CanSendFeedback)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4"><b>Feedback for @AgentTitle</b></MudText>
            @if (State.SentUrl is not null)
            {
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="CloseSent">
                    Feedback sent. <MudLink Href="@State.SentUrl" Target="_blank">View it on GitHub</MudLink>; @(Changes.OpenedByWorker
                        ? "follow the agent's revision run on the work item."
                        : "refresh the work item to follow Copilot's progress.")
                </MudAlert>
            }
            <DictationTextField Value="@State.Body" ValueChanged="ChangeBody" Label="@($"What should {AgentName} change?")" Lines="4"
                          Immediate="true" MaxLength="PullRequestFeedback.MaxBodyLength" Disabled="State.Sending" />
            <MudCheckBox T="bool" Value="State.RequestChanges" ValueChanged="ChangeRequestChanges" Label="Mark the pull request as &quot;Changes requested&quot; (can block merging)"
                         Disabled="State.Sending" Dense="true" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                @if (Changes.OpenedByWorker)
                {
                    <text>
                        Posted as you on pull request #@Changes.Number. @FeedbackKind()
                        Then the DGHSF agent worker starts a revision run on the pull request's branch: it merges the latest base branch into it,
                        addresses this and every other comment written since its last run, pushes to the same branch and answers each comment.
                        It uses the work item's model.
                    </text>
                }
                else
                {
                    <text>
                        Posted as you on pull request #@Changes.Number, starting with @WorkItemPullRequests.CopilotMention.
                        @FeedbackKind()
                        Copilot uses the model that created the pull request.
                    </text>
                }
            </MudText>
            @if (State.Pending.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    The line comments are the ones you wrote on the <MudLink Typo="Typo.caption" OnClick="() => OnNavigate.InvokeAsync(PullRequestSection.Changes)">changes</MudLink>.
                </MudText>
            }
            <MudStack Row="true" Class="mt-2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="SendAsync"
                           Disabled="@(State.Sending || (string.IsNullOrWhiteSpace(State.Body) && State.Pending.Count == 0))">Send to @AgentName</MudButton>
                @if (State.Pending.Count > 0)
                {
                    <MudButton Variant="Variant.Text" OnClick="ClearComments" Disabled="State.Sending">Discard line comments</MudButton>
                }
                @if (State.Sending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
            </MudStack>
        }
        else if (!Changes.IsOpen)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">
                The pull request is @(Changes.IsMerged ? "merged" : "closed"), so @AgentName no longer works on it.
            </MudText>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string RepositoryName { get; set; } = string.Empty;

    /// <summary>A work item with a pull request (<see cref="WorkItem.PullRequestNumber"/> set).</summary>
    [Parameter, EditorRequired] public WorkItem Item { get; set; } = null!;

    /// <summary>The pull request as loaded, shared with the other tab.</summary>
    [Parameter, EditorRequired] public WorkItemPullRequestState State { get; set; } = null!;

    [Parameter] public PullRequestSection Section { get; set; }

    /// <summary>Whether this tab is shown: the pull request is loaded the first time it is.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Asks to show the other tab, e.g. to send the pending line comments from the discussion.</summary>
    [Parameter] public EventCallback<PullRequestSection> OnNavigate { get; set; }

    /// <summary>Raised after the pull request was merged, so the work item can refresh its progress.</summary>
    [Parameter] public EventCallback OnMerged { get; set; }

    /// <summary>Raised after feedback started a revision run of the DGHSF agent worker, so the work item can show the run.</summary>
    [Parameter] public EventCallback OnAgentRunStarted { get; set; }

    private (string Path, DiffSide Side, int Line)? _draftTarget;
    private string? _draftText;
    private int? _draftNumber;

    private PullRequestChanges? Changes
    {
        get
        {
            return State.Changes;
        }
    }

    /// <summary>Who acts on the feedback, in a sentence: Copilot, or the DGHSF agent worker on a pull request it opened.</summary>
    private string AgentName
    {
        get
        {
            return Changes?.OpenedByWorker == true ? "the agent" : "Copilot";
        }
    }

    private string AgentTitle
    {
        get
        {
            return Changes?.OpenedByWorker == true ? "the DGHSF agent" : "Copilot";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        State.Follow(Item.PullRequestNumber);
        if (_draftNumber != State.Number)
        {
            _draftNumber = State.Number;
            CancelComment();
        }
        if (Active && State.NeedsLoading)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        await State.LoadAsync(RepositoryName, Item.Id);
    }

    private void Toggle(string fileName)
    {
        if (!State.Expanded.Remove(fileName))
        {
            State.Expanded.Add(fileName);
        }
    }

    private void StartComment(string path, DiffLine line)
    {
        _draftTarget = (path, line.Side, line.CommentLine!.Value);
        _draftText = PendingOn(path, line).FirstOrDefault()?.Body;
    }

    private bool IsDraftTarget(string path, DiffLine line)
    {
        return line.CanComment && _draftTarget == (path, line.Side, line.CommentLine!.Value);
    }

    private void AddComment()
    {
        if (_draftTarget is not { } target || string.IsNullOrWhiteSpace(_draftText))
        {
            return;
        }
        // One pending comment per line: commenting again replaces it.
        State.Pending.RemoveAll(c => c.Path == target.Path && c.Side == target.Side && c.Line == target.Line);
        State.Pending.Add(new(target.Path, target.Line, target.Side, _draftText.Trim()));
        CancelComment();
        State.NotifyChanged();
    }

    private void CancelComment()
    {
        _draftTarget = null;
        _draftText = null;
    }

    private void RemoveComment(PullRequestLineComment comment)
    {
        State.Pending.Remove(comment);
        State.NotifyChanged();
    }

    private void ClearComments()
    {
        State.Pending.Clear();
        CancelComment();
        State.NotifyChanged();
    }

    private void ChangeBody(string? body)
    {
        State.Body = body;
    }

    private void ChangeRequestChanges(bool requestChanges)
    {
        State.RequestChanges = requestChanges;
    }

    /// <summary>What the feedback becomes on GitHub, as the caption under the feedback box says it.</summary>
    private string FeedbackKind()
    {
        var count = State.Pending.Count;
        var lineComments = $"{count} line {(count == 1 ? "comment" : "comments")}";
        if (State.RequestChanges)
        {
            return $"It becomes a \"Request changes\" review with {lineComments}. GitHub shows the pull request as \"Changes requested\" "
                + "and, if the repository requires approving reviews, blocks merging until the review is dismissed or another reviewer approves. "
                + $"{char.ToUpperInvariant(AgentName[0])}{AgentName[1..]} acts on the feedback either way.";
        }

        return count == 0
            ? "It becomes a comment in the conversation."
            : $"It becomes one review with {lineComments}.";
    }

    private void CloseSent()
    {
        State.SentUrl = null;
    }

    private IEnumerable<PullRequestLineComment> PendingOn(string path, DiffLine line)
    {
        if (!line.CanComment)
        {
            return [];
        }
        return State.Pending.Where(c => c.Path == path && c.Side == line.Side && c.Line == line.CommentLine);
    }

    private int PendingFor(string path)
    {
        return State.Pending.Count(c => c.Path == path);
    }

    /// <summary>GitHub's line comments that are on this line of the new file (where comments usually are), each thread's answers under it.</summary>
    private IEnumerable<PullRequestComment> ExistingOn(string path, DiffLine line)
    {
        if (Changes is null || line.Kind is not (DiffLineKind.Added or DiffLineKind.Context))
        {
            return [];
        }
        return Changes.Comments
            .Where(c => c.Path == path && c.Line == line.NewLine)
            .GroupBy(c => c.ThreadId)
            .SelectMany(thread => thread.OrderBy(c => c.CreatedAt));
    }

    /// <summary>
    /// The discussion in the order it happened: each conversation comment on its own, and each line comment thread as one entry
    /// with its answers (oldest first), placed where the thread started.
    /// </summary>
    private static List<List<PullRequestComment>> Timeline(IReadOnlyList<PullRequestComment> comments)
    {
        var conversation = comments.Where(c => c.ThreadId is null).Select(c => new List<PullRequestComment> { c });
        var threads = comments.Where(c => c.ThreadId is not null)
            .GroupBy(c => c.ThreadId)
            .Select(thread => thread.OrderBy(c => c.CreatedAt).ToList());
        return conversation.Concat(threads).OrderBy(entry => entry[0].CreatedAt).ToList();
    }

    /// <summary>Lines of context GitHub shows above a thread on one line.</summary>
    private const int ThreadContextLines = 4;

    /// <summary>The most lines shown above a thread on a range, so a long range doesn't push the discussion away.</summary>
    private const int MaxThreadCodeLines = 15;

    /// <summary>
    /// The end of the comment's diff hunk, which ends at the line it is on, as GitHub shows it above the thread: the commented
    /// range, or a few lines of context for a comment on one line.
    /// </summary>
    private static IReadOnlyList<DiffLine> CodeOf(PullRequestComment comment)
    {
        var lines = DiffPatch.Parse(comment.DiffHunk).Where(l => l.Kind != DiffLineKind.Hunk).ToList();
        var count = comment is { StartLine: { } start, Line: { } end } && end > start
            ? Math.Min(end - start + 1, MaxThreadCodeLines)
            : ThreadContextLines;
        return lines.Count <= count ? lines : lines[^count..];
    }

    /// <summary>The line or range a line comment is on, e.g. <c>:12</c> or <c>:10-14</c>.</summary>
    private static string LinesOf(PullRequestComment comment)
    {
        return comment switch
        {
            { StartLine: { } start, Line: { } end } when end > start => $":{start}-{end}",
            { Line: { } line } => $":{line}",
            _ => string.Empty
        };
    }

    /// <summary>The comment's frame: colored by who wrote it, indented when it answers an earlier one, and marked when it is a review's text.</summary>
    private static string CommentClass(PullRequestComment comment)
    {
        var by = $"pr-by-{comment.AuthorKind.ToString().ToLowerInvariant()}";
        if (comment.IsReply)
        {
            return $"{by} pr-comment-reply";
        }
        return comment.ReviewState is null ? by : $"{by} pr-review-entry";
    }

    private async Task SendAsync()
    {
        var agentRunStarted = false;
        State.Sending = true;
        State.NotifyChanged();
        try
        {
            var result = await WorkItemService.SendPullRequestFeedbackAsync(
                new PullRequestFeedback(RepositoryName, Item.Id, State.Body?.Trim() ?? string.Empty, State.Pending.ToList(), State.RequestChanges));
            if (result.Warning is not null)
            {
                Snackbar.Add(result.Warning, Severity.Warning);
            }
            else
            {
                Snackbar.Add(result.AgentRunStarted
                    ? $"Sent your feedback on pull request #{Changes!.Number}; the agent worker starts a revision run shortly."
                    : $"Sent your feedback to Copilot on pull request #{Changes!.Number}.", Severity.Success);
            }
            State.Body = null;
            State.RequestChanges = false;
            State.Pending.Clear();
            State.SentUrl = result.Url;
            agentRunStarted = result.AgentRunStarted;
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not send the feedback: {ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            State.Sending = false;
            State.NotifyChanged();
        }
        await LoadAsync();
        if (agentRunStarted)
        {
            await OnAgentRunStarted.InvokeAsync();
        }
    }

    private void ChangeMergeMethod(PullRequestMergeMethod method)
    {
        State.MergeMethod = method;
    }

    private async Task MergeAsync()
    {
        var number = Changes!.Number;
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Merge and close pull request #{number}",
            $"Put the changes of pull request #{number} on its base branch ({MergeMethodLabel(State.MergeMethod).ToLowerInvariant()}) and close it?",
            yesText: "Merge and close", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        State.Sending = true;
        State.NotifyChanged();
        try
        {
            await WorkItemService.MergePullRequestAsync(new PullRequestMerge(RepositoryName, Item.Id, State.MergeMethod));
            Snackbar.Add($"Merged and closed pull request #{number}.", Severity.Success);
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not merge: {ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            State.Sending = false;
            State.NotifyChanged();
        }
        await LoadAsync();
        await OnMerged.InvokeAsync();
    }

    /// <summary>
    /// A GitHub comment is Markdown written by anyone who can comment, so it goes through <see cref="ChatMarkdown"/>, which keeps
    /// only the HTML GitHub allows that is safe (see <see cref="GitHubHtml"/>), such as Copilot code review's collapsible
    /// sections, and only safe links. HTML comments are dropped first, because GitHub hides them too. Images in DGHSF's own
    /// image storage, such as the agent worker's screenshots, are shown; every other image becomes its alt text or a link.
    /// </summary>
    private MarkupString CommentHtml(PullRequestComment comment)
    {
        return (MarkupString)ChatMarkdown.ToHtml(HtmlComment.Replace(comment.Body, string.Empty), showImage: ImageUploads.IsStoredImage, allowHtml: true);
    }

    private static readonly System.Text.RegularExpressions.Regex HtmlComment =
        new("<!--.*?-->", System.Text.RegularExpressions.RegexOptions.Singleline | System.Text.RegularExpressions.RegexOptions.Compiled);

    private static (string Text, Color Color) DecisionChip(PullRequestReviewDecision decision)
    {
        return decision switch
        {
            PullRequestReviewDecision.Approved => ("Approved", Color.Success),
            PullRequestReviewDecision.ChangesRequested => ("Changes requested", Color.Warning),
            _ => ("Not approved yet", Color.Default)
        };
    }

    /// <summary>Whether GitHub would merge the pull request now, in a sentence for the merge card.</summary>
    private const string CopilotReviewingHint = "Copilot code review was asked to review this pull request and is still working on it.";

    private static bool AgentRunning(WorkItem item)
    {
        return item.Progress is CopilotProgress.Queued or CopilotProgress.Working;
    }

    private static bool CopilotReviewing(WorkItem item, PullRequestChanges changes)
    {
        return changes.Review.CopilotReviewRequested || item.Progress == CopilotProgress.CopilotReviewing;
    }

    /// <summary>Merging waits for a draft to be marked ready, a running agent to finish and a requested Copilot code review to come in.</summary>
    private static bool MergeBlocked(WorkItem item, PullRequestChanges changes)
    {
        return changes.IsDraft || AgentRunning(item) || CopilotReviewing(item, changes);
    }

    private static (Severity Severity, string Text) MergeReadiness(WorkItem item, PullRequestChanges changes)
    {
        if (changes.IsDraft)
        {
            return (Severity.Warning, "This is a draft. Mark it as ready for review on GitHub before you can merge it.");
        }
        if (AgentRunning(item))
        {
            var agent = item.Executor == AgentExecutor.DghsfWorker ? "The agent" : "Copilot";
            return (Severity.Warning, $"{agent} is still working on this pull request. Wait until it's done before you merge it.");
        }
        if (CopilotReviewing(item, changes))
        {
            return (Severity.Warning, "Copilot code review hasn't submitted its review yet. Wait for it before you merge, so you can still act on what it finds.");
        }
        return changes.Review.MergeState switch
        {
            "clean" or "has_hooks" => (Severity.Success, "Ready to merge: the required reviews and checks are in."),
            "unstable" => (Severity.Info, "It can be merged, but some checks that aren't required fail."),
            "blocked" => (Severity.Warning, "A branch rule blocks merging, e.g. a required approval or required checks. GitHub refuses the merge until that's resolved."),
            "behind" => (Severity.Warning, "The base branch moved on; the branch has to be updated on GitHub before it can be merged."),
            "dirty" => (Severity.Error, "The branch conflicts with the base branch. Resolve the conflicts before merging."),
            _ => (Severity.Info, "GitHub is still checking whether it can be merged. You can try; GitHub refuses if something blocks it.")
        };
    }

    private static string MergeMethodLabel(PullRequestMergeMethod method)
    {
        return method switch
        {
            PullRequestMergeMethod.Squash => "Squash and merge",
            PullRequestMergeMethod.Rebase => "Rebase and merge",
            _ => "Create a merge commit"
        };
    }

    private static string MergeMethodHelp(PullRequestMergeMethod method)
    {
        return method switch
        {
            PullRequestMergeMethod.Squash => "All commits become one commit on the base branch.",
            PullRequestMergeMethod.Rebase => "The commits are replayed one by one on the base branch.",
            _ => "All commits are kept and joined with a merge commit."
        };
    }

    /// <summary>GitHub's merge state as a chip; nothing while GitHub is still computing it, or for a draft (that has its own chip).</summary>
    private static (string Text, Color Color, string Hint)? MergeChip(string? mergeState)
    {
        return mergeState switch
        {
            "clean" or "has_hooks" => ("Ready to merge", Color.Success, "GitHub would merge it now: the required reviews and checks are in."),
            "blocked" => ("Merge blocked", Color.Warning, "A branch rule blocks merging, e.g. a required approval or required checks."),
            "behind" => ("Behind base", Color.Warning, "The base branch moved on; the branch has to be updated before it can be merged."),
            "dirty" => ("Merge conflicts", Color.Error, "The branch conflicts with the base branch."),
            "unstable" => ("Checks failing", Color.Warning, "It can be merged, but some checks that aren't required fail."),
            _ => null
        };
    }

    /// <summary>What a review in the conversation did, as GitHub words it above the review's text.</summary>
    private static string ReviewEntryVerdict(string state)
    {
        return state switch
        {
            "APPROVED" => "approved these changes",
            "CHANGES_REQUESTED" => "requested changes",
            "DISMISSED" => "reviewed (dismissed)",
            _ => "reviewed"
        };
    }

    private static string ReviewerVerdict(string state)
    {
        return state switch
        {
            "APPROVED" => "approved",
            "CHANGES_REQUESTED" => "requested changes",
            "DISMISSED" => "had their review dismissed",
            _ => "commented"
        };
    }

    private static string RowClass(DiffLine line)
    {
        return line.Kind switch
        {
            DiffLineKind.Added => "pr-added",
            DiffLineKind.Removed => "pr-removed",
            DiffLineKind.Hunk => "pr-hunk",
            DiffLineKind.Note => "pr-hunk",
            _ => string.Empty
        };
    }

    private static string Sign(DiffLine line)
    {
        return line.Kind switch
        {
            DiffLineKind.Added => "+",
            DiffLineKind.Removed => "-",
            DiffLineKind.Context => " ",
            _ => string.Empty
        };
    }
}
