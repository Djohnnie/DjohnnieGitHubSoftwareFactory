@inject WorkItemService WorkItemService
@inject ISnackbar Snackbar

@* One tab of a work item's pull request: the diff with line comments, or the discussion with a form to send feedback to Copilot
   (an @copilot comment or review). Both tabs share the State, which is loaded the first time one of them is shown. *@
<MudPaper Class="pa-4" Outlined="true" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h6">
            Pull request <MudLink Href="@Item.PullRequestUrl" Target="_blank">#@Item.PullRequestNumber</MudLink>
        </MudText>
        @if (Changes is not null)
        {
            <MudText Typo="Typo.body2" Class="mono">@Changes.Title</MudText>
            <MudText Typo="Typo.body2">
                <span class="pr-additions">+@Changes.Additions</span> <span class="pr-deletions">−@Changes.Deletions</span>
                in @Changes.Files.Count @(Changes.Files.Count == 1 ? "file" : "files")
            </MudText>
            @if (!Changes.IsOpen)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(Changes.IsMerged ? Color.Success : Color.Default)">@(Changes.IsMerged ? "Merged" : "Closed")</MudChip>
            }
            else
            {
                @if (Changes.IsDraft)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Draft</MudChip>
                }
                var (decision, decisionColor) = DecisionChip(Changes.Review.Decision);
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="decisionColor" Class="pr-review-decision">@decision</MudChip>
                @if (MergeChip(Changes.Review.MergeState) is { } merge)
                {
                    <MudTooltip Text="@merge.Hint">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="merge.Color" Class="pr-merge-state">@merge.Text</MudChip>
                    </MudTooltip>
                }
            }
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync" Disabled="State.Loading || State.Sending"
                   StartIcon="@Icons.Material.Filled.Refresh">@(Changes is null ? "Load" : "Reload")</MudButton>
    </MudStack>

    @if (State.Loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }
    @if (State.Error is not null)
    {
        <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Dense="true" Class="mt-2">@State.Error</MudAlert>
    }

    @if (Changes is not null && Section == PullRequestSection.Changes)
    {
        @if (Changes.FilesTruncated)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-2">
                GitHub lists only the first 3,000 files of a pull request; see the rest on GitHub.
            </MudAlert>
        }
        @if (State.Pending.Count > 0)
        {
            <MudAlert Variant="Variant.Outlined" Severity="Severity.Info" Dense="true" Class="mt-2">
                @State.Pending.Count line @(State.Pending.Count == 1 ? "comment is" : "comments are") pending. They are sent to Copilot as one review
                from the <MudLink OnClick="() => OnNavigate.InvokeAsync(PullRequestSection.Discussion)">discussion</MudLink>.
            </MudAlert>
        }

        <div class="pr-files mt-3">
            @foreach (var file in Changes.Files)
            {
                var expanded = State.Expanded.Contains(file.FileName);
                <div class="pr-file">
                    <div class="pr-file-header" @onclick="() => Toggle(file.FileName)" role="button" aria-expanded="@(expanded ? "true" : "false")">
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <span class="mono pr-file-name">
                            @if (file.PreviousFileName is { } previous)
                            {
                                <span>@previous → </span>
                            }
                            @file.FileName
                        </span>
                        <span class="pr-file-status">@file.Status</span>
                        <span class="pr-additions">+@file.Additions</span>
                        <span class="pr-deletions">−@file.Deletions</span>
                        @if (PendingFor(file.FileName) is > 0 and var pending)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@pending pending</MudChip>
                        }
                    </div>
                    @if (expanded)
                    {
                        @if (file.Patch is null)
                        {
                            <div class="pr-note">
                                No diff to show (a binary file or a diff that is too large).
                                @if (file.BlobUrl is not null)
                                {
                                    <MudLink Href="@file.BlobUrl" Target="_blank">View the file on GitHub</MudLink>
                                }
                            </div>
                        }
                        else
                        {
                            <table class="pr-diff">
                                <tbody>
                                    @foreach (var line in State.Patches[file.FileName])
                                    {
                                        <tr class="@RowClass(line)">
                                            <td class="pr-num">@line.OldLine</td>
                                            <td class="pr-num">@line.NewLine</td>
                                            <td class="pr-gutter">
                                                @if (State.CanSendFeedback && line.CanComment)
                                                {
                                                    <button type="button" class="pr-add" title="Comment on this line" aria-label="Comment on line @line.CommentLine"
                                                            @onclick="() => StartComment(file.FileName, line)">+</button>
                                                }
                                            </td>
                                            <td class="pr-code"><span class="pr-sign">@Sign(line)</span>@line.Text</td>
                                        </tr>
                                        @foreach (var existing in ExistingOn(file.FileName, line))
                                        {
                                            <tr class="pr-thread">
                                                <td colspan="4">
                                                    <div class="pr-comment">
                                                        <b>@(existing.AuthorLogin ?? "someone")</b>
                                                        <MudLink Href="@existing.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="existing.CreatedAt" /></MudLink>
                                                        <div class="pr-comment-body pr-markdown">@CommentHtml(existing)</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var comment in PendingOn(file.FileName, line))
                                        {
                                            <tr class="pr-thread">
                                                <td colspan="4">
                                                    <div class="pr-comment pr-comment-pending">
                                                        <b>Pending</b>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="State.Sending"
                                                                       OnClick="() => RemoveComment(comment)" aria-label="Remove comment" />
                                                        <div class="pr-comment-body">@comment.Body</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (IsDraftTarget(file.FileName, line))
                                        {
                                            <tr class="pr-thread">
                                                <td colspan="4">
                                                    <div class="pr-comment">
                                                        <DictationTextField @bind-Value="_draftText" Label="@($"Comment on line {line.CommentLine}")"
                                                                      Lines="3" Immediate="true" MaxLength="PullRequestFeedback.MaxBodyLength" />
                                                        <MudStack Row="true" Class="mt-1">
                                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_draftText)"
                                                                       OnClick="AddComment">Add comment</MudButton>
                                                            <MudButton Variant="Variant.Text" OnClick="CancelComment">Cancel</MudButton>
                                                        </MudStack>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            }
        </div>
    }

    @if (Changes is not null && Section == PullRequestSection.Discussion)
    {
        @if (Changes.Comments.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">No comments yet.</MudText>
        }
        @foreach (var comment in Changes.Comments)
        {
            <div class="pr-comment mt-2">
                <b>@(comment.AuthorLogin ?? "someone")</b>
                @if (comment.Path is not null)
                {
                    <span class="mono"> on @comment.Path@(comment.Line is { } line ? $":{line}" : string.Empty)</span>
                }
                · <MudLink Href="@comment.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="comment.CreatedAt" /></MudLink>
                <div class="pr-comment-body pr-markdown">@CommentHtml(comment)</div>
            </div>
        }

        <MudText Typo="Typo.subtitle1" Class="mt-4"><b>Reviews</b></MudText>
        @if (Changes.Review.Reviewers.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nobody reviewed this pull request yet.</MudText>
        }
        else
        {
            <ul class="pr-reviewers">
                @foreach (var reviewer in Changes.Review.Reviewers)
                {
                    <li>
                        <b>@reviewer.Login</b> @ReviewerVerdict(reviewer.State)
                        @if (reviewer.SubmittedAt is { } submitted)
                        {
                            <span> · </span>
                            @if (reviewer.Url is not null)
                            {
                                <MudLink Href="@reviewer.Url" Target="_blank" Typo="Typo.caption"><TimeAgo At="submitted" /></MudLink>
                            }
                            else
                            {
                                <TimeAgo At="submitted" />
                            }
                        }
                    </li>
                }
            </ul>
        }

        @if (State.CanSendFeedback)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4"><b>Feedback for Copilot</b></MudText>
            @if (State.SentUrl is not null)
            {
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="CloseSent">
                    Feedback sent. <MudLink Href="@State.SentUrl" Target="_blank">View it on GitHub</MudLink>; refresh the work item to follow Copilot's progress.
                </MudAlert>
            }
            <DictationTextField Value="@State.Body" ValueChanged="ChangeBody" Label="What should Copilot change?" Lines="4"
                          Immediate="true" MaxLength="PullRequestFeedback.MaxBodyLength" Disabled="State.Sending" />
            <MudCheckBox T="bool" Value="State.RequestChanges" ValueChanged="ChangeRequestChanges" Label="Mark the pull request as &quot;Changes requested&quot; (can block merging until you approve)"
                         Disabled="State.Sending" Dense="true" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                Posted as you on pull request #@Changes.Number, starting with @WorkItemPullRequests.CopilotMention.
                @FeedbackKind()
                Copilot uses the model that created the pull request.
            </MudText>
            @if (State.Pending.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    The line comments are the ones you wrote on the <MudLink Typo="Typo.caption" OnClick="() => OnNavigate.InvokeAsync(PullRequestSection.Changes)">changes</MudLink>.
                </MudText>
            }
            <MudStack Row="true" Class="mt-2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="SendAsync"
                           Disabled="@(State.Sending || (string.IsNullOrWhiteSpace(State.Body) && State.Pending.Count == 0))">Send to Copilot</MudButton>
                @if (State.Pending.Count > 0)
                {
                    <MudButton Variant="Variant.Text" OnClick="ClearComments" Disabled="State.Sending">Discard line comments</MudButton>
                }
                @if (State.Sending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
            </MudStack>

            <MudText Typo="Typo.subtitle1" Class="mt-6"><b>Approve</b></MudText>
            @if (State.ApprovedUrl is not null)
            {
                <MudAlert Variant="Variant.Outlined" Severity="Severity.Success" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="CloseApproved">
                    Approved. <MudLink Href="@State.ApprovedUrl" Target="_blank">View the review on GitHub</MudLink>.
                </MudAlert>
            }
            <DictationTextField Value="@State.ApprovalBody" ValueChanged="ChangeApprovalBody" Label="Comment (optional)" Lines="2"
                          Immediate="true" MaxLength="PullRequestApproval.MaxBodyLength" Disabled="State.Sending" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                Submitted as you as a review that approves pull request #@Changes.Number. It doesn't mention @WorkItemPullRequests.CopilotMention, so Copilot doesn't start working on it.
                Merging stays on GitHub.
            </MudText>
            <MudStack Row="true" Class="mt-2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveAsync"
                           Disabled="State.Sending" Class="pr-approve">Approve</MudButton>
            </MudStack>
        }
        else if (!Changes.IsOpen)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">
                The pull request is @(Changes.IsMerged ? "merged" : "closed"), so Copilot no longer works on it.
            </MudText>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string RepositoryName { get; set; } = string.Empty;

    /// <summary>A work item with a pull request (<see cref="WorkItem.PullRequestNumber"/> set).</summary>
    [Parameter, EditorRequired] public WorkItem Item { get; set; } = null!;

    /// <summary>The pull request as loaded, shared with the other tab.</summary>
    [Parameter, EditorRequired] public WorkItemPullRequestState State { get; set; } = null!;

    [Parameter] public PullRequestSection Section { get; set; }

    /// <summary>Whether this tab is shown: the pull request is loaded the first time it is.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Asks to show the other tab, e.g. to send the pending line comments from the discussion.</summary>
    [Parameter] public EventCallback<PullRequestSection> OnNavigate { get; set; }

    /// <summary>Raised after the pull request was approved, so the work item can refresh its progress.</summary>
    [Parameter] public EventCallback OnApproved { get; set; }

    private (string Path, DiffSide Side, int Line)? _draftTarget;
    private string? _draftText;
    private int? _draftNumber;

    private PullRequestChanges? Changes
    {
        get
        {
            return State.Changes;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        State.Follow(Item.PullRequestNumber);
        if (_draftNumber != State.Number)
        {
            _draftNumber = State.Number;
            CancelComment();
        }
        if (Active && State.NeedsLoading)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        await State.LoadAsync(RepositoryName, Item.Id);
    }

    private void Toggle(string fileName)
    {
        if (!State.Expanded.Remove(fileName))
        {
            State.Expanded.Add(fileName);
        }
    }

    private void StartComment(string path, DiffLine line)
    {
        _draftTarget = (path, line.Side, line.CommentLine!.Value);
        _draftText = PendingOn(path, line).FirstOrDefault()?.Body;
    }

    private bool IsDraftTarget(string path, DiffLine line)
    {
        return line.CanComment && _draftTarget == (path, line.Side, line.CommentLine!.Value);
    }

    private void AddComment()
    {
        if (_draftTarget is not { } target || string.IsNullOrWhiteSpace(_draftText))
        {
            return;
        }
        // One pending comment per line: commenting again replaces it.
        State.Pending.RemoveAll(c => c.Path == target.Path && c.Side == target.Side && c.Line == target.Line);
        State.Pending.Add(new(target.Path, target.Line, target.Side, _draftText.Trim()));
        CancelComment();
        State.NotifyChanged();
    }

    private void CancelComment()
    {
        _draftTarget = null;
        _draftText = null;
    }

    private void RemoveComment(PullRequestLineComment comment)
    {
        State.Pending.Remove(comment);
        State.NotifyChanged();
    }

    private void ClearComments()
    {
        State.Pending.Clear();
        CancelComment();
        State.NotifyChanged();
    }

    private void ChangeBody(string? body)
    {
        State.Body = body;
    }

    private void ChangeRequestChanges(bool requestChanges)
    {
        State.RequestChanges = requestChanges;
    }

    /// <summary>What the feedback becomes on GitHub, as the caption under the feedback box says it.</summary>
    private string FeedbackKind()
    {
        var count = State.Pending.Count;
        var lineComments = $"{count} line {(count == 1 ? "comment" : "comments")}";
        if (State.RequestChanges)
        {
            return $"It becomes a \"Request changes\" review with {lineComments}. GitHub shows the pull request as \"Changes requested\" "
                + "and, if the repository requires approving reviews, blocks merging until you approve it or dismiss the review. "
                + "Copilot acts on the feedback either way.";
        }

        return count == 0
            ? "It becomes a comment in the conversation."
            : $"It becomes one review with {lineComments}.";
    }

    private void CloseSent()
    {
        State.SentUrl = null;
    }

    private IEnumerable<PullRequestLineComment> PendingOn(string path, DiffLine line)
    {
        if (!line.CanComment)
        {
            return [];
        }
        return State.Pending.Where(c => c.Path == path && c.Side == line.Side && c.Line == line.CommentLine);
    }

    private int PendingFor(string path)
    {
        return State.Pending.Count(c => c.Path == path);
    }

    /// <summary>GitHub's line comments that are on this line of the new file (where comments usually are).</summary>
    private IEnumerable<PullRequestComment> ExistingOn(string path, DiffLine line)
    {
        if (Changes is null || line.Kind is not (DiffLineKind.Added or DiffLineKind.Context))
        {
            return [];
        }
        return Changes.Comments.Where(c => c.Path == path && c.Line == line.NewLine);
    }

    private async Task SendAsync()
    {
        State.Sending = true;
        State.NotifyChanged();
        try
        {
            var result = await WorkItemService.SendPullRequestFeedbackAsync(
                new PullRequestFeedback(RepositoryName, Item.Id, State.Body?.Trim() ?? string.Empty, State.Pending.ToList(), State.RequestChanges));
            Snackbar.Add($"Sent your feedback to Copilot on pull request #{Changes!.Number}.", Severity.Success);
            State.Body = null;
            State.RequestChanges = false;
            State.Pending.Clear();
            State.SentUrl = result.Url;
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not send the feedback: {ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            State.Sending = false;
            State.NotifyChanged();
        }
        await LoadAsync();
    }

    private void ChangeApprovalBody(string? body)
    {
        State.ApprovalBody = body;
    }

    private void CloseApproved()
    {
        State.ApprovedUrl = null;
    }

    private async Task ApproveAsync()
    {
        State.Sending = true;
        State.NotifyChanged();
        try
        {
            var result = await WorkItemService.ApprovePullRequestAsync(new PullRequestApproval(RepositoryName, Item.Id, State.ApprovalBody?.Trim()));
            Snackbar.Add($"Approved pull request #{Changes!.Number}.", Severity.Success);
            State.ApprovalBody = null;
            State.ApprovedUrl = result.Url;
        }
        catch (Exception ex) when (WorkItemActions.IsExpected(ex))
        {
            Snackbar.Add($"Could not approve: {ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            State.Sending = false;
            State.NotifyChanged();
        }
        await LoadAsync();
        await OnApproved.InvokeAsync();
    }

    /// <summary>
    /// A GitHub comment is Markdown written by anyone who can comment, so it goes through <see cref="ChatMarkdown"/>, which escapes
    /// raw HTML and keeps only safe links. HTML comments are dropped first, because GitHub hides them too.
    /// </summary>
    private static MarkupString CommentHtml(PullRequestComment comment)
    {
        return (MarkupString)ChatMarkdown.ToHtml(HtmlComment.Replace(comment.Body, string.Empty));
    }

    private static readonly System.Text.RegularExpressions.Regex HtmlComment =
        new("<!--.*?-->", System.Text.RegularExpressions.RegexOptions.Singleline | System.Text.RegularExpressions.RegexOptions.Compiled);

    private static (string Text, Color Color) DecisionChip(PullRequestReviewDecision decision)
    {
        return decision switch
        {
            PullRequestReviewDecision.Approved => ("Approved", Color.Success),
            PullRequestReviewDecision.ChangesRequested => ("Changes requested", Color.Warning),
            _ => ("Not approved yet", Color.Default)
        };
    }

    /// <summary>GitHub's merge state as a chip; nothing while GitHub is still computing it, or for a draft (that has its own chip).</summary>
    private static (string Text, Color Color, string Hint)? MergeChip(string? mergeState)
    {
        return mergeState switch
        {
            "clean" or "has_hooks" => ("Ready to merge", Color.Success, "GitHub would merge it now: the required reviews and checks are in."),
            "blocked" => ("Merge blocked", Color.Warning, "A branch rule blocks merging, e.g. a required approval or required checks."),
            "behind" => ("Behind base", Color.Warning, "The base branch moved on; the branch has to be updated before it can be merged."),
            "dirty" => ("Merge conflicts", Color.Error, "The branch conflicts with the base branch."),
            "unstable" => ("Checks failing", Color.Warning, "It can be merged, but some checks that aren't required fail."),
            _ => null
        };
    }

    private static string ReviewerVerdict(string state)
    {
        return state switch
        {
            "APPROVED" => "approved",
            "CHANGES_REQUESTED" => "requested changes",
            "DISMISSED" => "had their review dismissed",
            _ => "commented"
        };
    }

    private static string RowClass(DiffLine line)
    {
        return line.Kind switch
        {
            DiffLineKind.Added => "pr-added",
            DiffLineKind.Removed => "pr-removed",
            DiffLineKind.Hunk => "pr-hunk",
            DiffLineKind.Note => "pr-hunk",
            _ => string.Empty
        };
    }

    private static string Sign(DiffLine line)
    {
        return line.Kind switch
        {
            DiffLineKind.Added => "+",
            DiffLineKind.Removed => "-",
            DiffLineKind.Context => " ",
            _ => string.Empty
        };
    }
}
