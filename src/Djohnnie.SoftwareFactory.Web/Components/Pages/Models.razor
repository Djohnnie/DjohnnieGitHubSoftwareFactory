@page "/models"
@inject AiModelService ModelService
@inject AiModelService Scraper
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>GitHub Copilot Models</PageTitle>

<PageBreadcrumbs Current="GitHub Copilot Models" />

<MudStack Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">GitHub Copilot Models</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            AI models available to custom agents, with their price in AI credits per 1M tokens (1 AI credit = $0.01) and what
            DGHSF agent worker sessions spent on them so far. Shared by all repositories.
        </MudText>
    </div>
    <MudStack Row="true" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudDownload"
                   OnClick="() => _importOpen = !_importOpen">Import from GitHub docs</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/models/new">New model</MudButton>
        <MudSpacer />
        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading" title="Reload" />
    </MudStack>
</MudStack>

@if (_error is not null)
{
    <MudAlert Variant="Variant.Outlined" Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_importOpen)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true" Elevation="0">
        <MudText Typo="Typo.h6">Import from GitHub docs</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            Paste the link to the Copilot "Models and pricing" page. New models are added; pricing of existing models
            (matched on name and tier) is refreshed. Model ids and enabled state you changed are kept. GitHub lists prices
            in US dollars; they are converted to AI credits (1 AI credit = $0.01). Models that are no
            longer on the page are listed separately so you can remove them.
        </MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_importUrl" Label="Documentation URL" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ScrapeAsync" Disabled="_scraping"
                       StartIcon="@Icons.Material.Filled.TravelExplore">
                @if (_scraping)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Fetch
            </MudButton>
        </MudStack>

        @if (_scraped is not null)
        {
            <MudTable Outlined="true" Striped="true" T="AiModel" Items="_scraped" MultiSelection="true" @bind-SelectedItems="_selected" Dense="true" Hover="true"
                      Elevation="0" Class="mt-4" Height="400px" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Model</MudTh>
                    <MudTh>Provider</MudTh>
                    <MudTh>Tier</MudTh>
                    <MudTh Style="text-align:right">Input</MudTh>
                    <MudTh Style="text-align:right">Output</MudTh>
                    <MudTh>Change</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mono">@context.ModelId</MudText></MudTd>
                    <MudTd>@context.Provider</MudTd>
                    <MudTd>@TierLabel(context)</MudTd>
                    <MudTd Style="text-align:right">@AiModel.FormatCredits(context.InputPrice)</MudTd>
                    <MudTd Style="text-align:right">@AiModel.FormatCredits(context.OutputPrice)</MudTd>
                    <MudTd>
                        @switch (ChangeOf(context))
                        {
                            case "New":
                                <MudChip Variant="Variant.Outlined" T="string" Size="Size.Small" Color="Color.Success">New</MudChip>
                                break;
                            case "Updated":
                                <MudChip Variant="Variant.Outlined" T="string" Size="Size.Small" Color="Color.Warning">Price change</MudChip>
                                break;
                            default:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Unchanged</MudChip>
                                break;
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_selected.Count of @_scraped.Count selected</MudText>
                <MudButton Variant="Variant.Outlined" OnClick="Discard">Discard</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ImportAsync" Disabled="_selected.Count == 0 || _importing"
                           StartIcon="@Icons.Material.Filled.Download">Import selected</MudButton>
            </MudStack>
        }

        @if (_missing is { Count: > 0 })
        {
            <MudText Typo="Typo.subtitle1" Class="mt-6"><b>Not found on the page</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                These models are in DGHSF but not on the page, matched on name and tier. They may have been retired, renamed
                or added manually. Select the ones to remove.
            </MudText>
            <MudTable Outlined="true" Striped="true" T="AiModel" Items="_missing" MultiSelection="true" @bind-SelectedItems="_toRemove" Dense="true" Hover="true"
                      Elevation="0" Class="mt-2 missing-models" Height="300px" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Model</MudTh>
                    <MudTh>Provider</MudTh>
                    <MudTh>Tier</MudTh>
                    <MudTh Style="text-align:right">Input</MudTh>
                    <MudTh Style="text-align:right">Output</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mono">@context.ModelId</MudText></MudTd>
                    <MudTd>@context.Provider</MudTd>
                    <MudTd>@TierLabel(context)</MudTd>
                    <MudTd Style="text-align:right">@AiModel.FormatCredits(context.InputPrice)</MudTd>
                    <MudTd Style="text-align:right">@AiModel.FormatCredits(context.OutputPrice)</MudTd>
                    <MudTd>
                        @if (string.IsNullOrEmpty(context.SourceUrl))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Added manually</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">Not found</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_toRemove.Count of @_missing.Count selected</MudText>
                @if (_scraped is null)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="Discard">Dismiss</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveMissingAsync" Disabled="_toRemove.Count == 0 || _removing"
                           StartIcon="@Icons.Material.Filled.Delete">Remove selected</MudButton>
            </MudStack>
        }
    </MudPaper>
}

<MudTable Outlined="true" Striped="true" T="AiModel" Items="_models" Filter="Matches" Loading="_loading" LoadingProgressColor="Color.Primary" Hover="true" Elevation="0"
          GroupBy="_groupByProvider" GroupHeaderStyle="background-color: var(--mud-palette-background-gray)">
    <ToolBarContent>
        <MudTextField Variant="Variant.Text" Underline="false" @bind-Value="_search" Placeholder="Search models" Adornment="Adornment.Start" Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Clearable="true" />
        <MudSpacer />
        <MudSwitch @bind-Value="_onlyFavorites" Color="Color.Primary" Label="Favorites only" />
        <MudSwitch @bind-Value="_onlyEnabled" Color="Color.Primary" Label="Enabled only" />
    </ToolBarContent>
    <GroupHeaderTemplate>
        <MudTh colspan="10"><b>@(context.Key as string ?? "Other")</b></MudTh>
    </GroupHeaderTemplate>
    <HeaderContent>
        <MudTh Style="width:1%"><span class="visually-hidden">Favorite</span></MudTh>
        <MudTh>Model</MudTh>
        <MudTh>Category</MudTh>
        <MudTh>Tier</MudTh>
        <MudTh Style="text-align:right">Input</MudTh>
        <MudTh Style="text-align:right">Cached input</MudTh>
        <MudTh Style="text-align:right">Cache write</MudTh>
        <MudTh Style="text-align:right">Output</MudTh>
        <MudTh Style="text-align:right">AI credits used</MudTh>
        <MudTh Style="text-align:right">Enabled / actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Favorite">
            <FavoriteToggle Value="context.IsFavorite" ValueChanged="v => SetFavoriteAsync(context, v)" Name="@context.Name" Size="Size.Small" />
        </MudTd>
        <MudTd DataLabel="Model">
            <MudLink Href="@($"/models/{context.Id}")" Typo="Typo.body1"><b>@context.Name</b></MudLink>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mono">@context.ModelId</MudText>
            @if (!string.IsNullOrEmpty(context.ReleaseStatus) && context.ReleaseStatus != "GA")
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@context.ReleaseStatus</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Category">@context.Category</MudTd>
        <MudTd DataLabel="Tier">@TierLabel(context)</MudTd>
        <MudTd DataLabel="Input" Style="text-align:right">@AiModel.FormatCredits(context.InputPrice)</MudTd>
        <MudTd DataLabel="Cached input" Style="text-align:right">@AiModel.FormatCredits(context.CachedInputPrice)</MudTd>
        <MudTd DataLabel="Cache write" Style="text-align:right">@AiModel.FormatCredits(context.CacheWritePrice)</MudTd>
        <MudTd DataLabel="Output" Style="text-align:right">@AiModel.FormatCredits(context.OutputPrice)</MudTd>
        <MudTd DataLabel="AI credits used" Style="text-align:right; white-space:nowrap" Class="model-usage">
            @if (context.Usage.Sessions > 0)
            {
                <MudText Typo="Typo.body2">@AiModel.FormatCredits(context.Usage.AiCredits)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Usage.Sessions.ToString("N0") @(context.Usage.Sessions == 1 ? "session" : "sessions")</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">–</MudText>
            }
        </MudTd>
        <MudTd Style="text-align:right; white-space:nowrap">
            <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                <MudSwitch T="bool" Value="context.IsEnabled" ValueChanged="v => SetEnabledAsync(context, v)" Color="Color.Primary" />
                <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Edit" Href="@($"/models/{context.Id}")" title="Edit" aria-label="@($"Edit {context.Name}")" />
                <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteAsync(context)" title="Delete" />
            </MudStack>
        </MudTd>
    </RowTemplate>
    <FooterContent>
        <MudTd colspan="8" Style="text-align:right"><b>Total of the models shown</b></MudTd>
        <MudTd Style="text-align:right; white-space:nowrap" Class="models-usage-total"><b>@AiModel.FormatCredits(_models.Where(Matches).Sum(m => m.Usage.AiCredits))</b></MudTd>
        <MudTd />
    </FooterContent>
    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
            <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Large" Color="Color.Secondary" />
            <MudText>No models yet. Import them from the GitHub docs or add one manually.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _importOpen = true">Import from GitHub docs</MudButton>
        </MudStack>
    </NoRecordsContent>
</MudTable>

@code {
    private readonly TableGroupDefinition<AiModel> _groupByProvider = new() { Selector = m => m.Provider ?? "Other" };

    private List<AiModel> _models = [];
    private bool _loading = true;
    private string? _error;
    private string? _search;
    private bool _onlyEnabled;
    private bool _onlyFavorites;

    private bool _importOpen;
    private string _importUrl = ModelPricingScraper.DefaultUrl;
    private bool _scraping;
    private bool _importing;
    private List<AiModel>? _scraped;
    private HashSet<AiModel> _selected = [];
    private bool _removing;
    private List<AiModel>? _missing;
    private HashSet<AiModel> _toRemove = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _importOpen = _models.Count == 0;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _models = await ModelService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load models: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private bool Matches(AiModel model)
    {
        return (!_onlyEnabled || model.IsEnabled) &&
        (!_onlyFavorites || model.IsFavorite) &&
        (string.IsNullOrWhiteSpace(_search)
         || model.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
         || model.ModelId.Contains(_search, StringComparison.OrdinalIgnoreCase)
         || (model.Provider?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private async Task SetEnabledAsync(AiModel model, bool enabled)
    {
        try
        {
            await ModelService.SetEnabledAsync(model.Id, enabled);
            model.IsEnabled = enabled;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not update '{model.Name}': {ex.Message}", Severity.Error);
        }
    }

    private async Task SetFavoriteAsync(AiModel model, bool isFavorite)
    {
        try
        {
            await ModelService.SetFavoriteAsync(model.Id, isFavorite);
            model.IsFavorite = isFavorite;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not update '{model.Name}': {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(AiModel model)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Delete model", $"Delete '{model.Name}' ({TierLabel(model)})? Existing agent files are not changed.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ModelService.DeleteAsync(model.Id);
            _models.Remove(model);
            Snackbar.Add($"Deleted '{model.Name}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete '{model.Name}': {ex.Message}", Severity.Error);
        }
    }

    private async Task ScrapeAsync()
    {
        _scraping = true;
        Discard();
        try
        {
            var scraped = await Scraper.ScrapeAsync(_importUrl);
            _scraped = scraped.ToList();
            _selected = _scraped.Where(m => ChangeOf(m) != "Unchanged").ToHashSet();
            _missing = _models
                .Where(m => !_scraped.Any(s => IsSameModel(m, s)))
                .OrderBy(m => m.Provider ?? "Other")
                .ThenBy(m => m.Name)
                .ToList();
            Snackbar.Add(_missing.Count == 0
                ? $"Found {_scraped.Count} models."
                : $"Found {_scraped.Count} models; {_missing.Count} existing models are not on the page.", Severity.Info);
        }
        catch (Exception ex) when (ex is ArgumentException or Djohnnie.SoftwareFactory.Contracts.DomainRuleException or Djohnnie.SoftwareFactory.Contracts.ValidationFailedException or HttpRequestException or TaskCanceledException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _scraping = false;
        }
    }

    private async Task ImportAsync()
    {
        _importing = true;
        try
        {
            var result = await ModelService.ImportAsync(_selected);
            Snackbar.Add($"Imported: {result.Added} added, {result.Updated} updated, {result.Unchanged} unchanged.", Severity.Success);
            _scraped = null;
            _selected = [];
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private void Discard()
    {
        _scraped = null;
        _selected = [];
        _missing = null;
        _toRemove = [];
    }

    private async Task RemoveMissingAsync()
    {
        var models = _toRemove.ToList();
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Remove models",
            models.Count == 1
                ? $"Remove '{models[0].Name}' ({TierLabel(models[0])})? Existing agent files are not changed."
                : $"Remove {models.Count} models that are not on the page? Existing agent files are not changed.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _removing = true;
        var removed = 0;
        var failed = new List<string>();
        try
        {
            foreach (var model in models)
            {
                try
                {
                    await ModelService.DeleteAsync(model.Id);
                    _missing?.Remove(model);
                    _toRemove.Remove(model);
                    _models.RemoveAll(m => m.Id == model.Id);
                    removed++;
                }
                catch (Exception ex)
                {
                    failed.Add($"'{model.Name}': {ex.Message}");
                }
            }
        }
        finally
        {
            _removing = false;
        }

        if (removed > 0)
        {
            Snackbar.Add(removed == 1 ? "Removed 1 model." : $"Removed {removed} models.", Severity.Success);
        }
        if (failed.Count > 0)
        {
            Snackbar.Add($"Could not remove {string.Join("; ", failed)}", Severity.Error);
        }
    }

    private static bool IsSameModel(AiModel a, AiModel b)
    {
        return string.Equals(a.Name, b.Name, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(a.Tier, b.Tier, StringComparison.OrdinalIgnoreCase);
    }

    private string ChangeOf(AiModel scraped)
    {
        var existing = _models.FirstOrDefault(m => IsSameModel(m, scraped));
        if (existing is null)
        {
            return "New";
        }
        return existing.InputPrice != scraped.InputPrice || existing.CachedInputPrice != scraped.CachedInputPrice
               || existing.CacheWritePrice != scraped.CacheWritePrice || existing.OutputPrice != scraped.OutputPrice
            ? "Updated"
            : "Unchanged";
    }

    private static string TierLabel(AiModel model)
    {
        return string.IsNullOrEmpty(model.Threshold) ? model.Tier : $"{model.Tier} ({model.Threshold})";
    }
}
